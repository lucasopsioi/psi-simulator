<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'none'">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>FSD PSI 推演 · Salesboard</title>
<style>
:root{
  --bg:#f4f5f7; --card:#ffffff; --ink:#1c1e21; --sub:#6b7280; --line:#e5e7eb;
  --accent:#c62828; --accent-soft:#fdecea;
  --hist:#f8f9fb; --ov:#fff3d6; --ov-ink:#8a5a00; --fill:#eef4ff; --fill-ink:#2b5bb7;
  --ycur:#f1f8f3; --ycur-hd:#d5ecdb; --yhist-hd:#e4e7ec; --yext-hd:#d6e2fb;
  --warn:#d92f2f; --warn-soft:#fde8e8; --amber:#b45309; --amber-soft:#fef3c7;
  --ok:#0e7a3d; --ok-soft:#e5f5ec; --chip:#eef0f3;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){ --bg:#141619; --card:#1e2126; --ink:#e8eaed; --sub:#9aa2ad; --line:#33383f;
    --accent:#ff4d55; --accent-soft:#3a1518; --hist:#23262b; --ov:#3d3010; --ov-ink:#f2c14e;
    --fill:#1b2940; --fill-ink:#8ab0f5; --warn:#ff6b6b; --warn-soft:#3a1a1a;
    --ycur:#1c2a22; --ycur-hd:#264d34; --yhist-hd:#2e3238; --yext-hd:#243a63;
    --amber:#f0b35c; --amber-soft:#3a2c10; --ok:#4cc47e; --ok-soft:#12301e; --chip:#2a2e34; }
}
:root[data-theme="dark"]{ --bg:#141619; --card:#1e2126; --ink:#e8eaed; --sub:#9aa2ad; --line:#33383f;
  --accent:#ff4d55; --accent-soft:#3a1518; --hist:#23262b; --ov:#3d3010; --ov-ink:#f2c14e;
  --fill:#1b2940; --fill-ink:#8ab0f5; --warn:#ff6b6b; --warn-soft:#3a1a1a;
  --ycur:#1c2a22; --ycur-hd:#264d34; --yhist-hd:#2e3238; --yext-hd:#243a63;
  --amber:#f0b35c; --amber-soft:#3a2c10; --ok:#4cc47e; --ok-soft:#12301e; --chip:#2a2e34; }
.pv2Ext{background:var(--fill);color:var(--fill-ink)}
td[data-carry]{text-decoration:underline dotted;text-underline-offset:3px}
td[data-capped]{box-shadow:inset 0 0 0 99px var(--warn-soft);color:var(--warn);font-weight:600}
.pv2mx{cursor:pointer;opacity:.5;font-weight:700;padding:0 3px;user-select:none;display:inline-block}
.pv2mx:hover{opacity:1}
#pvXp{position:fixed;z-index:98;display:none;background:var(--card);border:1px solid var(--line);border-radius:10px;
  padding:10px 14px;box-shadow:0 8px 30px rgba(0,0,0,.25);font-size:12.5px;line-height:1.5;overflow:auto;max-height:70vh}
#pvXp table td{border:1px solid var(--line);padding:3px 8px}
/* 推演编辑矩阵:冻结表头与左两列 */
#view-pv thead th{position:sticky;top:0;z-index:6;background:var(--card)}
.pv2Chip{display:inline-flex;gap:5px;align-items:center;padding:3px 9px;margin:0 3px;border:1px solid var(--line);border-radius:14px;background:var(--card);cursor:grab;font-size:12px;user-select:none}
.pv2Chip.drag{opacity:.4} .pv2Chip.over{border-color:var(--accent);box-shadow:0 0 0 2px var(--accent-soft)}
.pv2Chip .x{cursor:pointer;color:var(--sub);font-weight:700;padding-left:2px} .pv2Chip .x:hover{color:var(--accent)}
/* 年份分带(2026-09-15 用户:26 年和 27 年的数字分不清):年份头一格合并居中、按年上底色;月头与格子同色系 */
#view-pv thead th.pvYear{text-align:center;font-weight:700;font-size:13px;letter-spacing:.04em;border-left:2px solid var(--card);border-right:2px solid var(--card)}
#view-pv thead th.pvYear[data-pvy="a"]{background:var(--yhist-hd)} #view-pv thead th.pvYear[data-pvy="b"]{background:var(--ycur-hd)} #view-pv thead th.pvYear[data-pvy="c"]{background:var(--yext-hd);color:var(--fill-ink)}
#view-pv thead tr:nth-child(2) th[data-pvy="b"]{background:var(--ycur)} #view-pv td[data-pvy="b"]:not(.ed):not(.ov){background:var(--ycur)}
#view-pv thead tr:nth-child(2) th[data-pvyfirst],#view-pv td[data-pvyfirst]{border-left:2px solid var(--line)}
#view-pv thead tr:first-child th:nth-child(1){position:sticky;left:0;z-index:9}
#view-pv thead tr:first-child th:nth-child(2){position:sticky;z-index:9}
#view-pv tbody td[data-ci="0"]{position:sticky;left:0;z-index:4;background:var(--card)}
#view-pv tbody td[data-ci="1"]{position:sticky;z-index:4;background:var(--card)}
main th{position:relative}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.55 system-ui,"Segoe UI","Microsoft YaHei",sans-serif}
header{position:sticky;top:0;z-index:30;background:var(--card);border-bottom:1px solid var(--line);padding:0 16px}
.hrow{display:flex;align-items:center;gap:14px;flex-wrap:wrap;padding:10px 0 0}
h1{font-size:17px;margin:0;font-weight:700}
h1 .sub{color:var(--sub);font-weight:400;font-size:12px;margin-left:8px}
#dataline{color:var(--sub);font-size:12px;margin-left:auto}
nav{display:flex;gap:2px;margin-top:8px;flex-wrap:wrap}
nav button{border:0;background:none;color:var(--sub);padding:8px 12px;font-size:14px;cursor:pointer;border-bottom:2px solid transparent;white-space:nowrap;flex-shrink:0}
nav button.on{color:var(--accent);border-bottom-color:var(--accent);font-weight:600}
nav#tabs.legacyNav{display:none}   /* 旧的一排页签(2026-09-10 阶段4.5):整体隐藏,body.legacyTabs 时可见供对照 */
body.legacyTabs nav#tabs.legacyNav{display:flex;opacity:.55}
nav#viewNav button[data-view]{font-size:15px;padding:8px 14px}
nav#subNav{margin-top:0;gap:0;border-bottom:1px solid var(--line);padding-bottom:2px}
nav#subNav:empty{display:none}
nav#subNav button{font-size:13px;padding:5px 10px}
nav#subNav button.on{font-weight:600}
nav button.legacy{display:none}   /* 已并入新页的旧页签(2026-09-04 看板收敛 阶段4):保留一个版本周期供并排对照,body.legacyTabs 时可见 */
body.legacyTabs nav button.legacy{display:inline-block;opacity:.55}
nav .badge{background:var(--warn);color:#fff;border-radius:9px;font-size:11px;padding:0 6px;margin-left:4px}
.chip.lockc{background:var(--fill);color:var(--fill-ink)}
.chip.gapc{background:var(--warn-soft);color:var(--warn)}
.chip.manc{background:var(--ov);color:var(--ov-ink)}
.mkIn{width:76px;background:var(--bg);color:var(--ink);border:1px solid var(--line);border-radius:6px;padding:3px 6px;font-size:12px}
.mkCtry{border:1px solid var(--line);border-radius:8px;padding:8px 10px;margin-top:8px}
.mkBar{display:inline-block;height:8px;background:var(--accent);border-radius:3px;vertical-align:middle;opacity:.75}
main td.xsel{box-shadow:inset 0 0 0 99px rgba(199,0,11,.12);outline:1px solid var(--accent)}
#xgBar{position:fixed;right:16px;bottom:14px;z-index:96;display:flex;gap:8px;align-items:center;
  background:var(--card);border:1px solid var(--line);border-radius:10px;padding:8px 12px;
  box-shadow:0 6px 24px rgba(0,0,0,.18);font-size:13px}
#xgBar b{color:var(--accent)}
#xgBar input{width:110px;background:var(--bg);color:var(--ink);border:1px solid var(--line);border-radius:6px;padding:4px 8px;font-size:12px}
#xgBar button{background:var(--bg);color:var(--ink);border:1px solid var(--line);border-radius:6px;padding:4px 10px;font-size:12px;cursor:pointer}
#xgBar button:hover{border-color:var(--accent);color:var(--accent)}
#xgBar .xgsep{width:1px;height:18px;background:var(--line)}
#xgFlash{position:fixed;right:16px;bottom:64px;z-index:97;background:var(--card);border:1px solid var(--accent);
  color:var(--ink);border-radius:8px;padding:6px 12px;font-size:12px;opacity:0;pointer-events:none;transition:opacity .18s}
#xgFlash.on{opacity:1}
#aiDock{position:fixed;top:0;right:0;bottom:0;width:460px;max-width:92vw;z-index:95;display:flex;flex-direction:column;
  background:var(--card);border-left:1px solid var(--line);box-shadow:-8px 0 30px rgba(0,0,0,.15)}
#aiHead{display:flex;gap:8px;align-items:center;padding:10px 14px;border-bottom:1px solid var(--line)}
#aiMsgs{flex:1;overflow-y:auto;padding:12px 14px;display:flex;flex-direction:column;gap:10px}
#aiFoot{display:flex;gap:8px;padding:10px 14px;border-top:1px solid var(--line)}
#aiIn{flex:1;background:var(--bg);color:var(--ink);border:1px solid var(--line);border-radius:8px;padding:6px 10px;font-size:13px;resize:none;font-family:inherit}
.aiMsg{max-width:100%;border-radius:10px;padding:8px 12px;font-size:13px;line-height:1.55;word-break:break-word}
.aiMsg.aiU{background:var(--fill);color:var(--fill-ink);align-self:flex-end;max-width:88%}
.aiMsg.aiA{background:var(--hist);border:1px solid var(--line)}
.aiMsg table{border-collapse:collapse;font-size:12px}
.aiMsg table td{border:1px solid var(--line);padding:3px 8px}
.aiMsg code{background:var(--bg);border-radius:4px;padding:0 4px}
nav button.aiNav{color:var(--accent);font-weight:600}
main{padding:14px 16px 60px;max-width:100%}
section{display:none}
section.on{display:block}
.cards{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:12px}
.kpi{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:10px 16px;min-width:130px}
.kpi .v{font-size:20px;font-weight:700}
.kpi .t{font-size:12px;color:var(--sub)}
.kpi.warn .v{color:var(--warn)}
.panel{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:12px 14px;margin-bottom:12px}
.panel h3{margin:0 0 8px;font-size:14px}
.filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px;align-items:center}
select,input[type=text],input[type=number],textarea{background:var(--card);color:var(--ink);border:1px solid var(--line);border-radius:6px;padding:5px 8px;font:inherit}
input[type=number]{width:80px}
button.act{background:var(--accent);color:#fff;border:0;border-radius:6px;padding:6px 14px;font:inherit;cursor:pointer}
button.act:hover{filter:brightness(1.08)}
button.ghost{background:var(--chip);color:var(--ink);border:1px solid var(--line);border-radius:6px;padding:5px 12px;font:inherit;cursor:pointer}
.tblwrap{overflow:auto;border:1px solid var(--line);border-radius:8px;background:var(--card);max-height:72vh}
table{border-collapse:separate;border-spacing:0;font-size:13px;min-width:100%}
th,td{padding:5px 8px;border-bottom:1px solid var(--line);white-space:nowrap;text-align:right}
th{position:sticky;top:0;background:var(--card);z-index:5;font-weight:600;color:var(--sub)}
th.l,td.l{text-align:left}
tbody tr:hover td{background:var(--accent-soft)}
td.ell{max-width:180px;overflow:hidden;text-overflow:ellipsis}
.chip{display:inline-block;background:var(--chip);border-radius:20px;padding:1px 9px;font-size:12px}
.chip.auto{background:var(--ok-soft);color:var(--ok)}
.chip.pend{background:var(--warn-soft);color:var(--warn)}
.chip.anchor{background:var(--fill);color:var(--fill-ink)}
.chip.base{background:var(--amber-soft);color:var(--amber)}
.chip.skip{background:var(--chip);color:var(--sub)}
.chip.audio{background:var(--accent-soft);color:var(--accent)}
.dosLow{color:var(--warn);font-weight:700}
.dosMid{color:var(--amber);font-weight:600}
td.oct,th.oct{background:var(--accent-soft)}
td.pvCell{cursor:cell;user-select:none}
td.pvSel{box-shadow:inset 0 0 0 2px var(--accent)!important;background:var(--accent-soft)!important}
.muted{color:var(--sub)}
/* 推演网格 */
.grid th.wk{min-width:58px;text-align:center;font-weight:500}
.grid th.wk .d{font-size:10px;color:var(--sub);font-weight:400}
.grid td.hist{background:var(--hist)}
.grid th.futStart,.grid td.futStart{border-left:2px solid var(--accent)}
.grid td.met,.grid th.met{position:sticky;left:0;background:var(--card);z-index:6;text-align:left;font-weight:600;min-width:120px;border-right:1px solid var(--line)}
.grid td[contenteditable]{background:var(--card);outline:none;cursor:text}
.grid td[contenteditable]:focus{box-shadow:inset 0 0 0 2px var(--accent)}
.grid td.ov{background:var(--ov)!important;color:var(--ov-ink);font-weight:700}
.grid td.fill{background:var(--fill)!important;color:var(--fill-ink)}
.grid td.norep{color:var(--sub);font-style:italic}
.legend{display:flex;gap:14px;flex-wrap:wrap;font-size:12px;color:var(--sub);margin:8px 2px}
.legend i{display:inline-block;width:12px;height:12px;border-radius:3px;vertical-align:-2px;margin-right:4px;border:1px solid var(--line)}
.confirmCard{border:1px solid var(--line);border-left:4px solid var(--warn);border-radius:8px;padding:10px 14px;margin-bottom:10px;background:var(--card)}
.confirmCard h4{margin:0 0 4px;font-size:14px}
.confirmCard .why{color:var(--sub);font-size:12px;margin-bottom:8px}
.confirmCard .ctl{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.confirmCard .ctl .grp{display:flex;gap:6px;align-items:center;background:var(--chip);border-radius:8px;padding:5px 8px}
.msWrap{position:relative;display:inline-block}
.msPop{display:none;position:absolute;top:110%;left:0;z-index:60;background:var(--card);border:1px solid var(--line);border-radius:8px;padding:8px;max-height:320px;overflow:auto;min-width:240px;box-shadow:0 6px 24px rgba(0,0,0,.25)}
.msOpt{display:block;padding:3px 4px;font-size:13px;cursor:pointer;white-space:nowrap}
.msOpt:hover{background:var(--chip);border-radius:4px}
button.mini{background:var(--chip);color:var(--ink);border:1px solid var(--line);border-radius:5px;padding:1px 8px;font-size:11px;cursor:pointer}
textarea#paste{width:100%;min-height:180px;font:12px/1.4 Consolas,monospace}
#report{font-size:13px;white-space:pre-wrap;color:var(--sub)}
.note{font-size:12px;color:var(--sub)}
.bar{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:10px}
footer{position:fixed;bottom:0;left:0;right:0;background:var(--card);border-top:1px solid var(--line);color:var(--sub);font-size:11px;padding:3px 16px;z-index:20}
.metaRow{display:flex;gap:16px;flex-wrap:wrap;align-items:center;margin-bottom:10px;font-size:13px}
.metaRow b{font-size:15px}
.ver{display:inline-block;margin-left:8px;padding:1px 8px;border-radius:99px;background:var(--accent-soft);color:var(--accent);font-size:11px;font-weight:700;vertical-align:2px}
#expOv{position:fixed;inset:0;z-index:900;background:rgba(0,0,0,.45);display:none;align-items:center;justify-content:center;padding:20px}
.expCard{background:var(--card);border:1px solid var(--line);border-radius:12px;max-width:min(1320px,96vw);width:100%;max-height:92vh;overflow:auto;padding:16px 18px;box-shadow:0 12px 40px rgba(0,0,0,.35)}
.expHead{display:flex;gap:12px;align-items:center;flex-wrap:wrap}
.expHead>.ghost{margin-left:auto}
.thSort{cursor:pointer;user-select:none;white-space:nowrap}
.thSort:hover{color:var(--accent)}
#bootOv{position:fixed;inset:0;z-index:999;background:var(--bg);display:flex;align-items:center;justify-content:center}
.bootCard{width:min(430px,82vw);background:var(--card);border:1px solid var(--line);border-radius:12px;padding:26px 30px;box-shadow:0 8px 30px rgba(0,0,0,.12)}
.bootBrand{font-size:18px;font-weight:700;margin-bottom:16px}
.bootBrand::after{content:"Salesboard";display:block;font-size:11px;font-weight:400;color:var(--sub);margin-top:2px}
.bootTrack{height:8px;border-radius:99px;background:var(--line);overflow:hidden}
#bootFill{height:100%;width:0%;border-radius:99px;background:var(--accent);transition:width .18s ease}
.bootRow{display:flex;justify-content:space-between;gap:12px;margin-top:10px;font-size:12px;color:var(--sub)}
#bootPct{font-variant-numeric:tabular-nums;color:var(--ink);flex:none}
#bootTxt{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
</style>
<script>
/* 版本号单一定义处:发布新版只改这里(界面两处显示自动跟随),同时把 package.json 的 version 对齐 */
window.APP_VER='V90';
</script>
</head>
<body>
<div id="bootOv"><div class="bootCard">
  <div class="bootBrand">FSD PSI 推演<span class="ver" id="bootVer"></span></div>
  <div class="bootTrack"><div id="bootFill"></div></div>
  <div class="bootRow"><span id="bootTxt">正在启动…</span><span id="bootPct">0%</span></div>
</div></div>
<header>
  <div class="hrow">
    <h1>FSD PSI 推演<span class="ver" id="appVer"></span><span class="sub">Salesboard</span></h1>
    <span id="dataline">未载入数据</span><span id="errBadge" class="badge" style="display:none;cursor:pointer;margin-left:8px" title="最近错误(点开看;也写到 errors.log)"></span>
    <script>document.getElementById('bootVer').textContent=window.APP_VER;
    document.getElementById('appVer').textContent=window.APP_VER;</script>
  </div>
  <nav id="viewNav">
    <button data-view="work" title="待办 · 单元清单 · 监控与目标 · 渠道架构与对账">工作台<span class="badge" id="pendBadge" style="display:none">0</span></button>
    <button data-view="pv" title="任意层级拍数矩阵 + 汇总 / 月末风险 / 单元明细">推演编辑</button>
    <button data-view="ctl" title="产品×型号 参数与锁量控制面 · 新品规划">产品总控</button>
    <button data-view="ext" title="财经口径的产品经营看板与对外导出">对外</button>
    <button data-view="cfg" title="规则与模型 · 数据载入">配置</button>
    <button class="aiNav" id="btnAiNav" title="取数口径与推演解释助手(本地模型可选;不配模型也能查确定性因子分解)">AI 解读</button>
    <button id="btnTheme" title="切换 深色/浅色/跟随系统">🌓</button>
  </nav>
  <nav id="subNav"></nav>
  <nav id="tabs" class="legacyNav">
    <button data-tab="monitor" title="监控对账板 + 国家 SO 目标跟踪,一页两个 Tab">监控与目标</button>
    <button data-tab="watch" class="legacy">监控</button>
    <button data-tab="master">产品总控</button>
    <button data-tab="fin" title="财经口径:每季度 SIP→NSIP→递延→收入→销毛率,公式照抄经营数据表">产品经营</button>
    <button data-tab="channels" title="FSD 直签渠道 / 下游渠道 / 音频专表 三张单元清单合成一页,按数据来源切换">渠道清单</button>
    <button data-tab="overview" class="legacy">FSD库存</button>
    <button data-tab="detail" class="legacy">推演明细</button>
    <button data-tab="summary" class="legacy">推演汇总</button>
    <button data-tab="pv">推演编辑</button>
    <button data-tab="confirm">待确认</button>
    <button data-tab="retail" class="legacy">下游渠道</button>
    <button data-tab="chantree" title="每个国家一张连线图:直接渠道(FSD)与下游渠道(间接零售伙伴)的归属">渠道架构</button>
    <button data-tab="audio" class="legacy">音频专板</button>
    <button data-tab="monthend" class="legacy">月末DOS</button>
    <button data-tab="targets" class="legacy">SO目标</button>
    <button data-tab="newprod">新品规划</button>
    <button data-tab="rules" title="规则(免推演阈值/补货参数/红线/收官/大促/生命周期/渠道/快照)与模型(周系数五层表/回测台),一页两个 Tab">规则与模型</button>
    <button data-tab="coef" class="legacy">系数与参数</button>
    <button data-tab="settings" class="legacy">设置</button>
    <button data-tab="data">数据</button>
  </nav>
</header>
<main>
  <section id="view-watch"></section>
  <section id="view-master"></section>
  <section id="view-fin"></section>
  <section id="view-monitor"></section>
  <section id="view-channels"></section>
  <section id="view-overview"></section>
  <section id="view-detail"></section>
  <section id="view-summary"></section>
  <section id="view-pv"></section>
  <section id="view-confirm"></section>
  <section id="view-retail"></section>
  <section id="view-chantree"></section>
  <section id="view-audio"></section>
  <section id="view-monthend"></section>
  <section id="view-targets"></section>
  <section id="view-newprod"></section>
  <section id="view-rules"></section>
  <section id="view-coef"></section>
  <section id="view-settings"></section>
  <section id="view-data">
    <div id="folderHost"></div>
    <div class="panel">
      <h3>粘贴底表（自 Excel 复制粘贴，含表头；亦支持 CSV / Markdown 表格）</h3>
      <textarea id="paste" placeholder="从 Excel 选中区域 Ctrl+C，在这里 Ctrl+V ……&#10;列：管理国家 / 客户(D) / Product Line / Product / Product Model / Period ID / PSI Type / QTY"></textarea>
      <div class="bar" style="margin-top:8px">
        <button class="act" id="btnParse">作为 FSD 表载入</button>
        <button class="ghost" id="btnParse2">作为下游渠道表载入</button>
        <button class="ghost" id="btnSample">载入内置演示数据</button>
        <label class="ghost" style="cursor:pointer">从文件读取(CSV/TXT)<input type="file" id="file" accept=".csv,.txt,.tsv" style="display:none"></label>
        <button class="ghost" id="btnClear">清空全部数据与设置</button>
      </div>
      <div id="report"></div>
    </div>
    <div class="panel">
      <h3>方案（推演设置：确认结果 / 手工编辑 / 系数 / 参数）</h3>
      <div class="bar">
        <button class="ghost" id="btnExport">导出方案 JSON</button>
        <label class="ghost" style="cursor:pointer">导入方案 JSON<input type="file" id="fileScheme" accept=".json" style="display:none"></label>
      </div>
      <div class="note">方案（确认结果/手工改写/系数/参数）自动保存在本机。迁移至其他电脑：复制 exe、底表文件夹与方案 JSON 即可。数据不联网、不出本机。</div>
    </div>
  </section>
</main>
<footer>FSD PSI 推演 v0.2 · 数据不出本机 · 音频口径：末尾未报量周自动跳过（仅音频与智能配件）</footer>

