/* ===== 字典与契约(2026-09-15 FDE 评审 R2)=====
   DICT:参与逻辑判断的业务字面量只在这里出现一次;SCHEMA:底表长表的列契约(必填/可选/别名/PSI 取值)。
   validateGrid 只做判定不做解析;parseGrid 在契约不满足时拒绝整表并给出可执行的原因,而不是静默按位置猜列。 */
C.DICT={SRC_FSD:'FSD',SRC_RETAIL:'下游',SRC_AUDIO:'音频专表',SRC_NP:'新品规划',GARNET_AUDIO:'音频与智能配件',BUY_REVIEW_IND:'FSD表·下游(间接)'};
C.SCHEMA={
  grid:{
    fields:[
      ['country',['countr','国家','地区'],false],
      ['account',['account','channel','客户','账户','渠道'],true],
      ['line',['productline','产品线','品类'],false],
      ['model',['productmodel','model','型号'],true],
      ['series',['productseries','series','系列'],false],
      ['product',['product','产品'],false],
      ['period',['period','期间','周期'],true],
      ['psi',['psitype','psi','类型'],true],
      ['qty',['qty','quantity','数量'],true]
    ],
    labels:{country:'国家',account:'账户/渠道',line:'产品线',model:'型号',series:'系列',product:'产品',period:'Period ID(周期)',psi:'PSI Type',qty:'QTY'},
    positional:{8:['country','account','line','product','model','period','psi','qty'],9:['country','account','line','product','series','model','period','psi','qty']},
    psi:['Inventory','Inventory1','Sell In','Purchase','Sell Out','SO1','Sell Through','DOS']
  }
};
C.validateGrid=function(grid){
  const out={ok:false,header:false,missing:[],colMap:{},cols:0,error:null};
  if(!grid||!grid.length){ out.error='空表'; return out; }
  const norm=function(x){ return String(x==null?'':x).toLowerCase().replace(/[^a-z0-9一-鿿]/g,''); };
  const F0=C.SCHEMA.grid.fields; let hits=0;
  grid[0].map(norm).forEach(function(cell,idx){
    for(let k=0;k<F0.length;k++){ const f=F0[k][0]; if(out.colMap[f]!=null)continue;
      if(F0[k][1].some(function(p){ return cell.indexOf(p)>=0; })){ out.colMap[f]=idx; hits++; return; } }
  });
  out.cols=grid[0].length;
  if(hits>=3){
    out.header=true;
    out.missing=F0.filter(function(f){ return f[2]&&out.colMap[f[0]]==null; }).map(function(f){ return f[0]; });
    if(out.missing.length){ out.error='识别到表头,但缺少必填列:'+out.missing.map(function(f){ return C.SCHEMA.grid.labels[f]; }).join('、')+'。请补齐列名(可用别名见「数据」页说明),不按位置猜。'; return out; }
    out.ok=true; return out;
  }
  const pos=C.SCHEMA.grid.positional[out.cols];
  if(!pos){ out.error='没有识别到表头(命中列名 '+hits+' 个 <3),且列数 '+out.cols+' 不是 8(FSD 表)或 9(下游表),无法按位置解析。请保留表头行。'; return out; }
  Object.keys(out.colMap).forEach(function(k){ delete out.colMap[k]; });
  pos.forEach(function(f,i){ out.colMap[f]=i; });
  out.ok=true; return out;
};
/* 网格(二维数组,单元格可为数字/字符串)→ 标准行。xlsx sheet 与文本粘贴共用同一条链 */
C.parseGrid=function(grid){
  const rep={total:0,used:0,badPeriod:0,badPsi:0,noKey:0,header:false,mode:'grid'};
  if(!grid||!grid.length) return {rows:[],report:rep};
  const norm=function(s){ return String(s==null?'':s).toLowerCase().replace(/[^a-z0-9一-鿿]/g,''); };
  /* 契约校验(R2):缺必填列 / 无表头且列数不对 → 整表拒绝,report.error 说清缺什么 */
  const vg=C.validateGrid(grid);
  rep.contract={header:vg.header,missing:vg.missing,cols:vg.cols};
  if(!vg.ok){ rep.error=vg.error; return {rows:[],report:rep}; }
  const colMap=vg.colMap;
  let start=0;
  if(vg.header){ rep.header=true; start=1; }
  /* PSI 类型映射(2026-09-02 用户:音频在 FSD 源用成了 SO1 而不是 SO TTL):
     SO1 / Sell Out1 = 直接客户自有 SO,单独存 so1 字段,不与 SO 相加、不参与推演;SO / SO TTL / Sell Out(TTL) = 渠道总 SO → so */
  const psiNorm=function(s){ const t=norm(s); if(!t) return null;
    if(t.indexOf('inventory1')>=0||t.indexOf('库存1')>=0||t==='inv1') return 'inv1';
    if(t.indexOf('inventory')>=0||t.indexOf('库存')>=0||t==='inv') return 'inv';
    if(t.indexOf('sellin')>=0||t==='si') return 'si';
    if(t.indexOf('purchase')>=0||t.indexOf('进货')>=0) return 'si';   // 下游表 Purchase = 该渠道的进货
    if(t==='so1'||t.indexOf('sellout1')>=0||t==='soown') return 'so1';   // 自有 SO,先于 sellout 判断
    if(t.indexOf('sellout')>=0||t==='so'||t==='sottl'||t==='sototal'||t==='sott') return 'so';
    if(t.indexOf('sellthrough')>=0||t==='st') return 'st';
    if(t.indexOf('dos')>=0) return 'dos';                              // DOS1 也归到 dos
    return null; };
  const parsePeriod=function(v){
    const t=String(v==null?'':v).trim();
    const mw=t.match(/^(\d{4})\s*[wW]\s*(\d{1,3})$/);   // 下游表格式 2026W01
    let y,w;
    if(mw){ y=+mw[1]; w=+mw[2]; }
    else { const s=t.replace(/\D/g,'');
      if(s.length!==6&&s.length!==7) return null;
      y=+s.slice(0,4); w=+s.slice(4); }
    if(y<2000||y>2100||w<1||w>53) return null;
    return C.mkPeriod(y,w); };
  const rows=[];
  for(let i=start;i<grid.length;i++){
    const g=grid[i];
    if(!g||g.length===0||g.every(function(c){ return c==null||c===''; })) continue;
    rep.total++;
    const cell=function(f){ return colMap[f]!=null?g[colMap[f]]:undefined; };
    const period=parsePeriod(cell('period'));
    if(period==null){ rep.badPeriod++; continue; }
    const rawPsi=String(cell('psi')==null?'':cell('psi')).trim();
    const psi=psiNorm(rawPsi);
    (rep.psiTypes=rep.psiTypes||{})[rawPsi+'→'+(psi||'✗')]=((rep.psiTypes||{})[rawPsi+'→'+(psi||'✗')]||0)+1;   // 导入报告:每种 PSI 原文映射到什么(✗=丢弃)
    if(!psi){ rep.badPsi++;
      /* 契约(R2):看够 50 行仍没有一个 PSI 能识别 → 整表拒绝(列对了但取值体系不对,比如整列是中文类别名) */
      if(rep.total>50&&rep.badPsi===rep.total-rep.badPeriod){ rep.error='前 '+rep.total+' 行的 PSI Type 没有一个能识别(接受:'+C.SCHEMA.grid.psi.join(' / ')+'),整表拒绝。'; return {rows:[],report:rep}; }
      continue; }
    const model=String(cell('model')||'').trim();
    const account=String(cell('account')||'').trim();
    if(!model||!account){ rep.noKey++; continue; }
    rows.push({ country:String(cell('country')||'').trim(), account:account,
      line:String(cell('line')||'').trim(), product:String(cell('product')||'').trim(),
      series:String(cell('series')||'').trim(),
      model:model, period:period, psi:psi, qty:C.parseCellNum(cell('qty')) });
    rep.used++;
  }
  return {rows:rows,report:rep};
};

/* ---------- 组装单元 ---------- */
C.isAudioLine=function(line){ const s=String(line||''); return s.indexOf('音频')>=0||s.toLowerCase().indexOf('audio')>=0; };
C.SEP='::';
C.buildStore=function(rows,opts){
  const retail=!!(opts&&opts.retail);
  const units=new Map(); let maxPeriod=0,minPeriod=Infinity;
  rows.forEach(function(r){
    /* key 含国家:同一账户可在多个国家开展业务(如Andes Digital同时做巴西与加拿大),必须分开 */
    const k=(r.country||'')+C.SEP+r.account+C.SEP+r.model;
    let u=units.get(k);
    if(!u){ u={key:k,country:r.country,account:r.account,line:r.line,product:r.product,model:r.model,
      series:r.series||'',rawNames:{},unmapped:!!r.unmapped,audio:false,weeks:new Map()}; units.set(k,u); }
    if(r.line&&!u.line)u.line=r.line;
    if(r.product&&!u.product)u.product=r.product;
    if(r.country&&!u.country)u.country=r.country;
    if(r.series&&!u.series)u.series=r.series;
    if(r.rawAccount)u.rawNames[r.rawAccount]=1;
    let w=u.weeks.get(r.period);
    if(!w){ w={si:null,so:null,inv:null,inv1:null,dos:null,st:null}; u.weeks.set(r.period,w); }
    const fld=(retail&&r.psi==='inv1')?'inv':r.psi;   // 下游表的 Inventory1 = 该渠道的库存本体
    if(r.qty!=null) w[fld]=(w[fld]==null?0:w[fld])+r.qty;
    if(r.period>maxPeriod)maxPeriod=r.period;
    if(r.period<minPeriod)minPeriod=r.period;
  });
  units.forEach(function(u){ u.audio=C.isAudioLine(u.line);
    u.rawNames=Object.keys(u.rawNames);
    u.periods=Array.from(u.weeks.keys()).sort(function(a,b){return a-b;}); });
  return {units:units,maxPeriod:maxPeriod,minPeriod:isFinite(minPeriod)?minPeriod:0,retail:retail};
};

