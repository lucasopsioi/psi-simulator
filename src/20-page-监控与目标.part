/* ===== 监控与目标(2026-09-10 看板收敛 阶段4c)=====
   监控对账板(基线→当前)与国家 SO 目标跟踪本是一条线:目标告警本就是监控模块四的来源。合成一页两个 Tab,
   原函数渲染进子容器,数值与交互原样;门禁断言每个 Tab 与被吸收的旧页逐格相同。 */
const MON_TABS=[['watch','对账板','单元/层级/国家/产品 基线→当前 对账,退市预剩,目标告警'],['targets','SO 目标','国家 SO 目标回填表:目标 vs 实际、月底/年底承诺 DOS(÷28)、系族基线']];
function renderMonitor(){
  const el=$('#view-monitor');
  const t=MON_TABS.some(function(x){ return x[0]===state.ui.monTab; })?state.ui.monTab:'watch';
  ['#view-watch','#view-targets'].forEach(function(id){ const s2=$(id); if(s2)s2.innerHTML=''; });
  const nAl=(typeof Dt!=='undefined'&&Dt&&Dt.alerts)?Dt.alerts.length:0;
  el.innerHTML='<div class="bar" id="monTabBar">'+MON_TABS.map(function(x){
    return '<button class="'+(t===x[0]?'act':'ghost')+'" data-montab="'+x[0]+'" title="'+x[2]+'">'+x[1]+(x[0]==='targets'&&nAl?' <span class="badge">'+nAl+'</span>':'')+'</button>';
  }).join('')+'<span class="note">对账板看「变了没有」，SO 目标看「达不达得到」</span></div><div id="monBody"></div>';
  const body=$('#monBody');
  if(t==='targets')renderTargets(body); else renderWatch(body);
  el.querySelectorAll('[data-montab]').forEach(function(b){ b.onclick=function(){ state.ui.monTab=b.dataset.montab; render(); }; });
}
