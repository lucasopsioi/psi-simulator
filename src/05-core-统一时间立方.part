/* ===== 统一时间立方(2026-09-04 看板收敛 阶段2)=====
   推演编辑的 分桶/单元序列/聚合/桶DOS 原文提升为引擎函数——所有看板、导出、AI 统一从这里取数;
   页面里旧名 pv2Buckets/pv2ItemVals/pv2Agg/pv2BucketDos 只是别名。纯函数、可单测(test.js)。 */
C.unitKey3=function(country,account,model){ return country+'\u0001'+account+'\u0001'+String(model==null?'':model); };
/* 时间桶:mode=hist(·A)/sim(今年推演,可拍)/ext(外推·E,只读);月按周四归属;histN=历史桶只保留最近 N 个 */
function tbBuckets(Dx,stx,gran,yrs,histN,expand){
  const curY=C.periodY(stx.maxPeriod);
  const fwSet={}; Dx.fw.forEach(function(p2){ fwSet[p2]=1; });
  const wByY={};
  stx.units.forEach(function(u){ u.periods.forEach(function(p2){
    const y=C.periodY(p2);
    (wByY[y]=wByY[y]||{})[p2]=1; }); });
  Dx.fw.forEach(function(p2){ (wByY[curY]=wByY[curY]||{})[p2]=1; });
  const bks=[];
  if(gran==='week'){
    /* 周粒度历史可跨年(近 N 周),未来=当前推演段 */
    const allP={};
    Object.keys(wByY).forEach(function(y){ Object.keys(wByY[y]).forEach(function(p2){ allP[p2]=1; }); });
    const ws=Object.keys(allP).map(Number).sort(function(x,y){return x-y;});
    const hist=ws.filter(function(p2){ return !fwSet[p2]; }).slice(-(histN!=null?histN:8));
    hist.concat(Dx.fw).forEach(function(p2){
      bks.push({key:'W'+p2,label:C.weekLabel(p2),y:C.periodY(p2),weeks:[p2],days:7,m:C.monthOfP(p2),lastWeeks:[p2],lastDays:7,
        mode:fwSet[p2]?'sim':'hist'});
    });
    bks.forEach(function(b2){ b2.fut=(b2.weeks||[]).filter(function(p2){ return fwSet[p2]; }); b2.hasFut=b2.fut.length>0; });   // 周粒度也要可拍(2026-09-02 用户:未来格编辑不了——此前周分支提前返回,没算 hasFut)
    return {bks:bks,fwSet:fwSet,curY:curY,weekOnlyCur:true};
  }
  yrs.forEach(function(y){
    const ws=Object.keys(wByY[y]||{}).map(Number).sort(function(x,y2){return x-y2;});
    const mk2=function(mFrom,mTo,key,label){
      if(y<=curY){
        const sub=ws.filter(function(p2){ const m=C.monthOfP(p2); return m>=mFrom&&m<=mTo; });
        if(!sub.length)return;
        const anyFut=sub.some(function(p2){ return fwSet[p2]; });
        /* 桶 DOS 口径(2026-09-02 用户:月视图 12 月底 DOS 50 天,切季视图 Q4 变 106 天是错的):季/年列的 DOS = 该桶最后一个月的月末DOS
           (末月库存÷(末月SO÷末月天数)),与月视图同值;此前季/年用整桶 SO 均摊,12 月拍高后 Q4 的 DOS 被季均拉大 */
        let mL=mFrom; sub.forEach(function(p2){ const m=C.monthOfP(p2); if(m>mL)mL=m; });
        const lastW=sub.filter(function(p2){ return C.monthOfP(p2)===mL; });
        bks.push({key:key,label:label,y:y,weeks:sub,days:sub.length*7,m:mTo,lastWeeks:lastW,lastDays:lastW.length*7,mL:mL,
          mode:(y===curY&&anyFut)?'sim':'hist',canExp:gran==='month'});
      } else {
        const months=[]; for(let m=mFrom;m<=mTo;m++)months.push(y+'-'+m);
        bks.push({key:key,label:label,y:y,weeks:[],months:months,days:months.reduce(function(s,ym){ return s+C.monthDaysOf(y,+ym.split('-')[1]); },0),m:mTo,
          lastWeeks:[],lastDays:C.monthDaysOf(y,mTo),mL:mTo,mode:'ext'});   // 外推月天数=该月周数×7(2026-09-02 统一);季/年 DOS 按末月
      }
    };
    if(gran==='month'){
      for(let m=1;m<=12;m++){
        const key='M'+y+'-'+m;
        if(y<=curY&&expand&&expand[key]){
          /* 月展开为周:该月各周独立桶(可拍粒度=周),th 上「−」收起;外推年无周结构不展开 */
          const ws2=ws.filter(function(p2){ return C.monthOfP(p2)===m; });
          if(!ws2.length)continue;
          ws2.forEach(function(p2,wi){
            bks.push({key:'W'+p2,label:C.weekLabel(p2),y:y,weeks:[p2],days:7,m:m,lastWeeks:[p2],lastDays:7,
              mode:fwSet[p2]?'sim':'hist',mSub:key,mSubFirst:wi===0});
          });
        } else mk2(m,m,key,m+'月');
      }
    }
    else if(gran==='quarter'){ for(let q=1;q<=4;q++)mk2(q*3-2,q*3,'Q'+y+'-'+q,'Q'+q); }
    else mk2(1,12,'Y'+y,y+'年');
  });
  /* 历史桶范围裁剪:按时间序只留最近 histN 个(0=全隐藏) */
  if(histN!=null){
    const histIdx=[];
    bks.forEach(function(b2,i2){ if(b2.mode==='hist'&&!b2.mSub)histIdx.push(i2); });
    if(histIdx.length>histN){
      const drop={};
      histIdx.slice(0,histIdx.length-histN).forEach(function(i2){ drop[i2]=1; });
      for(let i2=bks.length-1;i2>=0;i2--)if(drop[i2])bks.splice(i2,1);
    }
  }
  bks.forEach(function(b2){
    b2.fut=(b2.weeks||[]).filter(function(p2){ return fwSet[p2]; });
    b2.hasFut=b2.fut.length>0;
  });
  return {bks:bks,fwSet:fwSet,curY:curY};
}
function tbUnitSeries(it,bctx,src,extByKey){
  const bks=bctx.bks,n=bks.length;
  const so=new Array(n).fill(0),si=new Array(n).fill(0),inv=new Array(n).fill(null),invP=new Array(n).fill(0);
  const soL=new Array(n).fill(0);   // 桶末月 SO(季/年列 DOS 分母;月/周桶=整桶)
  const bIdx={},lIdx={};
  bks.forEach(function(b2,i2){ (b2.weeks||[]).forEach(function(p2){ bIdx[p2]=i2; }); (b2.lastWeeks||b2.weeks||[]).forEach(function(p2){ lIdx[p2]=i2; }); });
  const u=it.u;
  u.periods.forEach(function(p2){
    const i2=bIdx[p2]; if(i2==null||bctx.fwSet[p2])return;
    const w=u.weeks.get(p2);
    so[i2]+=(w.so||0); si[i2]+=(w.si||0); if(lIdx[p2]===i2)soL[i2]+=(w.so||0);
    const iv=w.inv!=null?w.inv:w.inv1;
    if(iv!=null&&p2>=invP[i2]){ inv[i2]=iv; invP[i2]=p2; }
  });
  ((it.sim&&it.sim.rows)||[]).forEach(function(r){
    const i2=bIdx[r.p]; if(i2==null)return;
    so[i2]+=(r.so||0); si[i2]+=((src==='fsd')?(r.si||0):(r.buy||0)); if(lIdx[r.p]===i2)soL[i2]+=(r.so||0);
    if(r.inv!=null&&r.p>=invP[i2]){ inv[i2]=r.inv; invP[i2]=r.p; }
  });
  /* 桶内没有该单元数据(免推演/停售/上市前)时,期末库存按「最近一次已知库存」结转(库存不会自己消失;2026-09-02 审计:此前月桶留空、年桶却结转,月/年不一致) */
  (function(){
    const pts=[];
    u.periods.forEach(function(p2){ if(bctx.fwSet[p2])return; const w=u.weeks.get(p2); const iv=w.inv!=null?w.inv:w.inv1; if(iv!=null)pts.push([p2,iv]); });
    ((it.sim&&it.sim.rows)||[]).forEach(function(r){ if(r.inv!=null)pts.push([r.p,r.inv]); });
    if(!pts.length)return;
    pts.sort(function(a,b){ return a[0]-b[0]; });
    bks.forEach(function(b2,i2){ if(inv[i2]!=null||b2.mode==='ext'||!(b2.weeks&&b2.weeks.length))return;
      const endP=b2.weeks[b2.weeks.length-1]; let best=null;
      for(let k=0;k<pts.length;k++){ if(pts[k][0]<=endP)best=pts[k][1]; else break; }
      if(best!=null){ inv[i2]=best; invP[i2]=endP; } });
  })();
  const soOv=new Array(n).fill(false),siOv=new Array(n).fill(false),soCarry=new Array(n).fill(false),soCap=new Array(n).fill(false);
  ((it.sim&&it.sim.rows)||[]).forEach(function(r){ const i2=bIdx[r.p]; if(i2==null)return;
    if(r.carry!=null)soCarry[i2]=true;
    if(r.capped&&r.soSrc==='override')soCap[i2]=true;   // 手拍 SO 被库存/锁量压回(2026-09-02 审计 R1:此前格上完全没有信号)
  });
  if(extByKey){
    const e=extByKey.get(C.unitKey3(u.country,u.account,u.model));
    if(e)bks.forEach(function(b2,i2){
      if(b2.mode!=='ext')return;
      b2.months.forEach(function(ym,mi){
        const o=e[ym]; if(!o)return;
        so[i2]+=o.so; si[i2]+=o.si;
        if(o.soOv)soOv[i2]=true;
        if(o.siOv)siOv[i2]=true;
        if(mi===b2.months.length-1){ inv[i2]=(inv[i2]||0)+o.inv; soL[i2]+=o.so; }
      });
    });
  }
  return {so:so,si:si,inv:inv,soOv:soOv,siOv:siOv,soCarry:soCarry,soCap:soCap,soL:soL};
}
function tbAgg(items,valMap,n){
  const so=new Array(n).fill(0),si=new Array(n).fill(0),inv=new Array(n).fill(null),soL=new Array(n).fill(0);
  const soOv=new Array(n).fill(false),siOv=new Array(n).fill(false),soCarry=new Array(n).fill(false),soCap=new Array(n).fill(false);
  items.forEach(function(it){
    const v=valMap.get(it.u.key); if(!v)return;
    for(let i2=0;i2<n;i2++){
      so[i2]+=v.so[i2]; si[i2]+=v.si[i2]; soL[i2]+=(v.soL?v.soL[i2]:v.so[i2]);
      if(v.inv[i2]!=null)inv[i2]=(inv[i2]||0)+v.inv[i2];
      if(v.soOv&&v.soOv[i2])soOv[i2]=true;
      if(v.siOv&&v.siOv[i2])siOv[i2]=true;
      if(v.soCarry&&v.soCarry[i2])soCarry[i2]=true;
      if(v.soCap&&v.soCap[i2])soCap[i2]=true;
    }
  });
  return {so:so,si:si,inv:inv,soOv:soOv,siOv:siOv,soCarry:soCarry,soCap:soCap,soL:soL};
}
/* 桶 DOS(统一口径):期末库存÷(末月SO÷末月天数);季/年列=该桶最后一个月的月末DOS(与月视图同值);周桶=÷(周SO÷7) */
function tbBucketDos(a,i2,b2){
  const soB=(a.soL?a.soL[i2]:a.so[i2]),iv=a.inv[i2];
  const days=(b2.lastDays||b2.days);
  return {soB:soB,iv:iv,dv:(iv!=null&&soB>0&&days>0)?Math.round(iv/(soB/days)):null};
}
C.timeBuckets=tbBuckets; C.unitSeries=tbUnitSeries; C.aggSeries=tbAgg; C.bucketDos=tbBucketDos;
C.siOf=function(r,src){ return src==='fsd'?(r.si||0):(r.buy||0); };
/* 维度取值:看板按 dims 任意层序分组时统一从这里取 */
C.DIM_OF={
  line:function(it){ return it.u.line||''; },
  product:function(it){ return it.u.product||''; },
  model:function(it){ return it.u.model||it.u.product||''; },
  country:function(it){ return it.u.country||''; },
  account:function(it){ return it.u.account||''; },
  rep:function(it){ return C.repOf(it.u.country)||''; },
  family:function(it){ const f=C.familyOf(it.u.product); return f?f.family:''; }
};
/* 当前态聚合:Σ当前库存 / Σ日均 → 当前DOS。invFallback:'inv1' = INV 缺失回落 INV1(产品总控现状;D3 前各消费方按现状传参) */
C.curAgg=function(items,o){
  o=o||{}; let inv=0,daily=0,n=0,hasInv=false;
  items.forEach(function(it){ const c=it.cur||{}; n++;
    const iv=(c.curInv!=null)?c.curInv:(o.invFallback==='inv1'?c.curInv1:null);
    if(iv!=null){ inv+=iv; hasInv=true; }
    daily+=(c.dailySO||0); });
  return {n:n,inv:hasInv?inv:null,daily:daily,dosCur:(hasInv&&daily>0)?Math.round(inv/daily):null};
};
/* 查询(阶段2):env={Dx,stx,items,extByKey,expand,valMap?} 由页面准备(数据对象/过滤后的单元/外推映射);
   q={src,gran,yrs,histN,dims,mode:'tree'|'flat',cur}。输出 {buckets,fwSet,curY,rows,valMap};rows[0] 永远是合计行(path=[]),
   tree 模式逐级前缀各一行,flat 模式只出全维度叶子。dos 只在行级算(Σ库存÷(Σ末月SO÷天数)),绝不逐单元算完再平均——与推演编辑逐格相同。 */
C.qRun=function(env,q){
  const bctx=C.timeBuckets(env.Dx,env.stx,q.gran||'month',q.yrs,q.histN,env.expand||null);
  const n=bctx.bks.length,src=q.src||'fsd';
  const valMap=env.valMap||new Map();
  env.items.forEach(function(it){ if(!valMap.has(it.u.key))valMap.set(it.u.key,C.unitSeries(it,bctx,src,env.extByKey||null)); });
  const mkRow=function(path,items){
    const v=C.aggSeries(items,valMap,n);
    const dos=bctx.bks.map(function(b2,i2){ return C.bucketDos(v,i2,b2); });
    return {path:path,depth:path.length,items:items,v:v,dos:dos,cur:C.curAgg(items,q.cur||{})};
  };
  const rows=[mkRow([],env.items)];
  const dims=q.dims||[];
  if(dims.length){
    const byPath=new Map();
    env.items.forEach(function(it){
      const p=[];
      for(let d=0;d<dims.length;d++){
        const fn=C.DIM_OF[dims[d]]; p.push(fn?fn(it):'');
        if(q.mode==='flat'&&d<dims.length-1)continue;
        const k=p.join('\u0001');
        let g=byPath.get(k); if(!g){ g={path:p.slice(),items:[]}; byPath.set(k,g); }
        g.items.push(it);
      }
    });
    byPath.forEach(function(g){ rows.push(mkRow(g.path,g.items)); });
  }
  return {buckets:bctx.bks,fwSet:bctx.fwSet,curY:bctx.curY,rows:rows,valMap:valMap};
};

C.unitMonthSO=function(u,simRows,y,m){ const simMap={}; (simRows||[]).forEach(function(r){ simMap[r.p]=r; });
  let so=0; C.monthWeeksOf(y,m).forEach(function(p){ const r=simMap[p]; if(r){ so+=(r.so||0); return; } const w=(u&&u.weeks)?u.weeks.get(p):null; if(w&&w.so!=null)so+=w.so; }); return so; };
C.dosText=function(dv){ return dv==null?'—':(dv===Infinity?'∞':C.fmt(dv)); };
/* ---------- 锁量按时间顺序分配(2026-09-02 用户:拍高某月 SI/SO,后面月份要自动调减;之前拍过的不动;不要等比例把所有月份都改一遍) ----------
   entries=[{g:组(国家等),p:时间序(周/年月),si:规则量,fixed:手拍(原样保留、优先占预算)}];o.total=总预算;o.by={组键:预算};o.groupsOf(e)→该条目受哪些组预算约束;o.step 步长
   先把 fixed 全部扣掉(超了记 manOver),再按 p 升序(同 p 按输入顺序)给自动量:min(规则量, 各预算余量) 按步长向下取整,余量用尽后为 0。
   返回 {alloc[],used(含fixed),before(规则量合计),fixed,manOver,cutAt(首次被砍的 p),left} */
C.lockSeqAlloc=function(entries,o){
  o=o||{}; const step=o.step||1;
  const left={total:o.total!=null?o.total:Infinity}; const by=o.by||{}; Object.keys(by).forEach(function(k){ left[k]=by[k]; });
  const groupsOf=o.groupsOf||function(){ return []; };
  let fixedSum=0,before=0;
  entries.forEach(function(e){ before+=(e.si||0); if(e.fixed)fixedSum+=(e.si||0); });
  /* 手拍(fixed)按时间顺序占预算(2026-09-02 第二轮审计 R2/R6 修正):此前不论时间先后一次性预扣,
     于是「拍 12 月 SI=余量」会把 9–11 月的自动 SI 全部清 0(断供点提前到拍数之前),后年(cy+2)的手拍还会挤掉明年的自动量,
     导致同一个 2027 月份在 budgetRowsOv(2027) 与 (2028) 两个出口是两个数。现按用户口径「拍高某月,后面月份自动调减,之前调过的不动」:
     逐条按 p 升序处理,手拍到它自己的时间点才扣预算,超支记 manOver(工具条红字提示)。 */
  const order=entries.map(function(e,i){ return i; }).sort(function(a,b){ return (entries[a].p-entries[b].p)||(a-b); });
  const alloc=new Array(entries.length); let used=0,cutAt=null,manOver=false;
  order.forEach(function(i){ const e=entries[i];
    const gs=groupsOf(e);
    if(e.fixed){ const v=e.si||0; alloc[i]=v; used+=v; left.total-=v; gs.forEach(function(k){ if(left[k]!=null)left[k]-=v; });
      if(left.total<-1e-9)manOver=true; return; }
    let cap=Math.max(0,left.total); gs.forEach(function(k){ if(left[k]!=null)cap=Math.min(cap,Math.max(0,left[k])); });
    let take=C.floorStep(Math.min(e.si||0,cap),step);
    if(take<C.floorStep(e.si||0,step)&&cutAt==null)cutAt=e.p;   // 规则量本身不是步长倍数时的取整不算"被砍"(2026-09-02 审计)
    alloc[i]=take; used+=take; left.total-=take; gs.forEach(function(k){ if(left[k]!=null)left[k]-=take; });
  });
  return {alloc:alloc,used:used,before:before,fixed:fixedSum,manOver:manOver,cutAt:cutAt,left:left.total};
};
/* 预算月行重链:同一单元延伸月按年月序 库存=期初+SI−SO(SO≤期初+SI);inv0=期初(调用方按改前值算好) */
C.rechainMonthRows=function(rows,idxs,inv0){
  const list=idxs.slice().sort(function(a,b){ return (rows[a][7]-rows[b][7])||(rows[a][9]-rows[b][9]); });
  let inv=inv0;
  list.forEach(function(i){ const r=rows[i]; if(inv==null)inv=(+r[12]||0)-(+r[11]||0)+(+r[10]||0);
    const si=+r[11]||0; let so=+r[10]||0; if(so>inv+si)so=Math.max(0,Math.round(inv+si)); inv=inv+si-so;
    r[10]=so; r[12]=Math.round(inv); if(r[13]!==''&&r[13]!=null){ r[14]=Math.round(so*r[13]); r[15]=Math.round(si*r[13]); } });
};
/* 今年月末画像(2026-09-02 用户:去年月均库存 X、今年推演成 1.2X而 SO 没涨——明年的库存水位要跟今年走,不平白无故压货):
   今年每个月末的 库存/该月SO/天数→DOS(已过月取底表实际,未过月取今年推演);延伸段按它定各月水位,缺月才退回多年历史画像 */
C.thisYearProfileOf=function(u,simRows,maxPeriod){
  const y=C.periodY(maxPeriod); const out={m:{},n:0,y:y}; const simMap={}; (simRows||[]).forEach(function(r){ simMap[r.p]=r; });
  C.MONTHS.forEach(function(m){ const pe=C.monthEndPeriodOf(y,m); let inv=null;
    if(pe<=maxPeriod)inv=C.latestFieldAt(u,'inv',pe); else if(simMap[pe])inv=simMap[pe].inv;
    if(inv==null)return;
    const so=C.unitMonthSO(u,simRows,y,m); const dv=C.monthDos(inv,so,C.monthDaysOf(y,m));
    out.m[m]={inv:Math.round(inv),dos:(dv!=null&&isFinite(dv))?dv:null,so:so}; out.n++; });
  return out.n?out:null;
};
C.latestFieldAt=function(u,fld,p){
  let v=null,vp=-1;
  u.periods.forEach(function(q){ if(q>p||q<vp)return; const w=u.weeks.get(q); if(w&&w[fld]!=null){ v=w[fld]; vp=q; } });
  return v;
};
C.reconcileFsdRetail=function(store,retailStore,opts){
  opts=opts||{};
  const N=opts.weeks||8;
  const skipAudio=opts.skipAudio!==false;   // 音频下游是报量制,默认不对账
  const types=opts.types||null;   // 国家||直接渠道 → dist/retail/operator/online/own(渠道架构页):只有带下游型(分销)的 SO 与下游对,直达消费者型不对
  const tree=opts.tree||null;     // 国家 → {下游渠道:上游直接渠道名|'*'}(渠道架构页连线):给了就多出按直接渠道细分的对账行
  const out={rows:[],byDirect:[],window:[],lastP:null,sum:null};
  if(!store||!retailStore||!store.units||!retailStore.units)return out;
  const pf={},pr={};
  store.units.forEach(function(u){ if(skipAudio&&u.audio)return; u.periods.forEach(function(p){ if(u.weeks.get(p).so!=null)pf[p]=1; }); });
  retailStore.units.forEach(function(u){ if(skipAudio&&u.audio)return; u.periods.forEach(function(p){ if(u.weeks.get(p).so!=null)pr[p]=1; }); });
  const common=Object.keys(pf).filter(function(p){ return pr[p]; }).map(Number).sort(function(a,b){return a-b;});
  if(!common.length)return out;
  const win=common.slice(-N); const wset={}; win.forEach(function(p){ wset[p]=1; });
  const lastP=win[win.length-1];
  out.window=win; out.lastP=lastP;
  const typeOf=function(u){ if(!types)return 'dist'; const c=u.country||''; return types[c+'||'+(u.line||'')+'||'+u.account]||types[c+'||'+u.account]||'dist'; };   // 产业键优先,兼容旧的国家键
  const g={},gd={};
  const get=function(u){ const k=(u.country||'')+'||'+(u.product||''); let e=g[k];
    if(!e)e=g[k]={country:u.country||'',product:u.product||'',line:u.line||'',nFsd:0,nDs:0,fsdSO:0,directSO:0,dsSO:0,fsdInv:null,inv1:null,dsInv:null};
    return e; };
  const getD=function(country,line,account){ const k=country+'||'+line+'||'+account; let e=gd[k];
    if(!e)e=gd[k]={country:country,line:line,account:account,type:null,mirror:false,nFsd:0,fsdSO:0,fsdInv:null,inv1:null,dsSO:0,dsInv:null,children:[]};
    return e; };
  const treeOf=function(c,line){ return tree[c+'||'+(line||'')]||tree[c]||{}; };   // 产业键优先,兼容旧的国家键
  /* 同一家(2026-09-02 用户:Amazon 这类直达渠道有时在间接零售伙伴表里也出现):下游行连到直达型直接渠道 = 同一家的镜像,不是下游伙伴 →
     它的 SO 计入 FSD 侧与下游对;库存按同一家核对(FSD Inventory vs 镜像行库存),INV1 不再加一次 */
  const typeAt=function(c,line,acct){ if(!types)return 'dist'; return types[c+'||'+(line||'')+'||'+acct]||types[c+'||'+acct]||'dist'; };
  const mirrors={};
  if(tree)Object.keys(tree).forEach(function(k){ const ix=k.indexOf('||'); const c=ix<0?k:k.slice(0,ix), ln=ix<0?'':k.slice(ix+2); const tr=tree[k]||{};
    Object.keys(tr).forEach(function(d){ const par=tr[d]; if(par&&par!=='*'&&typeAt(c,ln,par)!=='dist')mirrors[c+'||'+ln+'||'+par]=1; }); });
  const isMirrorOf=function(c,line,acct){ return !!(mirrors[c+'||'+(line||'')+'||'+acct]||mirrors[c+'||||'+acct]); };
  const soWin=function(u){ let s=0; u.periods.forEach(function(p){ if(!wset[p])return; const w=u.weeks.get(p); if(w.so!=null)s+=w.so; }); return s; };
  store.units.forEach(function(u){ if(skipAudio&&u.audio)return;
    const e=get(u); e.nFsd++;
    const tp=typeOf(u); const so=soWin(u);
    const mir=tp!=='dist'&&tree&&isMirrorOf(u.country||'',u.line||'',u.account);
    if(tp==='dist'||mir)e.fsdSO+=so; else e.directSO+=so;
    const inv=C.latestFieldAt(u,'inv',lastP), inv1=C.latestFieldAt(u,'inv1',lastP);
    if(inv!=null)e.fsdInv=(e.fsdInv||0)+inv;
    if(inv1!=null&&!mir)e.inv1=(e.inv1||0)+inv1;   // 同一家:库存由镜像行代表,INV1 不再加
    if(tree){ const d=getD(u.country||'',u.line||'',u.account); d.nFsd++; d.type=tp; d.mirror=!!mir; d.fsdSO+=so;
      if(inv!=null)d.fsdInv=(d.fsdInv||0)+inv; if(inv1!=null)d.inv1=(d.inv1||0)+inv1; }
  });
  retailStore.units.forEach(function(u){ if(skipAudio&&u.audio)return;
    const e=get(u); e.nDs++;
    const so=soWin(u); e.dsSO+=so;
    const inv=C.latestFieldAt(u,'inv',lastP);
    if(inv!=null)e.dsInv=(e.dsInv||0)+inv;
    if(tree){ const c=u.country||''; const tr=treeOf(c,u.line); const par=tr[u.account]!=null?tr[u.account]:null;
      const acct=par==null?'(未连线)':(par==='*'?'(国家FSD合计)':par);
      const d=getD(c,u.line||'',acct); if(par==null)d.type='unwired'; else if(par==='*')d.type='country';
      if(d.children.indexOf(u.account)<0)d.children.push(u.account);
      d.dsSO+=so; if(inv!=null)d.dsInv=(d.dsInv||0)+inv; }
  });
  const counts={OK:0,'注意':0,'异常':0,'缺下游':0,'缺FSD':0,'直达':0};
  const sum={fsdSO:0,dsSO:0,fsdInv:0,inv1:0,dsInv:0,nBoth:0};
  const rank={'异常':0,'注意':1,'缺下游':2,'缺FSD':3,'直达':4,OK:5};
  Object.keys(g).forEach(function(k){
    const e=g[k];
    e.fsdSOAll=e.fsdSO+e.directSO;
    e.dSO=e.dsSO-e.fsdSO;
    e.pSO=(e.nFsd&&e.nDs)?+((e.dSO)/Math.max(1,Math.abs(e.fsdSO))).toFixed(3):null;
    const both=(e.inv1!=null||e.dsInv!=null)?((e.inv1||0)+(e.dsInv||0)):null;
    e.invSum=both;
    e.dInv=(e.fsdInv!=null&&both!=null)?both-e.fsdInv:null;
    e.pInv=(e.nFsd&&e.nDs&&e.fsdInv!=null&&both!=null)?+((e.dInv)/Math.max(1,Math.abs(e.fsdInv))).toFixed(3):null;
    if(e.nFsd&&!e.nDs)e.status=(e.fsdSO===0&&e.directSO>0)?'直达':'缺下游';
    else if(!e.nFsd&&e.nDs)e.status='缺FSD';
    else { const worst=Math.max(Math.abs(e.pSO||0),Math.abs(e.pInv||0)); e.status=worst<=0.05?'OK':(worst<=0.15?'注意':'异常');
      sum.fsdSO+=e.fsdSO; sum.dsSO+=e.dsSO; sum.fsdInv+=(e.fsdInv||0); sum.inv1+=(e.inv1||0); sum.dsInv+=(e.dsInv||0); sum.nBoth++; }
    counts[e.status]++;
    out.rows.push(e);
  });
  out.rows.sort(function(a,b){ return (rank[a.status]-rank[b.status])||(Math.abs(b.dSO)-Math.abs(a.dSO))||(a.country<b.country?-1:1); });
  sum.counts=counts;
  sum.pSO=sum.nBoth?+((sum.dsSO-sum.fsdSO)/Math.max(1,Math.abs(sum.fsdSO))).toFixed(3):null;
  sum.pInv=sum.nBoth?+(((sum.inv1+sum.dsInv)-sum.fsdInv)/Math.max(1,Math.abs(sum.fsdInv))).toFixed(3):null;
  out.sum=sum;
  /* 按直接渠道细分(需连线):带下游型直接渠道 vs 它名下下游的 Σ;直达消费者型不判;未连线/国家合计单列 */
  if(tree){
    const rankD={'异常':0,'注意':1,'未连线':2,'无下游':3,'国家合计':4,'直达':5,OK:6};
    Object.keys(gd).forEach(function(k){
      const d=gd[k];
      d.nDs=d.children.length;
      d.dSO=d.dsSO-d.fsdSO;
      const both=d.mirror?(d.dsInv!=null?d.dsInv:null):((d.inv1!=null||d.dsInv!=null)?((d.inv1||0)+(d.dsInv||0)):null);   // 同一家:库存按同一家核对,不加 INV1
      d.invSum=both; d.dInv=(d.fsdInv!=null&&both!=null)?both-d.fsdInv:null;
      d.pSO=null; d.pInv=null;
      if(d.type==='unwired')d.status='未连线';
      else if(d.type==='country')d.status='国家合计';
      else if(d.type!=='dist'&&!d.mirror)d.status='直达';
      else if(!d.nDs)d.status='无下游';
      else { d.pSO=+((d.dSO)/Math.max(1,Math.abs(d.fsdSO))).toFixed(3);
        d.pInv=(d.fsdInv!=null&&both!=null)?+((d.dInv)/Math.max(1,Math.abs(d.fsdInv))).toFixed(3):null;
        const worst=Math.max(Math.abs(d.pSO||0),Math.abs(d.pInv||0)); d.status=worst<=0.05?'OK':(worst<=0.15?'注意':'异常'); }
      out.byDirect.push(d);
    });
    out.byDirect.sort(function(a,b){ return (rankD[a.status]-rankD[b.status])||(Math.abs(b.dSO)-Math.abs(a.dSO))||(a.country<b.country?-1:(a.country>b.country?1:(a.line<b.line?-1:(a.line>b.line?1:(a.account<b.account?-1:1))))); });
  }
  return out;
};

/* ---------- 补货规律显性回测:每 渠道×产品 的历史 SI 节奏 ----------
   事件=显著 SI(≥2×近4周均销);记录触发前 DOS/触发前库存/补后 DOS。
   模式判定:none=从无显著SI / oneshot=上市铺货后≥oneShotWeeks 周再无SI且期间仍有动销(非流水生意,需警惕)
   / flow=流水补货。中位数与 learnReplenish 同口径。 */
C.replenishStats=function(u,cfg){
  const win=(cfg&&cfg.dosWindow)||4;
  const oneShotWeeks=(cfg&&cfg.tailWeeks)||12;
  const q=[]; let prevDos=null,prevInv=null;
  const events=[];
  u.periods.forEach(function(p){
    const wk=u.weeks.get(p);
    const so=wk.so;
    const soValid=u.audio?(so!=null&&so>0):(so!=null);
    if(soValid){ q.push(so); while(q.length>win)q.shift(); }
    let s=0; q.forEach(function(v){s+=v;});
    const daily=q.length?s/q.length/7:0;
    const dos=(wk.inv!=null&&daily>0)?wk.inv/daily:null;
    const avgW=q.length?s/q.length:0;
    if(wk.si!=null&&wk.si>0&&avgW>0&&wk.si>=avgW*2){
      events.push({p:p,si:wk.si,prevDos:prevDos!=null?Math.round(prevDos):null,
        prevInv:prevInv,afterDos:dos!=null?Math.round(dos):null,
        afterInv:wk.inv!=null?Math.round(wk.inv):null});
    }
    if(dos!=null)prevDos=dos;
    if(wk.inv!=null)prevInv=wk.inv;
  });
  const med=function(a){ if(!a.length)return null;
    const b=a.slice().sort(function(x,y){return x-y;}); return Math.round(b[Math.floor(b.length/2)]); };
  const pick=function(f){ const a=[]; events.forEach(function(e){ if(f(e)!=null)a.push(f(e)); }); return a; };
  const lastSI=events.length?events[events.length-1].p:null;
  /* 一次性铺货:最后一次显著 SI 之后 ≥oneShotWeeks 个周期,且其后仍有有效动销记录 */
  let mode='none';
  if(events.length){
    mode='flow';
    if(lastSI!=null){
      const after=u.periods.filter(function(p){ return p>lastSI; });
      let soAfter=0;
      after.forEach(function(p){ const so=u.weeks.get(p).so;
        if(u.audio?(so!=null&&so>0):(so!=null&&so>0))soAfter++; });
      if(after.length>=oneShotWeeks&&soAfter>0&&events.length<=2)mode='oneshot';
    }
  }
  return {n:events.length,events:events,
    trigger:med(pick(function(e){return e.prevDos;})),
    target:med(pick(function(e){return e.afterDos;})),
    trigInv:med(pick(function(e){return e.prevInv;})),
    lastSI:lastSI,mode:mode};
};

/* ---------- 渠道补货策略判型(2026-09-01 用户拍板:每个渠道的补货节奏规律不同,必须先学历史再模拟,禁止全渠道一刀切) ----------
   事件=显著SI(≥2×近4周均销,与 replenishStats 同口径),样本≥3 才学;
   判型看哪个信号更集中(稳健离散度=四分位距÷中位):
   - 水位型 inv:历史每次都在某个绝对库存台数附近进货(如"库存到500台就SI一批")→触发=进货前库存中位,补到=进货后库存中位
   - 门槛型 dos:历史每次都在某个 DOS 附近进货(如"DOS低于90天就要补,否则SO下滑")→沿用 learnReplenish 中位(触发/目标DOS)
   水位判定从严(库存离散度≤0.6×DOS离散度 且 ≤0.5):证据不足回落 DOS 型,学不到返回 null(上层再回落产品线默认)。 */
C.replenishPolicyOf=function(u,cfg,rs0){
  const rs=rs0||C.replenishStats(u,cfg);
  const evs=(rs.events||[]).filter(function(e){ return e.prevDos!=null&&e.prevInv!=null; });
  if(evs.length<3)return null;
  const med=function(a){ const b=a.slice().sort(function(x,y){return x-y;}); return b[Math.floor(b.length/2)]; };
  const rq=function(a){ const b=a.slice().sort(function(x,y){return x-y;});
    const m=b[Math.floor(b.length/2)]; if(m<=0)return 99;
    const q1=b[Math.floor(b.length*0.25)],q3=b[Math.floor(b.length*0.75)];
    return (q3-q1)/m; };
  const dosArr=evs.map(function(e){return e.prevDos;}),invArr=evs.map(function(e){return e.prevInv;});
  const cvD=rq(dosArr),cvI=rq(invArr);
  if(cvI<cvD*0.6&&cvI<=0.5){
    const tin=Math.round(med(invArr));
    const aft=evs.map(function(e){return e.afterInv;}).filter(function(x){return x!=null;});
    const tgt=aft.length?Math.round(med(aft)):null;
    if(tgt!=null&&tgt>tin&&tin>=0){
      const aftD=evs.map(function(e){return e.afterDos;}).filter(function(x){return x!=null;});
      return {type:'inv',triggerInv:tin,targetInv:tgt,n:evs.length,src:'unit',
        targetDos:aftD.length?Math.round(med(aftD)):null,
        cvI:+cvI.toFixed(2),cvD:+cvD.toFixed(2)};
    }
  }
  const lr=C.learnReplenish(u,cfg);
  return lr?{type:'dos',trigger:lr.trigger,target:lr.target,n:lr.n,src:'unit',
    cvI:+cvI.toFixed(2),cvD:+cvD.toFixed(2)}:null;
};

/* ---------- 推演合理性哨兵：相邻月数量级校验 ----------
   把推演按连续4周分块,首块对比最近4个有数周实际,后续块环比;
   块比 > 3×系数比(或 < 1/(3×系数比)) 判异常。返回警示列表(不改数,只提醒)。 */
C.sanityCheck=function(o){
  const fc=o.forecast||[];
  if(!fc.length||fc.some(function(f){return f.so==null;}))return [];
  const kOf=function(w){ const kd=o.kdef&&o.kdef[w]!=null?o.kdef[w]:1; const ke=o.kedit&&o.kedit[w]; return ke==null?kd:ke; };
  const blocks=[];
  for(let i=0;i<fc.length;i+=4){
    const part=fc.slice(i,i+4);
    let so=0,k=0;
    part.forEach(function(f){ so+=f.so; k+=kOf(C.periodW(f.p)); });
    blocks.push({from:part[0].p,to:part[part.length-1].p,so:so,k:k/part.length,n:part.length});
  }
  const warns=[];
  let baseSo=0,baseK=0,baseN=0;
  (o.cur.windowWeeks||[]).forEach(function(p){ baseSo+=o.unit.weeks.get(p).so; baseK+=kOf(C.periodW(p)); baseN++; });
  let prev={so:baseSo*( baseN?4/baseN:1),k:baseN?baseK/baseN:1,label:'近4周实际',n:4};
  const LIM=3;
  blocks.forEach(function(b){
    if(prev.so>0&&b.n>=2){
      const ratio=(b.so/b.n)/((prev.so/prev.n)||1);
      const kRatio=Math.max(0.2,(b.k||1)/(prev.k||1));
      const lim=LIM*Math.max(1,kRatio);
      if(ratio>lim)warns.push({from:b.from,to:b.to,type:'high',ratio:+ratio.toFixed(1),lim:+lim.toFixed(1),
        blockSo:b.so,prevSo:Math.round(prev.so),prevLabel:prev.label});
      else if(ratio<1/lim&&prev.so>=20)warns.push({from:b.from,to:b.to,type:'low',ratio:+ratio.toFixed(2),lim:+(1/lim).toFixed(2),
        blockSo:b.so,prevSo:Math.round(prev.so),prevLabel:prev.label});
    }
    prev={so:b.so,k:b.k,label:C.weekLabel(b.from)+'-'+C.weekLabel(b.to)+'块',n:b.n};
  });
  return warns;
};

/* ---------- 免推演阈值：SKU 覆盖 > 产品线默认 > 全局默认;null=无阈值 ---------- */
C.exemptThreshold=function(exempt,line,model){
  if(!exempt)return null;
  const num=function(v){ return (v==null||v==='')?null:(isFinite(+v)?+v:null); };
  let v=exempt.model?num(exempt.model[model]):null; if(v!=null)return v;
  v=exempt.line?num(exempt.line[line]):null; if(v!=null)return v;
  return num(exempt.global);
};

