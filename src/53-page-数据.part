        const kR=ovExtKeyOf(r0[6],pv2UKey(r0[4],r0[5],(r0[17]!=null&&r0[17]!=='')?r0[17]:null));
        const ymR=r0[7]+'-'+r0[9];
        const saved=JSON.parse(JSON.stringify(state.ovExt||{}));
        /* 拍一个非步长倍数的值,逼出最刁钻的承接比例 */
        (state.ovExt[kR]=state.ovExt[kR]||{})[ymR]={so:Math.max(step,Math.round((+r0[10]||0)*1.37))};
        ovExtGen++;
        const rowsR=budgetRowsOv(endYR);
        const carryRows=rowsR.filter(function(r){ return String(r[16]||'').indexOf('承接拍数比例')>=0; });
        const badR=carryRows.filter(function(r){ return ((+r[10]||0)%step)!==0||((+r[11]||0)%step)!==0; });
        roundStepOk=carryRows.length>0&&badR.length===0;
        tms.roundStep={carryRows:carryRows.length,bad:badR.length,step:step,
          sample:carryRows.slice(0,3).map(function(r){ return r[7]+'-'+r[9]+':so'+r[10]+'/si'+r[11]; }),
          badSample:badR.slice(0,3).map(function(r){ return r[7]+'-'+r[9]+':so'+r[10]+'/si'+r[11]; })};
        state.ovExt=saved; ovExtGen++;
        (function(){ const c=calcCache(); delete c.budTo; delete c.budOv; delete c.pvExt; })();
      }
    }catch(e){ tms.roundStep='ERR:'+String(e&&e.message||e).slice(0,160); }
    tms.msRoundStep=Math.round(performance.now()-__tR0); sfStep('roundStep done '+tms.msRoundStep+'ms');
    /* 汇总层级模拟面板冒烟:开面板→拍月度SO=12345→断言守恒回显(FSD 源无库存约束,必须精确) */
    sfStep('smSimOk begin');
    let smSimOk=false;
    try{
      sfStep('smSim render');
      state.ui.tab='summary'; state.ui.smView='tree'; state.ui.smSrc='fsd';
      delete state.ui.smSim; render();
      sfStep('smSim rendered');
      const btn=document.querySelector('.smSimBtn');
      if(btn){
        btn.click();
        sfStep('smSim panel opened');
        const td=document.querySelector('td[data-smm][data-smk="so"]');
        if(td){
          const m=td.dataset.smm;
          td.dataset.orig=td.textContent;
          td.textContent='12345';
          td.dispatchEvent(new Event('blur'));
          sfStep('smSim blur done');
          const td2=document.querySelector('td[data-smm="'+m+'"][data-smk="so"]');
          smSimOk=!!(td2&&F.parseCellNum(td2.textContent)===12345);
          tms.smSim={month:m,after:td2?td2.textContent:null,ovKeys:Object.keys(state.ovSO).length};
          /* 冒烟数据回滚:恢复该月公式,不污染持久化探针写盘的方案 */
          const rb=document.querySelector('button[data-smrestore="'+m+'"]');
          const oldConfirm=window.confirm; window.confirm=function(){return true;};
          try{ if(rb)rb.click(); } finally { window.confirm=oldConfirm; }
          sfStep('smSim restored');
          delete state.ui.smSim; render();
        } else tms.smSim={noCell:true};
      } else tms.smSim={noBtn:true};
    }catch(e){ tms.smSim='ERR:'+String(e&&e.message||e).slice(0,120); }
    sfStep('smSim done');
    /* 汇总层级监控冒烟:加一个监控节点→渲染监控页→断言模块三分列行存在→清理 */
    sfStep('sumWatchOk begin');
    let sumWatchOk=false;
    try{
      const wb=document.querySelector('.smWatchBtn');
      if(wb){
        wb.click();
        state.ui.tab='watch'; render();
        sumWatchOk=!!document.querySelector('button[data-sunwatch]');
        tms.sumWatch={rendered:sumWatchOk,n:Object.keys(state.watch.sum).length};
        Object.keys(state.watch.sum).forEach(function(k){
          delete state.watch.sum[k]; delete state.watchBase['sum|'+k]; });
        state.ui.tab='summary'; render();
      } else tms.sumWatch={noBtn:true};
    }catch(e){ tms.sumWatch='ERR:'+String(e&&e.message||e).slice(0,120); }
    /* 导出预览冒烟:开窗→隐一列→断言列数变化→取消。绝不点「导出」——保存对话框会挂死无人值守自测 */
    sfStep('expPrevOk begin');
    let expPrevOk=false;
    try{
      exportTable('自测导出',['甲','乙','丙'],[[1,2,3],[4,5,6]]);
      const eov=document.getElementById('expOv');
      const ths0=eov?eov.querySelectorAll('thead th').length:0;
      const hb=eov?eov.querySelector('button[data-exphide]'):null;
      if(hb)hb.click();
      const ths1=eov?eov.querySelectorAll('thead th').length:0;
      expPrevOk=(ths0===4&&ths1===3);
      tms.expPrev={before:ths0,after:ths1};
      const cl=document.getElementById('expClose'); if(cl)cl.click();
      delete state.expTpl['自测导出'];
    }catch(e){ tms.expPrev='ERR:'+String(e&&e.message||e).slice(0,120); }
    /* 补货规律回测冒烟:切系数页→运行→断言结果区渲染 */
    sfStep('btOk begin');
    let btOk=false;
    try{
      state.ui.tab='coef'; render();
      const rb=document.getElementById('btnRunBT');
      if(rb){ rb.click();
        const host=document.getElementById('btHost');
        btOk=!!(host&&(host.querySelector('tbody tr')||/回测完成/.test(host.textContent||'')));
        tms.bt={rows:host?host.querySelectorAll('tbody tr').length:0};
      } else tms.bt={noBtn:true};
    }catch(e){ tms.bt='ERR:'+String(e&&e.message||e).slice(0,120); }
    /* 产品总控冒烟:渲染→点行展开→断言 SI/SO 可拍网格 + 月末DOS 行 + 国家块齐备 */
    sfStep('mkOk begin');
    let mkOk=false;
    try{
      state.ui.tab='master'; state.ui.mkOpen={}; render();
      const tr=document.querySelector('#view-master tr[data-mk]');
      if(tr){
        tr.click();
        const grid=document.querySelector('#view-master td[data-mkm][data-mkk="so"]');
        const gridSi=document.querySelector('#view-master td[data-mkm][data-mkk="si"]');
        const ctry=document.querySelector('#view-master .mkCtry');
        let hasDos=false;
        document.querySelectorAll('#view-master td').forEach(function(td){ if(td.textContent.trim()==='月末DOS')hasDos=true; });
        const hasNx=!!document.querySelector('#view-master td[data-mky]');
        mkOk=!!(grid&&gridSi&&ctry&&hasDos&&hasNx);
        tms.master={rows:document.querySelectorAll('#view-master tr[data-mk]').length,
          grid:!!grid,gridSi:!!gridSi,ctry:!!ctry,dosRow:hasDos,nextYear:hasNx};
        state.ui.mkOpen={};
      } else tms.master={noRow:true};
    }catch(e){ tms.master='ERR:'+String(e&&e.message||e).slice(0,120); }
    /* 锁量冒烟:取未来SI最大的非音频型号,锁到(已发+未来SI×40%) → 断言压缩后 ΣfutSI≤余量、系数<1、引擎记录生效;随后回滚 */
    sfStep('lockOk begin');
    let lockOk=false;
    try{
      const cand={};
      D.list.forEach(function(it){ if(it.u.audio||it.exempt)return;
        let s=0; (it.sim.rows||[]).forEach(function(r){ s+=(r.si||0); });
        const mk2=mkKey(it.u); cand[mk2]=(cand[mk2]||0)+s; });
      let bestMk=null,bestSi=0;
      Object.keys(cand).forEach(function(mk2){ if(cand[mk2]>bestSi){ bestSi=cand[mk2]; bestMk=mk2; } });
      if(bestMk&&bestSi>10){
        const snt=lockSentOf(bestMk);
        const total=Math.round(snt.sent+bestSi*0.4);
        state.lockQty[bestMk]={on:true,total:total,byC:{}};
        computeAll();
        const R=__lockRes&&__lockRes[bestMk];
        let futSI=0,scaledN=0;
        D.list.forEach(function(it){ if(it.u.audio||mkKey(it.u)!==bestMk)return;
          (it.sim.rows||[]).forEach(function(r){ futSI+=(r.si||0); });
          if(it.lockScaled!=null&&it.lockScaled<1)scaledN++; });
        const remain=Math.max(0,total-snt.sent);
        lockOk=!!(R&&R.scaled&&futSI<=remain&&scaledN>0);
        tms.lock={mk:bestMk,futSI0:bestSi,total:total,remain:remain,futSI1:futSI,
          scaledN:scaledN,gap:R&&R.gap!=null?F.weekLabel(R.gap):null};
        /* 贯通(2026-09-02):下游同型号今年自动Purchase ≤ 余量;明年延伸段 FSD+音频 ≤ 余量−今年已排、下游 ≤ 余量−下游今年已排 */
        let rFut=0,rN=0; if(Dr)Dr.list.forEach(function(it){ if(mkKey(it.u)!==bestMk)return; rN++; (it.sim.rows||[]).forEach(function(r){ rFut+=(r.buy||0); }); });
        const cyL=F.periodY(store.maxPeriod);
        const rowsL=budgetRowsOv(cyL+1);
        const ixL=bestMk.indexOf('||'); const prodL=bestMk.slice(0,ixL),modelL=bestMk.slice(ixL+2);
        let curFA=0,extFA=0,curR=0,extR=0,extRowsN=0;
        rowsL.forEach(function(r){ if(r[1]!==prodL||String(r[17])!==modelL||r[6]===F.DICT.SRC_NP)return;
          const isR=r[6]===F.DICT.SRC_RETAIL; const v=+r[11]||0;
          if(+r[7]<=cyL){ if(isR)curR+=v; else curFA+=v; } else { extRowsN++; if(isR)extR+=v; else extFA+=v; } });
        const thruOk=(rN===0||rFut<=remain+0.5)&&(curFA+extFA<=remain+0.5)&&(rN===0||curR+extR<=remain+0.5)&&extRowsN>0;
        lockOk=lockOk&&thruOk;
        tms.lock.thru={ok:thruOk,retailN:rN,retailFut:rFut,curFA:curFA,extFA:extFA,curR:curR,extR:extR,extRowsN:extRowsN,extF:R.extF,extRetailF:R.extRetailF};
        /* 下游锁量单测(2026-09-02):锁下游单元自己的型号(可不在 FSD 里)到 未来Purchase×40% → 压缩后 ΣPurchase ≤ 余量、系数<1 */
        let rLockOk=true;
        if(Dr&&Dr.list.length){
          const itR=Dr.list.filter(function(it){ let s=0; (it.sim.rows||[]).forEach(function(r){ s+=(r.buy||0); }); return s>10; })[0];
          if(itR){
            const mkD=mkKey(itR.u); let fut0=0; (itR.sim.rows||[]).forEach(function(r){ fut0+=(r.buy||0); });
            const inv1D=inv1OfMk(mkD).sum;   // 下游预算 = 直接渠道自有库存INV1 + 余量
            if(true){
              const useI=state.cfg.lockRetailInv1===true;
              const sntD=lockSentOf(mkD); const totD=Math.round(sntD.sent+Math.max(0,fut0*0.4-(useI?inv1D:0)));
              state.lockQty[mkD]={on:true,total:totD,byC:{}};
              computeAll();
              const RD=__lockRes&&__lockRes[mkD]; let fut1=0;
              Dr.list.forEach(function(it){ if(mkKey(it.u)!==mkD)return; (it.sim.rows||[]).forEach(function(r){ fut1+=(r.buy||0); }); });
              const budD=F.retailLockBudget({total:totD,remain:Math.max(0,totD-sntD.sent),inv1:inv1D,lifePurchase:retailLifePurchaseOf(mkD).sum,useInv1:useI});
              rLockOk=!!(RD&&RD.retailScaled&&fut1<=budD+0.5);
              tms.lock.retail={mk:mkD,fut0:fut0,inv1:inv1D,total:totD,budget:budD,fut1:fut1,f:RD?RD.retailF:null,ok:rLockOk};
              delete state.lockQty[mkD];
            } else tms.lock.retail={skip:'直接渠道自有库存已够下游全部未来Purchase',inv1:inv1D,fut0:fut0};
          } else tms.lock.retail={skip:'下游无足量单元'};
        }
        lockOk=lockOk&&rLockOk;
        delete state.lockQty[bestMk];
        computeAll();
      } else { lockOk=true; tms.lock={skip:'无足量候选型号'}; }
    }catch(e){ tms.lock='ERR:'+String(e&&e.message||e).slice(0,120); }
    /* 对账冒烟(2026-09-02):FSD ⇄ 下游 对账引擎出行 + 下游页面板渲染 */
    sfStep('reconOk begin');
    let reconOk=false;
    try{
      const rec=F.reconcileFsdRetail(store,retailStore,{weeks:8,skipAudio:false});
      state.ui.tab='retail'; render();
      const panel=document.getElementById('rcRecon');
      reconOk=!!(rec.rows.length&&rec.window.length&&panel);
      tms.recon={rows:rec.rows.length,win:rec.window.length,counts:rec.sum?rec.sum.counts:null,panel:!!panel};
    }catch(e){ tms.recon='ERR:'+String(e&&e.message||e).slice(0,120); }
    /* 渠道架构冒烟(2026-09-02):页面渲染(SVG) + 手动连线落 state + 对账按直接渠道出对应行 */
    sfStep('ctOk begin');
    let ctOk=false;
    try{
      const cs=chanCountries(); state.ui.tab='chantree'; state.ui.ctC=cs[0]; state.ui.ctSel=null; render();
      const svgOk=!!document.querySelector('#view-chantree svg')&&!!document.querySelector('#ctSug');
      let cc=null; cs.forEach(function(x){ if(!cc){ const a=chanArchOf(x); if(a.direct.length&&a.ds.length)cc=x; } });
      let bdRows=0,par=null,autoN=0,dragOk=null,toggleOk=null,lineOk=null;
      if(cc){ const a=chanArchOf(cc); state.chanTree[cc]=state.chanTree[cc]||{}; state.chanTree[cc][a.ds[0].account]=a.direct[0].account; autoN=chanAutoWire(cc);
        const rec=F.reconcileFsdRetail(store,retailStore,{weeks:8,skipAudio:false,types:chanTypesMap(),tree:chanTreeMap()});
        bdRows=rec.byDirect.filter(function(r){ return r.country===cc&&r.account===a.direct[0].account&&r.nDs>=1; }).length;
        par=chanParentOf(cc,a.ds[0].account); ctOk=svgOk&&par===a.direct[0].account&&bdRows===1;
        render(); const wiredLine=!!document.querySelector('#view-chantree g[data-ct-unlink]'); ctOk=ctOk&&wiredLine;
        /* 直签切换冒烟:点节点上的 分销⇄直签 钮 → 类型翻转,再翻回;产业层覆盖冒烟:某产业专属连线优先于默认,删掉后回落默认 */
        try{ const tg=document.querySelector('#view-chantree g[data-ct-toggle]'); const acct=tg?tg.dataset.ctToggle:null; const t0=acct?chanTypeEff(cc,acct):null;
          if(tg){ tg.dispatchEvent(new MouseEvent('click',{bubbles:true})); const t1=chanTypeEff(cc,acct); toggleOk=(t0==='dist')?(t1!=='dist'):(t1==='dist'); delete state.chanType[cc+'||'+acct]; }
          const lns=chanLinesOf(cc); const ds0=a.ds[0].account;
          if(lns.length){ chanSetParent(cc,lns[0],ds0,'*'); const pL=chanParentOf(cc,ds0,lns[0]); const pD=chanParentOf(cc,ds0,''); chanSetParent(cc,lns[0],ds0,undefined); const pB=chanParentOf(cc,ds0,lns[0]);
            lineOk=(pL==='*'&&pD===a.direct[0].account&&pB===a.direct[0].account); if(state.chanTreeLine[cc])delete state.chanTreeLine[cc][lns[0]]; }
          else lineOk=true;
        }catch(e){ toggleOk=false; lineOk=false; }
        ctOk=ctOk&&toggleOk===true&&lineOk===true;
        /* 拖动连线冒烟:pointerdown 在第一个下游节点 → pointermove/up 到「国家FSD合计」节点 → 连线应改为 '*' */
        try{
          const gDs=document.querySelector('#view-chantree g[data-ct-ds]'); const gDirs=document.querySelectorAll('#view-chantree g[data-ct-dir]');
          const gTo=gDirs[gDirs.length-1];
          if(gDs&&gTo){ gTo.scrollIntoView({block:'center'});
            const r1=gDs.getBoundingClientRect(), r2=gTo.getBoundingClientRect();
            const mkEv=function(type,x,y){ return new PointerEvent(type,{clientX:x,clientY:y,bubbles:true,cancelable:true,pointerId:1,button:0,isPrimary:true}); };
            gDs.dispatchEvent(mkEv('pointerdown',r1.left+r1.width/2,r1.top+r1.height/2));
            const svgEl=document.querySelector('#ctSvg');
            svgEl.dispatchEvent(mkEv('pointermove',r2.left+r2.width/2,r2.top+r2.height/2));
            svgEl.dispatchEvent(mkEv('pointerup',r2.left+r2.width/2,r2.top+r2.height/2));
            dragOk=chanParentOf(cc,a.ds[0].account)==='*'; }
        }catch(e){ dragOk='ERR:'+String(e&&e.message||e).slice(0,80); }
        ctOk=ctOk&&dragOk===true;
        delete state.chanTree[cc]; }
      else ctOk=svgOk;
      tms.ct={svg:svgOk,country:cc,parent:par,autoN:autoN,bdRows:bdRows,drag:dragOk,toggle:toggleOk,line:lineOk};
    }catch(e){ tms.ct='ERR:'+String(e&&e.message||e).slice(0,120); }
    /* 推演编辑 Excel 等价冒烟(2026-09-02):框选两格 → 无焦点 Ctrl+V 单值填满 → Delete 清拍数(恢复公式) → 选区仍在 */
    sfStep('xgPvOk begin');
    let xgPvOk=false;
    try{
      state.ui.tab='pv'; state.ui.pvSrc='fsd'; state.ui.pv2Gran='month'; render();
      const sos=Array.prototype.slice.call(document.querySelectorAll('#view-pv td[data-pv2k="so"][contenteditable]'));
      const c1=sos[0], c2=sos.filter(function(td){ return td.parentElement===c1.parentElement&&td!==c1; })[0];
      if(c1&&c2){
        const mk2=function(type,el2){ const r=el2.getBoundingClientRect(); const ev=new MouseEvent(type,{clientX:r.left+r.width/2,clientY:r.top+r.height/2,bubbles:true,cancelable:true,button:0}); return ev; };
        c1.dispatchEvent(mk2('mousedown',c1)); c2.dispatchEvent(mk2('mousemove',c2)); document.dispatchEvent(mk2('mouseup',c2));
        const nSel=document.querySelectorAll('#view-pv td.xsel').length;
        /* 无焦点粘贴单值 → 两格都拍成 777 */
        if(document.activeElement&&document.activeElement.blur)document.activeElement.blur();
        const dt={getData:function(){ return '777'; }};
        const pe=new Event('paste',{bubbles:true,cancelable:true}); pe.clipboardData=dt;
        document.body.dispatchEvent(pe);
        const vals=Array.prototype.slice.call(document.querySelectorAll('#view-pv td.xsel[data-pv2k="so"]')).map(function(td){ return F.parseCellNum(td.textContent); });
        const pasted=vals.length>=2&&vals.every(function(v){ return v===777; });
        const ovBefore=Object.keys(state.ovSO).length;
        /* Delete → 清掉这两格的手工拍数(选区仍在) */
        document.dispatchEvent(new KeyboardEvent('keydown',{key:'Delete',bubbles:true,cancelable:true}));
        const ovAfter=Object.keys(state.ovSO).length;
        const still=document.querySelectorAll('#view-pv td.xsel').length;
        xgPvOk=nSel>=2&&pasted&&ovBefore>0&&ovAfter<ovBefore&&still>=2;
        tms.xgPv={nSel:nSel,pasted:pasted,vals:vals.slice(0,3),ovBefore:ovBefore,ovAfter:ovAfter,still:still};
        window.__xgClear();
      } else tms.xgPv={skip:'no two so cells in a row'};
    }catch(e){ tms.xgPv='ERR:'+String(e&&e.message||e).slice(0,140); }
    sfStep('xgPv body done');
    /* 诊断(2026-09-02 用户:未来某月 SO 拍 0 会被改回推演值):产品层 未来月桶 拍 0 → 回显;明年外推桶同样 */
    try{
      state.ui.tab='pv'; state.ui.pvSrc='fsd'; state.ui.pv2View='product'; state.ui.pv2Gran='month'; state.ui.pv2Open={};
      const cy0=F.periodY(store.maxPeriod); state.ui.pv2Yrs={}; state.ui.pv2Yrs[cy0]=1; state.ui.pv2Yrs[cy0+1]=1; render();
      sfStep('zeroTap rendered');
      const eb=$('#pv2Exp'); if(eb&&eb.onclick)eb.onclick();
      sfStep('zeroTap expanded');
      const curM=F.monthOfP(store.maxPeriod);
      const pick=function(pred){ let out=null; document.querySelectorAll('#view-pv td[data-pv2k="so"][contenteditable]').forEach(function(td){ if(!out&&pred(td))out=td; }); return out; };
      const tdF=pick(function(td){ const m=/^M(\d+)-(\d+)$/.exec(td.dataset.pv2b||''); return !!(m&&+m[1]===cy0&&+m[2]>curM+1&&F.parseCellNum(td.textContent)>0); });
      const tdE=pick(function(td){ const m=/^M(\d+)-(\d+)$/.exec(td.dataset.pv2b||''); return !!(m&&+m[1]===cy0+1&&F.parseCellNum(td.textContent)>0); });
      const tap0=function(td){ if(!td)return null; const sel={n:td.dataset.pv2n,b:td.dataset.pv2b}; const before=F.parseCellNum(td.textContent);
        td.dataset.orig=td.textContent; td.textContent='0'; td.dispatchEvent(new Event('blur'));
        let after=null; document.querySelectorAll('#view-pv td[data-pv2k="so"]').forEach(function(t2){ if(after==null&&t2.dataset.pv2n===sel.n&&t2.dataset.pv2b===sel.b)after=F.parseCellNum(t2.textContent); });
        return {bucket:sel.b,node:String(sel.n).slice(-30),before:before,after:after}; };
      sfStep('zeroTap picked');
      const zc=tap0(tdF); sfStep('zeroTap cur done');
      const ze=tap0(tdE); sfStep('zeroTap ext done');
      tms.zeroTap={cur:zc,ext:ze};
      Object.keys(state.ovSO).forEach(function(k){ delete state.ovSO[k]; }); state.ovExt={}; ovExtGen++; recompute();
    }catch(e){ tms.zeroTap='ERR:'+String(e&&e.message||e).slice(0,140); }
    sfStep('zeroTap done');
    /* 诊断(2026-09-02 用户:推演编辑未来格 SO/Purchase 完全编辑不了):真实点击序列 mousedown→mouseup 后是否获得焦点、是否 contenteditable、键入后 blur 是否落值 */
    try{
      const probe=function(srcX,gran){
        state.ui.tab='pv'; state.ui.pvSrc=srcX; state.ui.pv2View='country'; state.ui.pv2Gran=gran; state.ui.pv2Open={}; render();
        const eb=$('#pv2Exp'); if(eb&&eb.onclick)eb.onclick();
        window.__xgClear();
        const all=Array.prototype.slice.call(document.querySelectorAll('#view-pv td[data-pv2k="so"],#view-pv td[data-pv2m="so"]'));
        const ed=all.filter(function(td){ return td.hasAttribute('contenteditable'); });
        const td=ed[Math.min(2,ed.length-1)]; if(!td)return {src:srcX,gran:gran,cells:all.length,editable:ed.length,err:'no editable cell'};
        const r=td.getBoundingClientRect(); const mk=function(type){ return new MouseEvent(type,{clientX:r.left+r.width/2,clientY:r.top+r.height/2,bubbles:true,cancelable:true,button:0}); };
        td.dispatchEvent(mk('mousedown')); document.dispatchEvent(mk('mouseup'));
        const focused=document.activeElement===td;
        const before=F.parseCellNum(td.textContent);
        /* 模拟键入:直接改文本 + 合成 blur(与真实提交同路径) */
        td.textContent='4444'; td.dispatchEvent(new Event('blur'));
        let after=null; document.querySelectorAll('#view-pv td[data-pv2k="so"]').forEach(function(t2){ if(after==null&&t2.dataset.pv2n===td.dataset.pv2n&&t2.dataset.pv2b===td.dataset.pv2b)after=F.parseCellNum(t2.textContent); });
        Object.keys(state.ovSO).forEach(function(k){ delete state.ovSO[k]; }); state.ovExt={}; ovExtGen++; recompute();
        return {src:srcX,gran:gran,cells:all.length,editable:ed.length,bucket:td.dataset.pv2b,focused:focused,isCE:td.isContentEditable,before:before,after:after};
      };
      const epA=probe('fsd','month'); sfStep('editProbe fsdM done');
      const epB=probe('fsd','week'); sfStep('editProbe fsdW done');
      const epC=probe('retail','month'); sfStep('editProbe retM done');
      tms.editProbe={fsdM:epA,fsdW:epB,retM:epC};
    }catch(e){ tms.editProbe='ERR:'+String(e&&e.message||e).slice(0,160); }
    /* 诊断(2026-09-02 用户:季度视图+自定义层序 导出长表失败):stub saveXlsx 抓异常与行内容。
       2026-09-04:该 bug 早已修复,而这段是整个自检里最重的一块(连开三次 三年跨度×全展开 的长表构建),
       跑到第二次(季度+自定义层序)时渲染进程会被拖垮、整个自检拿不到结果。改为默认跳过,
       需要时用 opts.expLong=1 打开;它只记录 tms,不参与任何断言。真实的季度/自定义层序覆盖由视图基线负责。 */
    if(opts.expLong)try{
      const out={};
      const runExp=async function(tag,gran,view){
        sfStep('  runExp '+tag+' enter');
        state.ui.tab='pv'; state.ui.pvSrc='fsd'; state.ui.pv2Gran=gran; state.ui.pv2View=view;
        if(view==='custom')state.ui.pv2CustomDims=['line','product','country','account','',''];
        /* 只勾到明年:软件本身只外推一年,cy+2 会同时构建两整套预算底表(各数万行),把渲染进程顶爆
           (2026-09-04 冻结门禁在此静默退出;这个诊断要验的是「季度视图+自定义层序导出」,与年份跨度无关) */
        const cy=F.periodY(store.maxPeriod); state.ui.pv2Yrs={}; state.ui.pv2Yrs[cy-1]=1; state.ui.pv2Yrs[cy]=1; state.ui.pv2Yrs[cy+1]=1;
        state.ui.pv2Open={}; render();
        sfStep('  runExp '+tag+' rendered');
        let msg=null,rows=0,bad=0;
        try{ const ctx=window.__pv2ExportCtx; if(!ctx)throw new Error('no export ctx');
          const b=pvLongRows(ctx.items,ctx.src,ctx.yrs,ctx.curY,ctx.fwSet); rows=b.data.length;
          sfStep('  runExp '+tag+' long rows='+rows);
          b.data.forEach(function(r){ r.forEach(function(v){ if(v===undefined||(typeof v==='number'&&!isFinite(v))||(v&&typeof v==='object'))bad++; }); });
          sfStep('  runExp '+tag+' scanned bad='+bad);
        }catch(e){ msg='THROW:'+String(e&&e.message||e).slice(0,200)+' @ '+String(e&&e.stack||'').split('\n')[1]; }
        out[tag]={rows:rows,bad:bad,msg:msg,yrs:Object.keys(state.ui.pv2Yrs)};
        sfStep('  runExp '+tag+' recorded');
      };
      sfStep('expLong begin');
      await runExp('monthCountry','month','country'); sfStep('expLong monthCountry');
      await runExp('quarterCustom','quarter','custom'); sfStep('expLong quarterCustom');
      await runExp('quarterCountry','quarter','country'); sfStep('expLong quarterCountry');
      tms.expLong=out;
    }catch(e){ tms.expLong='ERR:'+String(e&&e.message||e).slice(0,200); }
    /* XGrid 冒烟:选区求和 → Tab 移格 → +10% 相对运算 → 多格拍入 → 选区恢复公式 */
    sfStep('xgOk begin');
    let xgOk=false;
    try{
      state.ui.tab='master'; state.ui.mkOpen={}; render();
      const tr0=document.querySelector('#view-master tr[data-mk]');
      if(tr0){
        tr0.click();
        const soQ='#view-master td[data-mkk="so"]:not([data-mkc])';
        const so=document.querySelectorAll(soQ);
        let sumOk=false,tabOk=false,exprOk=false,applyOk=false,restoreOk=false;
        if(so.length>=3){
          /* ① 框选3格 → 状态条求和 */
          const tbl=so[0].closest('table');
          const p0={r:so[0].parentElement.rowIndex,c:so[0].cellIndex};
          const p2={r:so[2].parentElement.rowIndex,c:so[2].cellIndex};
          window.__xg.markRect(tbl,p0.r,p0.c,p2.r,p2.c);
          let exp=0; for(let i2=0;i2<3;i2++){ const v2=F.parseCellNum(so[i2].textContent); if(v2!=null)exp+=v2; }
          const stEl=document.querySelector('#xgStats b');
          sumOk=!!(stEl&&F.parseCellNum(stEl.textContent)===Math.round(exp));
          window.__xgClear();
          /* ② Tab 从 SI 格提交并右移一格 */
          const si0=document.querySelector('#view-master td[data-mkk="si"]:not([data-mkc])');
          if(si0){
            const m0=si0.dataset.mkm;
            si0.focus();
            si0.dispatchEvent(new KeyboardEvent('keydown',{key:'Tab',bubbles:true,cancelable:true}));
            const ae=document.activeElement;
            tabOk=!!(ae&&ae.dataset&&ae.dataset.mkk==='si'&&ae.dataset.mkm!==m0);
            if(ae&&ae.blur)ae.blur();
          }
          /* ③ +10% 相对运算(blur capture 变换 → 守恒分配落地) */
          const ovBase=JSON.stringify(state.ovSO).length;
          let cell=null,cv=0;
          document.querySelectorAll(soQ).forEach(function(td2){
            if(cell)return; const v2=F.parseCellNum(td2.textContent);
            if(v2!=null&&v2>=20){ cell=td2; cv=v2; } });
          if(cell){
            /* 隐藏窗口不派发真实 focus/blur 事件:按产品同款语义手动记 orig+合成 blur(可见窗口里这两步由 focusin 原生完成) */
            const selC=window.__xg.selOf(cell);
            cell.dataset.orig=cell.textContent;
            cell.textContent='+10%';
            cell.dispatchEvent(new Event('blur'));
            const after=xgQ(selC);
            exprOk=!!(after&&F.parseCellNum(after.textContent)===Math.round(cv*1.1));
            if(!exprOk)tms.xgDbg={cv:cv,afterTxt:after?after.textContent:null,exp:Math.round(cv*1.1),sel:selC.slice(0,120)};
            /* ④ 多格拍入(同型号后两个月 111/222) */
            const all2=document.querySelectorAll(soQ);
            if(all2.length>=3){
              const its=[{sel:window.__xg.selOf(all2[1]),val:'111'},{sel:window.__xg.selOf(all2[2]),val:'222'}];
              window.__xg.apply(its);
              const b1=xgQ(its[0].sel),b2=xgQ(its[1].sel);
              applyOk=!!(b1&&b2&&F.parseCellNum(b1.textContent)===111&&F.parseCellNum(b2.textContent)===222);
            }
            /* ⑤ 选区恢复公式:清掉 ①③④ 写入的手工,ovSO 回到基线 */
            document.querySelectorAll(soQ).forEach(function(td2){ window.__xg.restoreMaster(td2.dataset); });
            recompute();
            restoreOk=JSON.stringify(state.ovSO).length===ovBase;
          }
        }
        xgOk=!!(sumOk&&tabOk&&exprOk&&applyOk&&restoreOk);
        tms.xg={sum:sumOk,tab:tabOk,expr:exprOk,apply:applyOk,restore:restoreOk};
        state.ui.mkOpen={};
      } else tms.xg={noRow:true};
    }catch(e){ tms.xg='ERR:'+String(e&&e.message||e).slice(0,120); }
    /* 推演编辑矩阵冒烟:四行同屏(SI/SO/库存/DOS)→月粒度拍 SO=23456→断言整桶口径回显→恢复 */
    sfStep('pvOk begin');
    let pvOk=false;
    try{
      state.ui.tab='pv'; state.ui.pvSrc='fsd'; state.ui.pv2View='country';
      state.ui.pv2Gran='month'; state.ui.pv2Open={}; state.ui.pv2C=''; state.ui.pv2L=''; state.ui.pv2Q='';
      render();
      const host=$('#view-pv');
      const labs={};
      host.querySelectorAll('td[data-ci="1"]').forEach(function(td){ labs[td.textContent.trim()]=1; });
      const hasDos=!!(labs['DOS']&&labs['\u5e93\u5b58']);   /* 指标列真实渲染出 库存/DOS 行(innerHTML 正则会被 title 文案哄真) */
      let cell=null;
      host.querySelectorAll('td[data-pv2k="so"]').forEach(function(td){
        if(cell)return;
        const v=F.parseCellNum(td.textContent);
        if(v!=null&&v>=10)cell=td;
      });
      if(cell&&hasDos){
        const sel={n:cell.dataset.pv2n,b:cell.dataset.pv2b};
        cell.dataset.orig=cell.textContent;
        cell.textContent='23456';
        const tTap=performance.now();
        cell.dispatchEvent(new Event('blur'));
        const tapMs=Math.round(performance.now()-tTap);
        let after=null;
        document.querySelectorAll('#view-pv td[data-pv2k="so"]').forEach(function(td){
          if(!after&&td.dataset.pv2n===sel.n&&td.dataset.pv2b===sel.b)after=td; });
        const shown=after?F.parseCellNum(after.textContent):null;
        /* 错列回归:Enter 从 SI 格必须落到同一桶的 SO 格(rowspan 首列曾致 cellIndex 错位跳月) */
        let navOk=false;
        const si0=document.querySelector('#view-pv td[data-pv2k="si"]');
        if(si0){
          const b0=si0.dataset.pv2b;
          si0.focus();
          si0.dispatchEvent(new KeyboardEvent('keydown',{key:'Enter',bubbles:true,cancelable:true}));
          const ae=document.activeElement;
          navOk=!!(ae&&ae.dataset&&ae.dataset.pv2k==='so'&&ae.dataset.pv2b===b0);
          if(ae&&ae.blur)ae.blur();
        }
        /* 月+周混合:点月头「+」展开该月为周列,出现「−」收起钮,再点收起 */
        let mxOk=false;
        const mx=host.querySelector('span[data-pv2mx]');
        if(mx){
          mx.click();
          mxOk=!!host.querySelector('span[data-pv2mxc]');
          const mc=host.querySelector('span[data-pv2mxc]');
          if(mc)mc.click(); else state.ui.pv2MExp={};
        }
        const uiOk=!!host.querySelector('#pv2Nimbus')&&host.querySelectorAll('.pv2Chip').length>=2;
        pvOk=shown===23456&&navOk&&mxOk&&uiOk;
        tms.pv2={dos:hasDos,shown:shown,nav:navOk,mx:mxOk,ui:uiOk,node:sel.n.slice(0,40),bucket:sel.b,ovN:Object.keys(state.ovSO).length,tapMs:tapMs};
        /* 回滚:恢复按钮同款清理 */
        const node=window.__pv2NodeIdx&&window.__pv2NodeIdx[sel.n];
        if(node)node.items.forEach(function(it){
          ((it.sim&&it.sim.rows)||[]).forEach(function(r){
            const o=state.ovSO[it.u.key];
            if(o&&o[r.p]!=null){ delete o[r.p]; if(!Object.keys(o).length)delete state.ovSO[it.u.key]; }
          });
        });
        computeAll();
      } else tms.pv2={noCell:!cell,dos:hasDos};
    }catch(e){ tms.pv2='ERR:'+String(e&&e.message||e).slice(0,140); }
    /* 增量重算一致性(2026-09-02 用户:拍数只算被拍产品,但不能影响准确性):产品层拍一格(增量)→ 三源逐单元逐周摘要+锁量结果 vs 紧接着的全量重算 → 必须完全一致,且确有单元被复用 */
    sfStep('incOk begin');
    let incOk=false;
    try{
      const digest=function(){ const out=[]; [D,Dr,Da].forEach(function(Dx,di){ if(!Dx)return; Dx.list.forEach(function(it){
          out.push(di+'|'+it.u.key+'|'+(it.lockScaled!=null?it.lockScaled:'')+'|'+((it.sim&&it.sim.rows)||[]).map(function(r){ return r.p+':'+(r.so||0)+':'+(r.si||0)+':'+(r.buy||0)+':'+(r.inv==null?'':r.inv); }).join(',')); }); });
        out.sort(); return out.join('\n')+'\n'+JSON.stringify(__lockRes||{}); };
      state.ui.tab='pv'; state.ui.pvSrc='fsd'; state.ui.pv2View='country'; state.ui.pv2Gran='month'; state.ui.pv2Open={};
      const cyI=F.periodY(store.maxPeriod); state.ui.pv2Yrs={}; state.ui.pv2Yrs[cyI]=1; state.ui.pv2Yrs[cyI+1]=1; render();
      const ebI=$('#pv2Exp'); if(ebI&&ebI.onclick)ebI.onclick();   // 展开全部 → 产品层可见
      let cellP=null;
      document.querySelectorAll('#view-pv td[data-pv2k="so"]').forEach(function(td){ if(cellP)return; const nd=window.__pv2NodeIdx[td.dataset.pv2n]; if(!nd||nd.depth!==2)return; const v=F.parseCellNum(td.textContent); if(v!=null&&v>=10)cellP=td; });
      if(cellP){
        const ndI=window.__pv2NodeIdx[cellP.dataset.pv2n];
        cellP.dataset.orig=cellP.textContent; cellP.textContent='12345';
        const t1=performance.now(); cellP.dispatchEvent(new Event('blur')); const msInc=Math.round(performance.now()-t1);
        const stI=window.__incStat?Object.assign({},window.__incStat):null;
        const dInc=digest();
        const t2=performance.now(); computeAll({light:true}); const msFull=Math.round(performance.now()-t2);
        const dFull=digest();
        /* 明年列(延伸段)同样要一致:增量后的预算行 vs 全量后的预算行 */
        const t3=performance.now(); const rowsF=JSON.stringify(budgetRowsOv(cyI+1)); const msBudF=Math.round(performance.now()-t3);
        cellP.textContent='12346'; cellP.dataset.orig='12345'; cellP.dispatchEvent(new Event('blur'));
        const t4=performance.now(); const rowsI=JSON.stringify(budgetRowsOv(cyI+1)); const msBudI=Math.round(performance.now()-t4);
        computeAll({light:true}); const rowsI2=JSON.stringify(budgetRowsOv(cyI+1));
        const budSame=rowsI===rowsI2&&rowsF!==rowsI;
        incOk=!!(stI&&stI.scoped&&stI.reused>0&&dInc===dFull&&budSame);
        tms.inc={scoped:stI&&stI.scoped,reused:stI&&stI.reused,computed:stI&&stI.computed,same:dInc===dFull,budSame:budSame,msInc:msInc,msFull:msFull,msBudI:msBudI,msBudF:msBudF,node:ndI?ndI.key.slice(-40):''};
        ndI.items.forEach(function(it){ ((it.sim&&it.sim.rows)||[]).forEach(function(r){ const o=state.ovSO[it.u.key]; if(o&&o[r.p]!=null){ delete o[r.p]; if(!Object.keys(o).length)delete state.ovSO[it.u.key]; } }); });
        computeAll();
      } else tms.inc={skip:'no product-level so cell'};
    }catch(e){ tms.inc='ERR:'+String(e&&e.message||e).slice(0,140); }
    /* 产品经营页(2026-09-02 用户:财经公式照表落到单独看板):页面出行、公式与 CORE 一致、导入附件形制参数写入并回显 */
    sfStep('finOk begin');
    let finOk=false;
    try{
      state.ui.tab='fin'; state.ui.fnView='all'; state.ui.fnNonZero=true; render();
      const nRows=document.querySelectorAll('#view-fin tbody tr').length;
      const cyF=F.periodY(store.maxPeriod);
      const fr=finRowsOf(cyF+1);
      const withSi=fr.filter(function(x){ return x.c.year.siK>0; });
      /* 导入附件形制:第一行的 传播名×国家 写墨西哥参数 → 重算后 Q4 NSIP 与手算一致 */
      const x0=withSi[0];
      let impOk=false,calcOk=false;
      if(x0){
        const hdr1='产品字段\t\t\tSO 量（K）\t\t\t\t\t\tSI 量（K）\t\t\t\t\t\t\tRRP（本币）\t\t\t\t增值税率\t渠长\t\t负向投入比例（分母为SIP）已默认填入上一代产品投入\t\t\t\t\t\t收入额（KUSD）\t\t\t\t\t\t其他成本率\t销毛率';
        const hdr2='BU\t传播名\t国家\t26年年底库存\tSO Q1\tSO Q2\tSO Q3\tSO Q4\tSO全年合计\tSI Q1\tSI Q2\tSI Q3\tSI Q4\tSI全年合计\t年底库存\t年底DOS\tQ1\tQ2\tQ3\tQ4\t增值税率\t渠长(SIP=不含税RRP*（1-渠长）\tQ4\tQ1\tQ2\tQ3\tQ4\tQ4\tQ4\tQ1\tQ2\tQ3\tQ4\t全年\tQ4\t基于NSIP\tQ1\tQ2\tQ3\tQ4\t全年';
        const row=[x0.r.bu,x0.r.name,x0.r.country,'','','1','1','1','=SUM(I3:L3)','','2','1','1','=SUM(N3:Q3)','=V3','=AA3','59999','59999','59999','59999','0.16','0.275','=AF3/(1+$AG3)*(1-$AH3)','0.15','0.15','0.15','0.15','=(18+17)/2*1.03','=AL3*(1-AP3)/AT3','','','','','','1232.472','0.05','','','','',''].join('\t');
        const parsed=F.parseFinParamsText(hdr1+'\n'+hdr2+'\n'+row);
        const r=finApplyImport(parsed,fr);
        const fr2=finRowsOf(cyF+1); const x1=fr2.filter(function(x){ return x.r.name===x0.r.name&&x.r.country===x0.r.country; })[0];
        const c4=x1&&x1.c.q.Q4;
        const sipE=59999/1.16*(1-0.275), nsipE=sipE*0.88/18.025;
        impOk=!!(parsed.rows.length===1&&!parsed.error&&r.matched===1&&c4&&Math.abs(c4.sip-sipE)<1e-6&&Math.abs(c4.nsip-nsipE)<1e-6&&Math.abs(c4.rev-(nsipE*(c4.siK-c4.defer)))<1e-6&&Math.abs(c4.gm-((nsipE*0.95-1232.472)/nsipE))<1e-9);
        /* 递延:DOS>90 时 递延量=季末库存/DOS×(DOS−90) */
        const dq=x1?x1.c.q.Q4.dos:null;
        calcOk=!!(c4&&((dq!=null&&dq!==Infinity&&dq>90)?Math.abs(c4.defer-(c4.invK/dq*(dq-90)))<1e-9:c4.defer===(dq===Infinity?c4.invK:0)));
        delete state.finParams[finKey(x0.r.name,x0.r.country)]; finGen++;
        state.ui.fnView='Q4'; render();
        const edN=document.querySelectorAll('#view-fin td[data-fnn]').length;
        finOk=nRows>0&&withSi.length>0&&impOk&&calcOk&&edN>0;
        tms.fin={rows:nRows,withSi:withSi.length,impOk:impOk,calcOk:calcOk,editable:edN,q4:c4?{sip:+c4.sip.toFixed(3),nsip:+c4.nsip.toFixed(4),si:+c4.siK.toFixed(3),dos:c4.dos===Infinity?'inf':c4.dos,defer:+c4.defer.toFixed(3),rev:c4.rev==null?null:+c4.rev.toFixed(3),gm:c4.gm==null?null:+c4.gm.toFixed(4)}:null};
      } else tms.fin={rows:nRows,skip:'no row with SI'};
      state.ui.fnView='all';
    }catch(e){ tms.fin='ERR:'+String(e&&e.message||e).slice(0,160); }
    /* 拍数审计回归(2026-09-02 多代理审计 12 条确认缺陷):清尾读最新库存并归零、拆分权重用最新现值、覆盖层按源隔离(音频/下游同键不串 FSD)、
       拍值低于已实际拒绝、拍 0 不承接、整桶拍数承接≈桶比例、FSD 手拍超库存进货补足且库存不负、补货参数改动明年段即时生效、手工周系数进延伸段 */
    sfStep('tapAuditOk begin');
    let tapAuditOk=false;
    try{
      const A={};
      const cy=F.periodY(store.maxPeriod);
      const showPv=function(src,gran){ state.ui.tab='pv'; state.ui.pvSrc=src; state.ui.pv2View='country'; state.ui.pv2Gran=gran||'month'; state.ui.pv2Open={}; state.ui.pv2Yrs={}; state.ui.pv2Yrs[cy]=1; state.ui.pv2Yrs[cy+1]=1; state.ui.pv2C=''; state.ui.pv2L=''; state.ui.pv2Q=''; render(); const eb=$('#pv2Exp'); if(eb&&eb.onclick)eb.onclick(); return window.__pv2NodeIdx; };
      const cellOf=function(nk,bk,metric){ let out=null; document.querySelectorAll('#view-pv td[data-pv2b="'+bk+'"]').forEach(function(td){ if(out)return; if(td.dataset.pv2n!==nk)return; if(td.dataset.pv2k===metric||td.dataset.pv2m===metric)out=td; }); return out; };
      const tap=function(td,val){ td.dataset.orig=td.textContent; td.textContent=String(val); td.dispatchEvent(new Event('blur')); };
      const num=function(td){ return td?F.parseCellNum(td.textContent):null; };
      const wk=function(bk){ const b=(window.__pv2Bks||[]).filter(function(b2){ return b2.key===bk; })[0]; return b?b.fut:[]; };
      const clearOv=function(){ Object.keys(state.ovSO).forEach(function(k){ delete state.ovSO[k]; }); Object.keys(state.ovSI).forEach(function(k){ delete state.ovSI[k]; }); Object.keys(state.ovTail).forEach(function(k){ delete state.ovTail[k]; }); state.ovExt={}; ovExtGen++; computeAll(); };
      const rowsJ=function(it){ return JSON.stringify((it&&it.sim&&it.sim.rows||[]).map(function(r){ return [r.p,r.so,r.si,r.buy,r.inv]; })); };
      clearOv();
      let idx=showPv('fsd','month');
      const pKey=Object.keys(idx).filter(function(k){ const nd=idx[k]; return nd.depth===2&&nd.items.length>=2&&nd.items.every(function(it){ return (it.sim.rows||[]).length>0; }); })[0];
      const nd=idx[pKey];
      /* (a) 清尾读最新库存并归零:产品层先拍 10 月 SI +2000(不重绘),再清尾 11 月 */
      (function(){
        const octSi=cellOf(pKey,'M'+cy+'-10','si'); tap(octSi,num(octSi)+2000);
        const wsN=wk('M'+cy+'-11'); let invN=0,soN=0;
        nd.items.forEach(function(it){ const itN=D.byKey.get(it.u.key); const rows=(itN.sim.rows||[]).filter(function(r){ return wsN.indexOf(r.p)>=0; }); rows.forEach(function(r){ soN+=r.so||0; }); if(rows.length)invN+=rows[rows.length-1].inv||0; });
        const expTail=Math.round(invN+soN);
        tap(cellOf(pKey,'M'+cy+'-11','so'),'清尾');
        let wr=0,frozen=0; nd.items.forEach(function(it){ const o=state.ovSO[it.u.key]||{}; const t=state.ovTail[it.u.key]||{}; wsN.forEach(function(p){ if(o[p]!=null)wr+=o[p]; if(t[p])frozen++; }); });
        const novInv=num(cellOf(pKey,'M'+cy+'-11','inv'));
        const decSo=num(cellOf(pKey,'M'+cy+'-12','so'));
        A.tail={exp:expTail,written:wr,novInv:novInv,frozen:frozen,decSo:decSo,ok:wr===expTail&&novInv===0&&frozen===wsN.length*nd.items.length};
      })();
      /* (b) 拆分权重用最新现值:子单元 11 月拍 0 后,产品层 11 月拍 1000 应全部落到另一单元 */
      clearOv(); idx=showPv('fsd','month');
      (function(){
        const kidsK=Object.keys(idx).filter(function(k){ return k.indexOf(pKey+'|#|')===0&&idx[k].items.length===1; });
        const kA=kidsK[0]; const uA=idx[kA].items[0].u.key;
        tap(cellOf(kA,'M'+cy+'-11','so'),'0');
        tap(cellOf(pKey,'M'+cy+'-11','so'),'1000');
        const wsN=wk('M'+cy+'-11'); let sA=0,sB=0;
        nd.items.forEach(function(it){ const o=state.ovSO[it.u.key]||{}; wsN.forEach(function(p){ if(o[p]!=null){ if(it.u.key===uA)sA+=o[p]; else sB+=o[p]; } }); });
        A.weights={a:sA,b:sB,ok:sA===0&&sB===1000};
      })();
      /* (c) 音频专表与 FSD 表同键单元:音频源拍数不改 FSD 单元 */
      clearOv();
      (function(){
        let K=null; if(Da)Da.list.forEach(function(it){ if(!K&&D.byKey.has(it.u.key))K=it.u.key; });
        if(!K){ A.audioX={skip:'no colliding key'}; return; }
        const before=rowsJ(D.byKey.get(K));
        const idxA=showPv('audio','month');
        const leaf=Object.keys(idxA).filter(function(k){ const n2=idxA[k]; return n2.items.length===1&&n2.items[0].u.key===K&&n2.children.size===0; })[0];
        const td=leaf?cellOf(leaf,'M'+cy+'-10','so'):null;
        if(!td){ A.audioX={skip:'no leaf cell',leaf:leaf}; return; }
        tap(td,'333');
        const after=rowsJ(D.byKey.get(K));
        const aRows=rowsJ(Da.byKey.get(K));
        A.audioX={key:K.slice(0,50),fsdSame:before===after,keyA:!!state.ovSO['a|'+K],bare:!!state.ovSO[K],audioChanged:aRows!==before,ok:before===after&&!!state.ovSO['a|'+K]&&!state.ovSO[K]};
      })();
      /* (d) 下游镜像行(与 FSD 同 国家/账户/型号):两源互拍互不干扰,明年段同样 */
      clearOv();
      (function(){
        let fu=null; D.list.forEach(function(it){ if(!fu&&!it.u.audio&&(it.sim.rows||[]).length>0)fu=it.u; });
        if(!fu){ A.mirror={skip:'no fsd unit'}; return; }
        const hdr='Purchase   Country/Region\tChannel Name(R)\tProduct Line\tProduct\tProduct Series\tProduct Model\tPeriod ID\tPSI Type\tQTY';
        const L=[]; for(let w=20;w<=34;w++){ const pp=F.mkPeriod(cy,w);
          L.push([fu.country,fu.account,fu.line,fu.product,'X',fu.model,pp,'Sell Out',10].join('\t'));
          L.push([fu.country,fu.account,fu.line,fu.product,'X',fu.model,pp,'Inventory',200].join('\t'));
          if(w%4===0)L.push([fu.country,fu.account,fu.line,fu.product,'X',fu.model,pp,'Purchase',40].join('\t')); }
        const base=F.genRetailSampleTSV(); const lines=base.split('\n'); const hasHdr=/Country/.test(lines[0]);
        importRetailText((hasHdr?base:hdr+'\n'+base)+'\n'+L.join('\n'),'audit mirror');
        computeAll();
        const K=fu.key; const inR=!!(retailStore&&retailStore.units.has(K));
        if(!inR){ A.mirror={skip:'mirror not created',K:K.slice(0,60)}; importRetailText(F.genRetailSampleTSV(),'selftest 下游示例'); computeAll(); return; }
        const rBefore=rowsJ(Dr.byKey.get(K));
        let idxF=showPv('fsd','month');
        const nkF=Object.keys(idxF).filter(function(k){ const n2=idxF[k]; return n2.items.length===1&&n2.items[0].u.key===K&&n2.children.size===0; })[0];
        tap(cellOf(nkF,'M'+cy+'-10','so'),'1000');
        const rAfter=rowsJ(Dr.byKey.get(K));
        const m1={retailSame:rBefore===rAfter,bare:!!state.ovSO[K],rKey:!!state.ovSO['r|'+K]};
        clearOv();
        const fBefore=rowsJ(D.byKey.get(K));
        let idxR=showPv('retail','month');
        const nkR=Object.keys(idxR).filter(function(k){ const n2=idxR[k]; return n2.items.length===1&&n2.items[0].u.key===K&&n2.children.size===0; })[0];
        tap(cellOf(nkR,'M'+cy+'-10','si'),'500');
        const fAfter=rowsJ(D.byKey.get(K));
        const m2={fsdSame:fBefore===fAfter,rKey:!!state.ovSI['r|'+K],bare:!!state.ovSI[K]};
        clearOv();
        const extRow=function(){ return JSON.stringify(budgetRowsOv(cy+1).filter(function(r){ return r[6]===F.DICT.SRC_RETAIL&&r[4]===fu.country&&r[5]===fu.account&&String(r[17])===String(fu.model)&&+r[7]===cy+1&&+r[9]===3; }).map(function(r){ return [r[10],r[11],r[12]]; })); };
        const e0=extRow();
        idxF=showPv('fsd','month');
        const nkF2=Object.keys(idxF).filter(function(k){ const n2=idxF[k]; return n2.items.length===1&&n2.items[0].u.key===K&&n2.children.size===0; })[0];
        tap(cellOf(nkF2,'M'+(cy+1)+'-3','so'),'600');
        const e1=extRow();
        const m3={retailExtSame:e0===e1,ovExtKeys:Object.keys(state.ovExt)};
        A.mirror={m1:m1,m2:m2,m3:m3,ok:m1.retailSame&&m1.bare&&!m1.rKey&&m2.fsdSame&&m2.rKey&&!m2.bare&&m3.retailExtSame};
        clearOv();
        importRetailText(F.genRetailSampleTSV(),'selftest 下游示例'); computeAll();
      })();
      /* (e) 当月桶拍值低于已实际:拒绝、不写覆盖层、格子不变 */
      clearOv(); idx=showPv('fsd','month');
      (function(){
        const curM=F.monthOfP(store.maxPeriod);
        const td=cellOf(pKey,'M'+cy+'-'+curM,'so'); if(!td){ A.underHist={skip:'no current month cell'}; return; }
        const b=(window.__pv2Bks||[]).filter(function(b2){ return b2.key==='M'+cy+'-'+curM; })[0];
        let hist=0; nd.items.forEach(function(it){ (b?b.weeks:[]).forEach(function(p){ if(b.fut.indexOf(p)>=0)return; const w=it.u.weeks.get(p); if(w&&w.so!=null)hist+=w.so; }); });
        if(!(hist>10)){ A.underHist={skip:'no actual part',hist:hist}; return; }
        const shown=num(td); const n0=Object.keys(state.ovSO).length;
        tap(td,String(hist-10));
        const td2=cellOf(pKey,'M'+cy+'-'+curM,'so');
        A.underHist={shown:shown,hist:hist,after:num(td2),keys:Object.keys(state.ovSO).length-n0,ok:num(td2)===shown&&Object.keys(state.ovSO).length===n0};
      })();
      /* (f) 拍 0 不承接:10 月拍 0 后 11/12 月 SO 不变 */
      clearOv(); idx=showPv('fsd','month');
      (function(){
        const n11=num(cellOf(pKey,'M'+cy+'-11','so')), n12=num(cellOf(pKey,'M'+cy+'-12','so')), nJ=num(cellOf(pKey,'M'+(cy+1)+'-1','so'));
        tap(cellOf(pKey,'M'+cy+'-10','so'),'0');
        const a10=num(cellOf(pKey,'M'+cy+'-10','so')), a11=num(cellOf(pKey,'M'+cy+'-11','so')), a12=num(cellOf(pKey,'M'+cy+'-12','so')), aJ=num(cellOf(pKey,'M'+(cy+1)+'-1','so'));
        A.zero={oct:a10,nov:[n11,a11],dec:[n12,a12],jan:[nJ,aJ],ok:a10===0&&a11===n11&&a12===n12&&aJ===nJ};
      })();
      /* (g) 整桶拍数 +5:承接比例≈桶比例,11/12 月与明年 1 月变化 ≤2%+5 */
      clearOv(); idx=showPv('fsd','month');
      (function(){
        const n10=num(cellOf(pKey,'M'+cy+'-10','so')), n11=num(cellOf(pKey,'M'+cy+'-11','so')), n12=num(cellOf(pKey,'M'+cy+'-12','so')), nJ=num(cellOf(pKey,'M'+(cy+1)+'-1','so'));
        tap(cellOf(pKey,'M'+cy+'-10','so'),String(n10+5));
        const a11=num(cellOf(pKey,'M'+cy+'-11','so')), a12=num(cellOf(pKey,'M'+cy+'-12','so')), aJ=num(cellOf(pKey,'M'+(cy+1)+'-1','so'));
        const near=function(a,b){ return Math.abs(a-b)<=Math.max(5,b*0.02); };
        let ce=null; nd.items.forEach(function(it){ const itN=D.byKey.get(it.u.key); if(itN&&itN.fc&&ce==null)ce=itN.fc.carryEnd; });
        A.carry={oct:n10,nov:[n11,a11],dec:[n12,a12],jan:[nJ,aJ],carryEnd:ce,ok:near(a11,n11)&&near(a12,n12)&&near(aJ,nJ)};
      })();
      /* (h) FSD 手拍 SO 超库存:进货补足、库存不负、回显=拍值 */
      clearOv(); idx=showPv('fsd','month');
      (function(){
        const kidsK=Object.keys(idx).filter(function(k){ return k.indexOf(pKey+'|#|')===0&&idx[k].items.length===1; });
        const kA=kidsK[0]; const uA=idx[kA].items[0].u.key;
        const inv0=num(cellOf(kA,'M'+cy+'-9','inv'))||0; const v=Math.round((inv0+500)*3);
        tap(cellOf(kA,'M'+cy+'-9','so'),String(v));
        const shown=num(cellOf(kA,'M'+cy+'-9','so'));
        const it=D.byKey.get(uA); const rows=it.sim.rows||[];
        const neg=D.list.some(function(x){ return (x.sim.rows||[]).some(function(r){ return r.inv<0; }); });
        const cover=rows.some(function(r){ return r.siSrc==='tapcover'; });
        A.negInv={tapped:v,shown:shown,cover:cover,anyNeg:neg,minInv:Math.min.apply(null,rows.map(function(r){ return r.inv; })),ok:shown===v&&!neg};
      })();
      /* (i) 补货参数改动:明年延伸段无需 bump 即与全量一致 */
      clearOv();
      (function(){
        state.lineParams=state.lineParams||{};
        const line=nd.items[0].u.line; const old=state.lineParams[line];
        const r0=JSON.stringify(budgetRowsOv(cy+1));
        state.lineParams[line]={trigger:30,target:45}; computeAll();
        const r1=JSON.stringify(budgetRowsOv(cy+1));
        bumpDataGen(); computeAll();
        const r2=JSON.stringify(budgetRowsOv(cy+1));
        if(old)state.lineParams[line]=old; else delete state.lineParams[line];
        bumpDataGen(); computeAll();
        A.params={line:line,changed:r0!==r1,noBumpEqBump:r1===r2,ok:r1===r2};
      })();
      /* (j) 手工周系数进延伸段:改一个已过去的周系数 ×3,明年该周所在月变化 */
      (function(){
        const it=nd.items[0]; const kl=it.kl; if(!kl||!kl.key){ A.kedit={skip:'no layer'}; return; }
        const r0=JSON.stringify(budgetRowsOv(cy+1));
        const w=10; const kd=(kl.kdef&&kl.kdef[w]!=null)?kl.kdef[w]:1;
        (state.kedit[kl.key]=state.kedit[kl.key]||{})[w]=kd*3; computeAll();
        const r1=JSON.stringify(budgetRowsOv(cy+1));
        delete state.kedit[kl.key][w]; if(!Object.keys(state.kedit[kl.key]).length)delete state.kedit[kl.key]; computeAll();
        A.kedit={layer:kl.key.slice(0,40),changed:r0!==r1,ok:r0!==r1};
      })();
      /* (k) R4 明年段手拍后补货重排:拍高 ×3 → 后续月 SO 不低于基表、SI 不再全部冻结;拍低 → 年底库存不暴涨 */
      clearOv();
      (function(){
        const u0=nd.items[0].u;
        const extRows=function(){ const o={}; budgetRowsOv(cy+1).forEach(function(r){
          if(r[6]!=='FSD'||r[4]!==u0.country||r[5]!==u0.account||String(r[17])!==String(u0.model)||+r[7]!==cy+1)return;
          o[+r[9]]=[+r[10],+r[11],+r[12]]; }); return o; };
        const base=extRows(); const ms=Object.keys(base).map(Number).sort(function(a,b){ return a-b; });
        if(ms.length<6){ A.extRepl={skip:'too few ext months'}; return; }
        const m0=ms[0];
        const idxE=showPv('fsd','month');
        const leaf=Object.keys(idxE).filter(function(k){ const n2=idxE[k]; return n2.items.length===1&&n2.items[0].u.key===u0.key&&n2.children.size===0; })[0];
        const tdE=leaf?cellOf(leaf,'M'+(cy+1)+'-'+m0,'so'):null;
        if(!tdE){ A.extRepl={skip:'no ext cell'}; return; }
        tap(tdE,String(Math.round(base[m0][0]*3)||300));
        const hi=extRows();
        let below=0,siSame=0,nAfter=0;
        ms.forEach(function(m){ if(m<=m0)return; nAfter++;
          if(hi[m][0]<base[m][0])below++;
          if(hi[m][1]===base[m][1])siSame++; });
        clearOv();
        tap(cellOf(leaf,'M'+(cy+1)+'-'+m0,'so'),String(Math.max(5,Math.round(base[m0][0]*0.3))));
        const lo=extRows();
        const lastM=ms[ms.length-1];
        const invBase=base[lastM][2],invLo=lo[lastM][2];
        A.extRepl={m0:m0,nAfter:nAfter,below:below,siSame:siSame,invBase:invBase,invLo:invLo,
          ok:nAfter>0&&below===0&&siSame<nAfter&&invLo<=Math.max(invBase*2,invBase+200)};
        clearOv();
      })();
      /* (l) R6 后年手拍 SI 不再挤掉明年:同一 cy+1 月份在 budgetRowsOv(cy+1) 与 (cy+2) 一致 */
      (function(){
        const u0=nd.items[0].u; const mk=mkKey(u0);
        const y1=function(endY){ const o={}; budgetRowsOv(endY).forEach(function(r){
          if(r[6]!=='FSD'||mkNorm(r[1])!==mkNorm(u0.product)||mkNorm(r[17])!==mkNorm(u0.model)||+r[7]!==cy+1)return;
          o[r[4]+'|'+r[5]+'|'+r[9]]=[+r[10],+r[11],+r[12]]; }); return JSON.stringify(o); };
        const snt=lockSentOf(mk);
        let futE=0; budgetRowsOv(cy+2).forEach(function(r){ if(r[6]==='FSD'&&mkNorm(r[1])===mkNorm(u0.product)&&mkNorm(r[17])===mkNorm(u0.model)&&+r[7]>cy)futE+=(+r[11]||0); });
        state.lockQty[mk]={on:true,total:snt.sent+Math.round(futE*0.9)+500,byC:{}};
        computeAll();
        const idxE=showPv('fsd','month');
        const leaf=Object.keys(idxE).filter(function(k){ const n2=idxE[k]; return n2.items.length===1&&n2.items[0].u.key===u0.key&&n2.children.size===0; })[0];
        state.ui.pv2Yrs[cy+2]=1; render();
        const eb2=$('#pv2Exp'); if(eb2&&eb2.onclick)eb2.onclick();
        const td2=cellOf(leaf,'M'+(cy+2)+'-1','si');
        if(!td2){ A.extYear={skip:'no cy+2 cell'}; delete state.lockQty[mk]; computeAll(); return; }
        /* 断言的是 R6 本身:后年(cy+2)手拍 SI 不得改变 cy+1 段的分配。
           注:budgetRowsOv(cy+1) 与 (cy+2) 的 cy+1 末两月本就可能不同——延伸引擎的 8 周前瞻需求在窗口末端被截断,
           窗口越长末月需求越完整(与手拍无关的口径,已在 README 记为已知项),故这里比的是「同一 endYear 下 拍前 vs 拍后」 */
        const b0=y1(cy+2), h0=y1(cy+1);
        tap(td2,'3000');
        const b1=y1(cy+2), h1=y1(cy+1);
        A.extYear={extSame:b0===b1,horizonSame:h0===h1,horizonConsistent:b0===h0,ok:b0===b1&&h0===h1&&b0===h0};
        delete state.lockQty[mk]; clearOv(); computeAll();
      })();
      /* (m) R7 批量父子同列:父→子 与 子→父 结果一致(以更细层级为准) */
      clearOv(); idx=showPv('fsd','month');
      (function(){
        const kidsK=Object.keys(idx).filter(function(k){ return k.indexOf(pKey+'|#|')===0&&idx[k].items.length===1; });
        if(!kidsK.length){ A.batchDup={skip:'no leaf'}; return; }
        const kA=kidsK[0];
        const selP=function(){ return xgSelOf(cellOf(pKey,'M'+cy+'-10','so')); };
        const selC=function(){ return xgSelOf(cellOf(kA,'M'+cy+'-10','so')); };
        xgApply([{sel:selP(),val:'10000'},{sel:selC(),val:'0'}]);
        const r1={p:num(cellOf(pKey,'M'+cy+'-10','so')),c:num(cellOf(kA,'M'+cy+'-10','so'))};
        clearOv(); idx=showPv('fsd','month');
        xgApply([{sel:selC(),val:'0'},{sel:selP(),val:'10000'}]);
        const r2={p:num(cellOf(pKey,'M'+cy+'-10','so')),c:num(cellOf(kA,'M'+cy+'-10','so'))};
        clearOv(); idx=showPv('fsd','month');
        tap(cellOf(kA,'M'+cy+'-10','so'),'0');
        tap(cellOf(pKey,'M'+cy+'-10','so'),'10000');
        const r3={p:num(cellOf(pKey,'M'+cy+'-10','so')),c:num(cellOf(kA,'M'+cy+'-10','so'))};
        A.batchDup={batchPC:r1,batchCP:r2,seq:r3,ok:r2.p===r3.p&&r2.c===r3.c};
        clearOv();
      })();
      /* (n) R1 锁量下手拍 SO:补足进货与手拍同级 → 回显=拍值、manOver 亮、工具条红字出现 */
      clearOv();
      (function(){
        let u0=null; nd.items.forEach(function(it){ if(!u0&&(it.sim.rows||[]).length>0)u0=it.u; });
        if(!u0){ A.lockCap={skip:'no sim unit'}; return; }
        const mk=mkKey(u0); const snt=lockSentOf(mk);
        let futSI=0; D.list.forEach(function(it){ if(mkKey(it.u)!==mk)return; ((it.sim&&it.sim.rows)||[]).forEach(function(r){ futSI+=r.si||0; }); });
        state.lockQty[mk]={on:true,total:snt.sent+futSI,byC:{}};   // 中性锁量:拍数前一台不砍
        computeAll();
        idx=showPv('fsd','month');
        const td=cellOf(pKey,'M'+cy+'-12','so');
        if(!td){ A.lockCap={skip:'no dec cell'}; delete state.lockQty[mk]; computeAll(); return; }
        const v=Math.round((num(td)||100)*6)+1000;
        tap(td,String(v));
        const tdA=cellOf(pKey,'M'+cy+'-12','so');
        const shown=num(tdA); const w=document.getElementById('pvLockWarn');
        const marked=!!(tdA&&tdA.getAttribute('data-capped'));
        /* 默认(锁量硬顶):SO 被压回是允许的,但绝不能静默——格子标红 + 上方红字 */
        const okDefault=shown<v&&marked&&!!(w&&w.style.display!=='none');
        /* 勾上「补足进货不受锁量压缩」后:回显=拍值,并记 manOver */
        state.cfg.lockTapCover=true; computeAll(); render();
        const shown2=num(cellOf(pKey,'M'+cy+'-12','so')); const R2=__lockRes[mk];
        const okOn=shown2>shown;
        state.cfg.lockTapCover=false;
        A.lockCap={tapped:v,shown:shown,marked:marked,warnShown:!!(w&&w.style.display!=='none'),
          shownWithSwitch:shown2,manOverWithSwitch:!!(R2&&R2.manOver),switchMoved:okOn,ok:okDefault};   // FSD 今年段的量多来自规则补货而非 tapcover,开关在此场景可能无变化(下游/延伸段才是 tapcover 主场)
        delete state.lockQty[mk]; clearOv(); computeAll();
      })();
      /* (o) R8 待确认单元:进推演编辑树、今年格只读、底表有今年库存结转行(财经Q表「上年年底库存」= 明年 1 月期初) */
      (function(){
        let bu=null; D.list.forEach(function(it){ if(!bu&&it.sim&&it.sim.blocked)bu=it; });
        if(!bu){ A.pendUnit={skip:'no blocked unit'}; return; }
        const idxP=showPv('fsd','month');
        let inTree=false; Object.keys(idxP).forEach(function(k){ if(idxP[k].items.some(function(it){ return it.u.key===bu.u.key; }))inTree=true; });
        const leaf=Object.keys(idxP).filter(function(k){ const n2=idxP[k]; return n2.items.length===1&&n2.items[0].u.key===bu.u.key&&n2.children.size===0; })[0];
        const tdSo=leaf?cellOf(leaf,'M'+cy+'-12','so'):null;
        const editable=tdSo?(tdSo.getAttribute('contenteditable')!=null):null;
        const rowsB=budgetRowsOv(cy+1);
        const mine=function(y,m){ return rowsB.filter(function(r){ return r[6]==='FSD'&&r[4]===bu.u.country&&r[5]===bu.u.account&&String(r[17])===String(bu.u.model)&&+r[7]===y&&+r[9]===m; }); };
        const dec=mine(cy,12), jan=mine(cy+1,1);
        const prevEnd=dec.length?+dec[0][12]:null;
        const janStart=jan.length?((+jan[0][12]||0)-(+jan[0][11]||0)+(+jan[0][10]||0)):null;
        A.pendUnit={key:bu.u.key.slice(-22),inTree:inTree,editable:editable,prevEnd:prevEnd,janStart:janStart,
          ok:inTree===true&&editable===false&&prevEnd!=null&&janStart!=null&&prevEnd===janStart};
      })();
      clearOv();
      tapAuditOk=['tail','weights','audioX','mirror','underHist','zero','carry','negInv','params','kedit','extRepl','extYear','batchDup','lockCap','pendUnit'].every(function(k){ return A[k]&&(A[k].ok===true||A[k].skip!=null); });
      tms.tapAudit=A;
    }catch(e){ tms.tapAudit='ERR:'+String(e&&e.stack||e).slice(0,400); }
    /* 季/年列 DOS 口径(2026-09-02 用户:月视图 12 月底 DOS 50 天,季视图 Q4 变 106 天):同一节点 12 月 DOS === Q4 DOS === 全年 DOS;明年列同样 */
    sfStep('dosQOk begin');
    let dosQOk=false;
    try{
      state.ui.tab='pv'; state.ui.pvSrc='fsd'; state.ui.pv2View='country'; state.ui.pv2Gran='month'; state.ui.pv2Open={};
      const cyQ=F.periodY(store.maxPeriod); state.ui.pv2Yrs={}; state.ui.pv2Yrs[cyQ]=1; state.ui.pv2Yrs[cyQ+1]=1; render();
      const first=document.querySelector('#view-pv td[data-pv2m="dos"]'); const nk=first?first.dataset.pv2n:null;
      const cellOf=function(m,b){ let out=null; document.querySelectorAll('#view-pv td[data-pv2m="'+m+'"][data-pv2b="'+b+'"]').forEach(function(td){ if(!out&&td.dataset.pv2n===nk)out=td; }); return out?out.textContent.trim():null; };
      const m12=cellOf('dos','M'+cyQ+'-12'), m12i=cellOf('inv','M'+cyQ+'-12'), n12=cellOf('dos','M'+(cyQ+1)+'-12');
      state.ui.pv2Gran='quarter'; render(); const q4=cellOf('dos','Q'+cyQ+'-4'), q4i=cellOf('inv','Q'+cyQ+'-4'), nq4=cellOf('dos','Q'+(cyQ+1)+'-4');
      state.ui.pv2Gran='year'; render(); const yy=cellOf('dos','Y'+cyQ), ny=cellOf('dos','Y'+(cyQ+1));
      dosQOk=!!(nk&&m12!=null&&m12===q4&&m12===yy&&m12i===q4i&&n12===nq4&&n12===ny);
      tms.dosQ={m12:m12,q4:q4,y:yy,inv:m12i+'/'+q4i,n12:n12,nq4:nq4,ny:ny};
      state.ui.pv2Gran='month';
    }catch(e){ tms.dosQ='ERR:'+String(e&&e.message||e).slice(0,140); }
    /* 外推拍数+撤销+快照冒烟:27年格拍7777→回显→Ctrl+Z 撤销→回原值;快照 保存→列表→读回 */
    sfStep('udOk begin');
    let udOk=false;
    try{
      state.ui.tab='pv'; state.ui.pvSrc='fsd'; state.ui.pv2Gran='month';
      state.ui.pv2Yrs={}; state.ui.pv2Yrs[F.periodY(store.maxPeriod)]=1; state.ui.pv2Yrs[F.periodY(store.maxPeriod)+1]=1;
      state.ui.pv2Open={}; render();
      let extTd=null;
      document.querySelectorAll('#view-pv td[data-pv2k="so"]').forEach(function(td){
        if(extTd)return;
        if(!/^M\d{4}-/.test(td.dataset.pv2b||''))return;
        if(+String(td.dataset.pv2b).slice(1,5)<=F.periodY(store.maxPeriod))return;
        const v0=F.parseCellNum(td.textContent);
        if(v0!=null&&v0>=4)extTd=td;   // 拍原值一半:不触库存硬约束,可精确断言
      });
      let extOk=false,undoOk=false,snapOk=false;
      if(extTd){
        const sel={n:extTd.dataset.pv2n,b:extTd.dataset.pv2b};
        const orig0=F.parseCellNum(extTd.textContent);
        const half=Math.max(1,Math.round(orig0/2));
        extTd.dataset.orig=extTd.textContent;
        extTd.textContent=String(half);
        extTd.dispatchEvent(new Event('blur'));
        const find=function(){ let x=null;
          document.querySelectorAll('#view-pv td[data-pv2k="so"]').forEach(function(td){
            if(!x&&td.dataset.pv2n===sel.n&&td.dataset.pv2b===sel.b)x=td; });
          return x; };
        const a1=find();
        sfStep('ud tapped');
        extOk=!!(a1&&F.parseCellNum(a1.textContent)===half&&Object.keys(state.ovExt).length>0);
        if(!extOk)tms.udDbg={orig:orig0,half:half,after:a1?a1.textContent:null,ovN:Object.keys(state.ovExt).length};
        undoLast();
        sfStep('ud undone');
        const a2=find();
        undoOk=!!(a2&&F.parseCellNum(a2.textContent)===orig0&&!Object.keys(state.ovExt).length);
      }
      /* 任何一次 IPC 都不许把整个自检拖死:超时就当失败继续跑(2026-09-04 自检在此静默卡了几十分钟,
         而 IPC 卡住的原因只有跑完拿到 tms 才看得出来) */
      const ipc=function(p,ms,tag2){ return Promise.race([Promise.resolve(p).catch(function(e){ return {__err:String(e&&e.message||e).slice(0,160)}; }),
        new Promise(function(r2){ setTimeout(function(){ r2({__timeout:tag2}); },ms||20000); })]); };
      let stSize=-1; try{ stSize=JSON.stringify(state).length; }catch(e){ stSize=-2; }
      sfStep('ud pre-snap stateBytes='+stSize);
      if(SHELL&&SHELL.snapSave){
        const sr=await ipc(SHELL.snapSave({name:'selftest',state:state}),20000,'snapSave');
        sfStep('ud snapSaved '+JSON.stringify(sr&&(sr.__timeout||sr.__err)||'ok'));
        const sl=await ipc(SHELL.snapList(),20000,'snapList');
        sfStep('ud snapListed');
        const hit=sr&&sr.ok&&sl&&sl.ok&&sl.list.some(function(s){ return s.file===sr.file; });
        let rd=null;
        if(hit)rd=await ipc(SHELL.snapRead(sr.file),20000,'snapRead');
        snapOk=!!(hit&&rd&&rd.ok&&rd.data&&rd.data.state&&rd.data.state.cfg);
      }
      udOk=extOk&&undoOk&&snapOk;
      tms.ud={ext:extOk,undo:undoOk,snap:snapOk};
      state.ui.pv2Yrs={};
    }catch(e){ tms.ud='ERR:'+String(e&&e.message||e).slice(0,140); }
    /* AI 解读冒烟(不依赖模型):因子分解一致性/参数校验/溯源门禁/路由/口径检索/Dock 确定性面板 */
    sfStep('aiOk begin');
    let aiOk=false;
    try{
      const cand2={};
      D.list.forEach(function(it){ if(it.u.audio||it.exempt)return;
        let s=0; (it.sim.rows||[]).forEach(function(r){ s+=(r.so||0); });
        cand2[it.u.product]=(cand2[it.u.product]||0)+s; });
      let prod=null,ps=0;
      Object.keys(cand2).forEach(function(k){ if(cand2[k]>ps){ ps=cand2[k]; prod=k; } });
      const m0=F.monthOfP(D.fw[0]);
      /* ① explainCell 与 simQuery 同口径 */
      const ex=aiExplainCell({product:prod,month:m0});
      const sq=aiToolSimQuery({product:prod});
      const sqRow=(sq.rows||[]).filter(function(r){ return r.月===m0; })[0];
      const exOk=!!(ex&&!ex.error&&sqRow&&ex.月度值.推演SO===sqRow.推演SO
        &&ex.月度值.其中手工SO+ex.月度值.公式SO===ex.月度值.推演SO
        &&Array.isArray(ex.解读要点));
      /* ② 参数校验:未知参数报名字;字符串化 JSON 自动 parse */
      const v1=aiValidateArgs('simQuery',{dimension:'x'});
      const v2=aiValidateArgs('explainCell',{product:prod,month:'9'});
      const vOk=!v1.ok&&/dimension/.test(v1.error)&&v2.ok&&v2.args.month===9;
      /* ③ 溯源门禁:编造数字拦下,工具返回的数字放行 */
      const pv=aiProvenance('总量是 33445 台,而 '+ex.月度值.推演SO+' 台来自推演',
        [JSON.stringify(ex)]);
      const pOk=pv.blocked.indexOf('33445')>=0&&pv.answer.indexOf(String(ex.月度值.推演SO))>=0;
      /* ④ 路由与口径检索 */
      const r1=aiRoute('9月SO为什么这么高'),r2=aiRoute('DOS的口径是什么');
      const rOk=r1[0].agentId==='forecast'&&r2[0].agentId==='caliber';
      const cd=aiToolCaliberDoc({topic:'DOS'});
      const cOk=!!(cd.命中&&cd.命中.length&&/DOS/.test(cd.命中[0]));
      /* ⑤ Dock 确定性面板 */
      aiToggleDock(true);
      aiPush('a',aiExplainHtml(ex));
      const dockOk=!!(document.getElementById('aiMsgs')&&/为什么是这个数|Why this number|推演SO|Forecast SO/.test(document.getElementById('aiMsgs').innerHTML));
      aiToggleDock(false);
      const mb=document.getElementById('aiMsgs'); if(mb)mb.innerHTML='';
      aiOk=!!(exOk&&vOk&&pOk&&rOk&&cOk&&dockOk);
      tms.ai={ex:exOk,valid:vOk,prov:pOk,route:rOk,doc:cOk,dock:dockOk,
        prod:prod,month:m0,so:ex&&ex.月度值?ex.月度值.推演SO:null,notes:ex&&ex.解读要点?ex.解读要点.length:0};
    }catch(e){ tms.ai='ERR:'+String(e&&e.message||e).slice(0,140); }
    /* 性能证据:冷算(数据代碰一下)与热算各一次 */
    try{
      bumpDataGen();
      const pc1=performance.now(); computeAll(); const cold=Math.round(performance.now()-pc1);
      const pc2=performance.now(); computeAll(); const warm=Math.round(performance.now()-pc2);
      tms.perf={computeCold:cold,computeWarm:warm};
    }catch(e){ tms.perf='ERR:'+String(e&&e.message||e).slice(0,80); }
    /* SO 目标冒烟:用当前 store 第一个单元构造目标行→断言匹配成功与年底口径可算→清理回滚 */
    sfStep('targetOk begin');
    let targetOk=false;
    try{
      let u0=null; if(store)store.units.forEach(function(u){ if(!u0)u0=u; });
      if(u0){
        importTargetRows([{line:u0.line,product:u0.product,country:u0.country,channel:u0.account,
          rawName:u0.account,t:{9:200,10:150,11:200,12:200},note:''}],'selftest 目标');
        const r0=Dt&&Dt.rows[0];
        targetOk=!!(r0&&r0.src&&r0.calc);
        tms.target={src:r0?r0.src:null,yEndDos:(r0&&r0.calc)?r0.calc[3].endDos:null,nAlert:Dt?Dt.nAlert:null};
        state.ui.tab='targets';
        const t0=performance.now(); render(); tms.r_targets=Math.round(performance.now()-t0);
        targetRows=null; Dt=null; saveData4(); recompute();
      } else tms.target={noUnit:true};
    }catch(e){ tms.target='ERR:'+String(e&&e.message||e).slice(0,120); }
    /* SI/SO 引擎冒烟:生命周期停购+衰减 / 新品虚拟单元 / 模型回测(多核) */
    let engOk=false,npLateOk=false;
    try{
      let lcOk=false;
      let it0=null;
      if(D)D.list.forEach(function(it){ if(!it0&&it.sim&&it.sim.rows&&it.sim.rows.length>8&&!it.exempt)it0=it; });
      if(it0){
        const pd=it0.u.product;
        const eolP=F.addWeeksP(store.maxPeriod,2);
        state.lifecycle[pd]={eolSI:eolP};
        computeAll();
        const it2=D.byKey.get(it0.u.key);
        const rows=it2&&it2.sim?it2.sim.rows:[];
        let siAfter=0,decayed=false;
        rows.forEach(function(r){ if(r.p>eolP)siAfter+=(r.si||0); });
        for(let i=1;i<rows.length;i++){ if(rows[i].p>eolP&&rows[i-1].p>eolP&&rows[i].so<=rows[i-1].so){ decayed=true; break; } }
        lcOk=(siAfter===0)&&decayed;
        tms.lc={siAfter:siAfter,decayed:decayed};
        delete state.lifecycle[pd];
        computeAll();
      }
      let npOk=false;
      let anchor=null;
      if(Dr)Dr.list.forEach(function(it){ if(!anchor&&it.bl&&it.bl.base!=null&&it.bl.conf!=='low')anchor=it.u.product; });
      if(!anchor&&D)D.list.forEach(function(it){ if(!anchor&&it.bl&&it.bl.base!=null&&it.bl.conf!=='low')anchor=it.u.product; });
      if(anchor){
        state.newProducts.push({id:'npTest',name:'自测新品',line:'平板',family:'Slate Tab',anchor:anchor,scale:1,
          launch:F.addWeeksP(store.maxPeriod,3),lifeWeeks:52,succ:null});
        computeAll();
        npOk=!!(Dn&&Dn.perNp.length&&Dn.perNp[0].units.length
          &&Dn.perNp[0].units[0].rows.some(function(r){ return r.so>0; }));
        tms.np={ch:(Dn&&Dn.perNp.length)?Dn.perNp[0].units.length:0};
        state.ui.tab='newprod';
        const tnp=performance.now(); render(); tms.r_newprod=Math.round(performance.now()-tnp);
        state.newProducts=state.newProducts.filter(function(x){ return x.id!=='npTest'; });
        computeAll();
      }
      /* 迟上新品(2026-09-01 用户:27 年上市的新品必须模拟出 27 年的量):明年 W2 上市 → 窗口跨到明年、明年有 SO、今年切片全 0、预算底表明年有新品行 */
      if(anchor){
        const cyN=F.periodY(store.maxPeriod);
        state.newProducts.push({id:'npLate',name:'迟上新品',line:'平板',family:'Slate Tab',anchor:anchor,scale:1,
          launch:F.mkPeriod(cyN+1,2),lifeWeeks:52,succ:null});
        state.newProducts.push({id:'npLate2',name:'迟上新品二号',line:'平板',family:'Slate Tab',anchor:anchor,scale:1,
          launch:F.mkPeriod(cyN+1,20),lifeWeeks:52,succ:null});   // 同渠道第二个新品:明年列必须按产品分开(型号位=产品名)
        computeAll();
        const pnL=Dn&&Dn.perNp.filter(function(pn){ return pn.np.id==='npLate'; })[0];
        const pnL2=Dn&&Dn.perNp.filter(function(pn){ return pn.np.id==='npLate2'; })[0];
        const uL=pnL&&pnL.units[0];
        let extSep=false, extN=0;
        try{ const ext=pv2ExtByKey('np',cyN+1); extN=ext.size; extSep=!!(pnL2&&pnL2.units.length&&ext.size===(pnL.units.length+pnL2.units.length)); }catch(e){}
        const soNext=uL?uL.rowsLong.filter(function(r){ return F.periodY(r.p)===cyN+1; }).reduce(function(s,r){ return s+r.so; },0):0;
        const soCur=uL?uL.rows.reduce(function(s,r){ return s+r.so; },0):-1;
        let budNext=0;
        try{ buildBudgetRows(cyN+1).forEach(function(r){ if(r[6]===F.DICT.SRC_NP&&r[1]==='迟上新品'&&+r[7]===cyN+1)budNext+=(+r[10]||0); }); }catch(e){}
        npLateOk=!!(uL&&Dn.fwLong&&Dn.fwLong.length&&F.periodY(Dn.fwLong[Dn.fwLong.length-1])>=cyN+1&&soNext>0&&soCur===0&&budNext>0&&extSep);
        tms.npLate={ch:pnL?pnL.units.length:0,soNext:soNext,soCur:soCur,budNext:budNext,winEnd:Dn.fwLong?Dn.fwLong[Dn.fwLong.length-1]:null,extSep:extSep,extN:extN};
        state.newProducts=state.newProducts.filter(function(x){ return x.id!=='npLate'&&x.id!=='npLate2'; });
        computeAll();
      }
      state.ui.tab='coef'; render();
      const mbh=document.getElementById('mbHost');
      let mbOk=false;
      if(mbh){
        await runModelBacktest(mbh);
        mbOk=!!(window.__mbLast&&isFinite(window.__mbLast.wmA)&&isFinite(window.__mbLast.wmB));
        tms.mb=window.__mbLast||null;
      }
      engOk=lcOk&&npOk&&mbOk;
      tms.eng={lcOk:lcOk,npOk:npOk,mbOk:mbOk};
    }catch(e){ tms.eng='ERR:'+String(e&&e.message||e).slice(0,140); }
    /* 预算底表冒烟:行数充足且非新品行 SO 总量 ≥ 看板推演总量(底表=看板段+延伸段,不允许缩水) */
    sfStep('budOk begin');
    let budOk=false;
    try{
      const curY2=F.periodY(store.maxPeriod);
      const rowsB=buildBudgetRows(curY2+1);
      let simTot=0;
      [D,Dr,Da].forEach(function(Dx){ if(Dx)Dx.list.forEach(function(it){
        if(it.ignored)return;
        (it.sim&&it.sim.rows||[]).forEach(function(r){ simTot+=r.so||0; }); }); });
      let budTot=0;
      rowsB.forEach(function(r){ if(r[6]!=='新品规划')budTot+=(+r[10]||0); });
      budOk=rowsB.length>100&&simTot>0&&budTot>=simTot*0.98;
      tms.bud={rows:rowsB.length,simTot:Math.round(simTot),budTot:Math.round(budTot)};
    }catch(e){ tms.bud='ERR:'+String(e&&e.message||e).slice(0,140); }
    /* 一次性铺货审视冒烟:合成 单次大额SI+长期动销 渠道→判 oneshot→待确认页出审视区→拍板切口径 */
    sfStep('osOk begin');
    let osOk=false;
    try{
      const L=['Purchase   Country/Region\tChannel Name(R)\tProduct Line\tProduct\tProduct Series\tProduct Model\tPeriod ID\tPSI Type\tQTY'];
      let inv2=0;
      for(let w=1;w<=30;w++){
        const pp='2026W'+String(w).padStart(2,'0');
        const si2=w===1?500:0, so2=10;
        inv2=inv2+si2-so2;
        L.push(['哥伦比亚','MODERNA ALMACENES_Indirect Retailer','手机','ACME nimbus 13','Vela','Vela-L23',pp,'Purchase',si2].join('\t'));
        L.push(['哥伦比亚','MODERNA ALMACENES_Indirect Retailer','手机','ACME nimbus 13','Vela','Vela-L23',pp,'Sell Out',so2].join('\t'));
        L.push(['哥伦比亚','MODERNA ALMACENES_Indirect Retailer','手机','ACME nimbus 13','Vela','Vela-L23',pp,'Inventory1',inv2].join('\t'));
      }
      importRetailText(L.join('\n'),'selftest 一次性铺货');
      recompute();
      let osIt=null;
      Dr.list.forEach(function(it){ if(!osIt&&it.u.account.indexOf('OS-TEST')>=0)osIt=it; });
      const osKey=osIt?osIt.u.key:null;
      const modeOk=!!(osIt&&rstatOfCached(osIt.u).mode==='oneshot');
      const listed=buyReviewList().some(function(r){ return r.it.u.key===osKey; });
      const zeroed=!!(osIt&&(osIt.sim.rows||[]).every(function(r){ return r.buySrc==='zero'||r.buySrc==='override'; }));
      state.ui.tab='confirm'; render();
      let clicked=false;
      document.querySelectorAll('#view-confirm button[data-osk]').forEach(function(b){
        if(!clicked&&b.dataset.osk===osKey&&b.dataset.osv==='auto'){ b.onclick(new MouseEvent('click')); clicked=true; }
      });
      const it2=Dr.byKey.get(osKey);
      const ruled=!!(clicked&&it2&&(it2.sim.rows||[]).some(function(r){ return r.buySrc==='rule'||r.buySrc==='rule0'; }));
      const decided=state.buyMode[osKey]==='auto';
      delete state.buyMode[osKey]; recompute();
      const back=!!(Dr.byKey.get(osKey)&&(Dr.byKey.get(osKey).sim.rows||[]).every(function(r){ return r.buySrc==='zero'||r.buySrc==='override'; }));
      osOk=modeOk&&listed&&zeroed&&clicked&&ruled&&decided&&back;
      tms.os={mode:modeOk,listed:listed,zeroed:zeroed,clicked:clicked,ruled:ruled,decided:decided,undone:back};
    }catch(e){ tms.os='ERR:'+String(e&&e.message||e).slice(0,140); }
    /* 新品看板冒烟:推演编辑切「新品」源,每个国家×渠道四行存在且可拍(拍后 SO 精确回显) */
    sfStep('npPvOk begin');
    let npPvOk=false;
    try{
      /* 自建一个冒烟新品(锚定当前任一在售品),测完删除——不依赖前面冒烟留下的新品 */
      const anchorIt=D&&D.list.filter(function(it){ return it.sim&&it.sim.rows&&it.sim.rows.length&&!it.exempt&&it.bl&&it.bl.base; })[0];
      if(anchorIt){
        state.newProducts.push({id:'npSmoke',name:'冒烟新品',line:anchorIt.u.line,family:'',anchor:anchorIt.u.product,scope:'anchor',
          scale:1,launch:F.addWeeksP(store.maxPeriod,1),lifeWeeks:52,succ:null});
        recompute();
      }
      if(Dn&&Dn.perNp&&Dn.perNp.length){
        state.ui.tab='pv'; state.ui.pvSrc='np'; state.ui.pv2View='country'; state.ui.pv2Gran='month'; state.ui.pv2Open={};
        state.ui.pv2C=''; state.ui.pv2L=''; state.ui.pv2Q=''; render();
        const host=$('#view-pv');
        const eb=$('#pv2Exp'); if(eb&&eb.onclick)eb.onclick();
        const cells=host.querySelectorAll('td[data-pv2k="so"]');
        let cell=null; cells.forEach(function(td){ if(!cell&&F.parseCellNum(td.textContent)>0)cell=td; });
        let echo=null;
        if(cell){
          const sel={n:cell.dataset.pv2n,b:cell.dataset.pv2b};
          cell.dataset.orig=cell.textContent; cell.textContent='4321'; cell.dispatchEvent(new Event('blur'));
          host.querySelectorAll('td[data-pv2k="so"]').forEach(function(td){ if(echo==null&&td.dataset.pv2n===sel.n&&td.dataset.pv2b===sel.b)echo=F.parseCellNum(td.textContent); });
          Object.keys(state.ovSO).forEach(function(k){ if(k.indexOf('NP|')===0)delete state.ovSO[k]; });
          recompute();
        }
        npPvOk=cells.length>0&&echo===4321;
        tms.npPv={cells:cells.length,echo:echo};
        state.ui.pvSrc='fsd';
      } else { npPvOk=false; tms.npPv='no-np'; }
      state.newProducts=state.newProducts.filter(function(x){ return x.id!=='npSmoke'; });
      recompute();
    }catch(e){ tms.npPv='ERR:'+String(e&&e.message||e).slice(0,140); }
    /* 持久化探针:当前方案写文件→读回,验证升级不丢的通路 */
    sfStep('persistOk begin');
    let persistOk=false;
    try{
      const w=await SHELL.stateSave(JSON.parse(JSON.stringify(state)));
      const r=await SHELL.stateLoad();
      persistOk=!!(w&&w.ok&&r&&r.ok&&r.state&&r.state.cfg);
    }catch(e){}
    /* 拍数性能门禁(2026-09-02 用户:每输入一个数都要等很久,要求即时响应):
       合成 288 单元×87 周的底表 → 展开全部 → 叶子/产品层各拍一次,断言 单次拍数 < 60ms 且范围收敛到被拍单元。
       放在最后跑:它会替换 FSD 底表,后面不再有别的检查。 */
    sfStep('perfOk begin');
    let perfOk=false;
    try{
      const CS=['C1','C2','C3','C4','C5','C6'], AC=['A1','A2','A3','A4','A5','A6','A7','A8'], LNS=['手机','平板','智能穿戴与运动健康'];
      const HD='Management Country/Region\tManagement Account Name(D)\tProduct Line\tProduct\tProduct Model\tPeriod ID\tPSI Type\tQTY';
      const LL=[HD];
      for(let ci=0;ci<CS.length;ci++)for(let ai=0;ai<AC.length;ai++)for(let m=0;m<6;m++){
        let iv=400+m*10;
        for(let y=2025;y<=2026;y++){ const nW=F.weeksInISOYear(y);
          for(let w=1;w<=nW;w++){ if(y===2026&&w>34)break;
            const p=F.mkPeriod(y,w), so=20+((w*7+m*3+ai)%25), si=(w%4===0)?so*4:0;
            iv=Math.max(0,iv+si-so);
            LL.push([CS[ci],AC[ai],LNS[m%3],'PerfProd '+(m%3),'PM-'+m+'-'+(ci%2),p,'Sell Out',so].join('\t'));
            if(si)LL.push([CS[ci],AC[ai],LNS[m%3],'PerfProd '+(m%3),'PM-'+m+'-'+(ci%2),p,'Sell In',si].join('\t'));
            LL.push([CS[ci],AC[ai],LNS[m%3],'PerfProd '+(m%3),'PM-'+m+'-'+(ci%2),p,'Inventory',iv].join('\t'));
          } }
      }
      importText(LL.join('\n'),'perf gate'); computeAll();
      const cyP=F.periodY(store.maxPeriod);
      state.ui.tab='pv'; state.ui.pvSrc='fsd'; state.ui.pv2View='country'; state.ui.pv2Gran='month'; state.ui.pv2Open={};
      state.ui.pv2Yrs={}; state.ui.pv2Yrs[cyP]=1; state.ui.pv2Yrs[cyP+1]=1; state.ui.pv2C=''; state.ui.pv2L=''; state.ui.pv2Q='';
      const tR0=performance.now(); render(); const ebP=$('#pv2Exp'); if(ebP&&ebP.onclick)ebP.onclick(); const msRender=Math.round(performance.now()-tR0);
      const idxP=window.__pv2NodeIdx;
      const soCells=Array.prototype.slice.call(document.querySelectorAll('#view-pv td[data-pv2k="so"]'));
      let tdLeaf=null,tdProd=null;
      soCells.forEach(function(td){ const nd2=idxP[td.dataset.pv2n]; if(!nd2)return; const v=F.parseCellNum(td.textContent);
        if(!tdLeaf&&nd2.items.length===1&&v>=10)tdLeaf=td;
        if(!tdProd&&nd2.depth===2&&v>=10)tdProd=td; });
      const tapT=function(td,val){ td.dataset.orig=td.textContent; td.textContent=String(val);
        const t0p=performance.now(); td.dispatchEvent(new Event('blur')); return Math.round(performance.now()-t0p); };
      const warm=tdProd?tapT(tdProd,'22222'):null;              // 第一次含建索引/冷缓存
      const msLeaf=tdLeaf?tapT(tdLeaf,'333'):null;
      const incL=window.__incStat?{computed:window.__incStat.computed,reused:window.__incStat.reused}:null;
      const msProd=tdProd?tapT(tdProd,'44444'):null;
      const nCells=document.querySelectorAll('#view-pv td[data-pv2n][data-pv2b]').length;
      /* 粘贴外部表格(2026-09-02 用户:复制外面的表格数据进去也很慢):5 行×4 列走真实 paste 事件 */
      let msPaste=null,nPaste=null;
      (function(){
        const soc=Array.prototype.slice.call(document.querySelectorAll('#view-pv td[data-pv2k="so"]'));
        const st=soc[0]; if(!st)return;
        const ls=[]; for(let r2=0;r2<5;r2++){ const a2=[]; for(let c2=0;c2<4;c2++)a2.push(String(90000+r2*7+c2)); ls.push(a2.join(String.fromCharCode(9))); }
        st.focus();
        const ev=new Event('paste',{bubbles:true,cancelable:true});
        ev.clipboardData={getData:function(){ return ls.join(String.fromCharCode(10)); }};
        const t0v=performance.now(); st.dispatchEvent(ev); msPaste=Math.round(performance.now()-t0v); nPaste=20;
      })();
      perfOk=!!(msLeaf!=null&&msProd!=null&&msLeaf<60&&msProd<60&&incL&&incL.computed===1&&msPaste!=null&&msPaste<400);
      tms.perfTap={units:store.units.size,cells:nCells,nodes:Object.keys(idxP).length,
        msRender:msRender,msWarm:warm,msLeaf:msLeaf,msProd:msProd,msPaste20:msPaste,incLeaf:incL};
    }catch(e){ tms.perfTap='ERR:'+String(e&&e.message||e).slice(0,160); }
    /* 门禁 pendGroupOk(2026-09-04 用户:待确认太多、不知道原因在哪):分组必须不重不漏地覆盖全部待确认项;
       「自动采纳平销」开关打开后,今年数据够的那些必须从待确认里消失且推演不再为 0(digest 会变,故只在此临时开关并还原)。 */
    let pendGroupOk=false;
    sfStep('pendGroup begin');
    try{
      /* 夹具本身没有待确认项 → 把自动判定门槛临时拉满,强行造出一批,才能真的验到分组与开关(结束还原) */
      const cfg0={h:state.cfg.minHistWeeks,c:state.cfg.minRefCov};
      state.cfg.minHistWeeks=999; state.cfg.minRefCov=1.01; computeAll();
      const pd=pendingList();
      const cnt={}; PEND_GROUPS.forEach(function(g){ cnt[g[0]]=0; });
      let unknown=0;
      pd.forEach(function(it){ const g=pendGroupOf(it); if(cnt[g]==null)unknown++; else cnt[g]++; });
      let sum=0; Object.keys(cnt).forEach(function(k){ sum+=cnt[k]; });
      const flatN=pd.filter(canFlatOf).length;
      /* 开关冒烟:打开 → 可平销的那些不再待确认、今年剩余周不再全 0;随后还原 */
      const before=pd.length;
      state.cfg.autoFlat=true; computeAll();
      const after=pendingList().length;
      const autoItems=D.list.filter(function(it){ return it.dec&&it.dec.auto; });
      const nonZero=autoItems.filter(function(it){ return (it.sim&&!it.sim.blocked&&(it.sim.rows||[]).some(function(r){ return (r.so||0)>0; })); }).length;
      state.cfg.autoFlat=false; computeAll();
      const restored=pendingList().length;
      /* 断言:①分组不重不漏 ②开关打开后可平销的那些不再待确认 ③它们今年剩余周不再被推成 0 ④关掉后完全还原 */
      pendGroupOk=unknown===0&&sum===before&&restored===before&&before>0&&flatN>0
        &&after===before-flatN&&autoItems.length===flatN&&nonZero>0;
      tms.pendGroup={total:before,groups:cnt,canFlat:flatN,afterSwitch:after,autoItems:autoItems.length,autoNonZero:nonZero,restored:restored};
      state.cfg.minHistWeeks=cfg0.h; state.cfg.minRefCov=cfg0.c; computeAll();
    }catch(e){ tms.pendGroup='ERR:'+String(e&&e.message||e).slice(0,160); }
    (function(){ const c=calcCache(); delete c.budTo; delete c.budOv; delete c.pvExt; delete c.lyModels; })();
    sfStep('pendGroup done');
    window.__soToolOff=__soSnap.off; if(SHELL&&SHELL.soTool){ state.cfg.autoFlat=__soSnap.autoFlat; }
    return {ok:!!okScan&&!!store&&store.units.size>0&&!!okRetail&&!!Dr&&Dr.list.length>0&&!!okAudio&&!!Da&&Da.list.length>0&&persistOk&&unitTapOk&&qEqOk&&roundStepOk&&pendGroupOk&&!!window.__channelsOk&&!!window.__pvModesOk&&!!window.__monitorOk&&!!window.__reconMoveOk&&!!window.__rulesOk&&!!window.__viewNavOk&&!!window.__soToolOk&&lineageOk&&smSimOk&&sumWatchOk&&expPrevOk&&targetOk&&btOk&&engOk&&budOk&&mkOk&&lockOk&&xgOk&&aiOk&&pvOk&&udOk&&osOk&&npPvOk&&npLateOk&&reconOk&&ctOk&&xgPvOk&&incOk&&dosQOk&&finOk&&tapAuditOk&&perfOk,
      incOk:incOk,dosQOk:dosQOk,finOk:finOk,tapAuditOk:tapAuditOk,perfOk:perfOk,smSimOk:smSimOk,sumWatchOk:sumWatchOk,expPrevOk:expPrevOk,targetOk:targetOk,btOk:btOk,mkOk:mkOk,lockOk:lockOk,xgOk:xgOk,aiOk:aiOk,pvOk:pvOk,udOk:udOk,osOk:osOk,npPvOk:npPvOk,npLateOk:npLateOk,reconOk:reconOk,ctOk:ctOk,xgPvOk:xgPvOk,
      viewDigests:viewDigests, exportDigests:exportDigests, unitTapOk:unitTapOk, qEqOk:qEqOk, roundStepOk:roundStepOk, pendGroupOk:pendGroupOk, channelsOk:!!window.__channelsOk, pvModesOk:!!window.__pvModesOk, monitorOk:!!window.__monitorOk, reconMoveOk:!!window.__reconMoveOk, rulesOk:!!window.__rulesOk, viewNavOk:!!window.__viewNavOk, soToolOk:!!window.__soToolOk, lineageOk:lineageOk,
      units:store?store.units.size:0, maxPeriod:store?store.maxPeriod:0, pend:pendingList().length,
      files:folderInfo&&folderInfo.files?folderInfo.files.length:0,
      retailUnits:retailStore?retailStore.units.size:0,
      audioUnits:audioStore?audioStore.units.size:0,
      monthEnds:Dr?Dr.monthEnds.map(function(x){return x.p;}):[],
      persistOk:persistOk, stateFromFile:stateLoadedFromFile,
      userData:SHELL_PATHS&&SHELL_PATHS.userData||null,
      timings:tms,
      coreOk:!!window.FsdCore,engOk:engOk,budOk:budOk,version:window.APP_VER||''};
  }catch(e){ return {ok:false,error:String(e&&e.stack||e)}; }
};
async function boot(){
  xgInit();   // Excel 式表格交互层(全局一次接线)
  document.querySelectorAll('nav button[data-tab]').forEach(function(b){
    b.onclick=function(){ state.ui.tab=b.dataset.tab; render(); }; });
  const aiNav=document.getElementById('btnAiNav');
  if(aiNav)aiNav.onclick=function(){ aiToggleDock(); };
  aiApplyNavLang();
  applyTheme();
  const tb=document.getElementById('btnTheme');
  if(tb)tb.onclick=function(){
    const order=['auto','light','dark'];
    const cur=order.indexOf(state.theme||'auto');
    state.theme=order[(cur+1)%order.length];
    applyTheme(); saveState(); render();
  };
  $('#btnParse').onclick=function(){
    const t=$('#paste').value;
    if(importText(t,'粘贴数据')){ state.ui.tab='channels'; state.ui.clSrc='fsd'; render(); } };
  $('#btnParse2').onclick=function(){
    const t=$('#paste').value;
    if(importRetailText(t,'粘贴的下游渠道表')){ state.ui.tab='channels'; state.ui.clSrc='retail'; render(); }
    else { renderData(); } };
  $('#btnSample').onclick=function(){
    const ok1=importText(F.genSampleTSV(),'内置示例数据');
    importRetailText(F.genRetailSampleTSV(),'内置下游示例数据');
    importAudioText(F.genAudioSampleTSV(),'内置音频专表示例数据');
    if(ok1){ state.ui.tab='channels'; state.ui.clSrc='fsd'; render(); } };
  $('#file').onchange=async function(){
    if(!this.files.length)return;
    const txt=await readFileSmart(this.files[0]);
    if(importText(txt,'文件 '+this.files[0].name)){ state.ui.tab='channels'; state.ui.clSrc='fsd'; render(); }
    this.value=''; };
  $('#btnClear').onclick=async function(){
    if(!confirm('清空数据与全部推演设置？（会先自动留一份备份到 backups 目录）'))return;
    try{ localStorage.removeItem(LS_STATE); localStorage.removeItem(LS_DATA); localStorage.removeItem(LS_DATA2); }catch(e){}
    if(SHELL&&SHELL.stateClear){ try{ await SHELL.stateClear(); }catch(e){} }
    location.reload(); };
  $('#btnExport').onclick=function(){
    const out={decisions:state.decisions,growth:state.growth,ovSO:state.ovSO,ovSI:state.ovSI,
      kedit:state.kedit,lineParams:state.lineParams,cfg:state.cfg};
    const a=document.createElement('a');
    a.href='data:application/json;charset=utf-8,'+encodeURIComponent(JSON.stringify(out,null,1));
    a.download='FSD推演方案.json'; a.click(); };
  $('#fileScheme').onchange=async function(){
    if(!this.files.length)return;
    try{
      const o=JSON.parse(await this.files[0].text());
      ['decisions','growth','ovSO','ovSI','kedit','lineParams','cfg'].forEach(function(k){
        if(o[k])state[k]=o[k]; });
      recompute();
      alert('方案已导入');
    }catch(e){ alert('导入失败：'+e.message); }
    this.value=''; };
  progShow(10,'读取推演方案…'); await progTick();
  /* 恢复:文件优先(userData,升级换 exe 不丢);文件没有时读 localStorage(含旧版本自动迁移) */
  let restored=null;
  if(SHELL&&SHELL.stateLoad){
    try{ const r=await SHELL.stateLoad();
      if(r&&r.ok&&r.state){ restored=r.state; stateLoadedFromFile=true; } }catch(e){}
  }
  if(!restored){ try{ const s=localStorage.getItem(LS_STATE); if(s)restored=JSON.parse(s); }catch(e){} }
  if(restored){ Object.keys(state).forEach(function(k){ if(restored[k]!=null)state[k]=restored[k]; }); }
  if(SHELL&&SHELL.getPaths){ try{ SHELL_PATHS=await SHELL.getPaths(); }catch(e){} }
  state.ui=Object.assign({},UI_DEFAULTS,state.ui||{});   // 旧版本存档缺新键时补默认
  /* kedit 旧格式迁移:裸产品线键 → 'L|'+线 */
  Object.keys(state.kedit).forEach(function(k){
    if(!/^(CP|[LCAP])\|/.test(k)){ state.kedit['L|'+k]=state.kedit[k]; delete state.kedit[k]; } });
  if(!state.exempt)state.exempt={global:100,line:{},model:{}};
  if(!state.exempt.line)state.exempt.line={};
  if(!state.exempt.model)state.exempt.model={};
  if(!state.glide)state.glide={m10:100,m11:70,m12:50,useLastYear:true};
  if(!state.ignored)state.ignored={};
  if(!state.channelAlias)state.channelAlias={};
  if(state.showRetailAudio==null)state.showRetailAudio=false;
  if(state.cfg.tailWeeks==null)state.cfg.tailWeeks=12;
  if(state.cfg.roundTo===1)state.cfg.roundTo=5;   // 2026-09-01 二次拍板:推演值要像手拍的,统一 5 台取整(V34 曾误改成 1 台,老档自动迁回)
  if(!state.buyMode)state.buyMode={};
  if(state.cfg.blHead==null)state.cfg.blHead=8;
  if(state.cfg.blKappa==null)state.cfg.blKappa=1.25;
  if(!state.riskSel)state.riskSel={fsd:{},retail:{},audio:{}};
  ['fsd','retail','audio'].forEach(function(k){ if(!state.riskSel[k])state.riskSel[k]={}; });
  if(!state.watch)state.watch={fsd:{},retail:{},audio:{}};
  ['fsd','retail','audio'].forEach(function(k){ if(!state.watch[k])state.watch[k]={}; });
  if(!state.watchBase)state.watchBase={};
  if(!state.watch.sum)state.watch.sum={};
  if(!state.riskSel.sum)state.riskSel.sum={};
  if(!state.ecom)state.ecom={};
  if(!state.expTpl)state.expTpl={};
  if(!state.famBase)state.famBase={};
  /* 首次(基线为空)自动带入用户拍板的默认基线;之后完全由设置页自管,清空不回填 */
  if(!Object.keys(state.famBase).length)Object.assign(state.famBase,FAM_BASE_DEF);
  if(!state.chanClass)state.chanClass={};
  if(!state.chanProp)state.chanProp={};
  if(!state.chanTree)state.chanTree={};
  if(!state.chanType)state.chanType={};
  if(!state.chanTreeLine)state.chanTreeLine={};
  if(!state.chanTypeLine)state.chanTypeLine={};
  if(!state.lifecycle)state.lifecycle={};
  if(!state.chanPromo)state.chanPromo={};
  if(!state.chanPromoDeny)state.chanPromoDeny={};
  if(!Array.isArray(state.newProducts))state.newProducts=[];
  if(!state.rrp)state.rrp={};
  if(!state.budgetName)state.budgetName={};
  if(!state.finParams)state.finParams={};
  if(!state.finCountry)state.finCountry={};
  if(!state.ovTail)state.ovTail={};
  if(!state.lockQty)state.lockQty={};
  if(!state.burst)state.burst={};
  if(!state.blOv)state.blOv={};
  if(!state.modelGrowth)state.modelGrowth={};
  if(!state.countryShare)state.countryShare={};
  if(!state.ovExt)state.ovExt={};   // 外推年(明年起)手工拍数覆盖:单元键→{"YYYY-M":{so,si}}
  if(!state.ai)state.ai={provider:'lmstudio'};   // 默认本机 LM Studio(2026-09-04 D13:数据不出本机;在线服务首次使用弹确认)
  /* V28→V29 迁移:旧单端点配置映射到多提供方形状 */
  if(state.ai.baseUrl&&!state.ai.provider){
    const b=String(state.ai.baseUrl);
    if(state.ai.fmt==='anthropic'){ state.ai.provider='anthropic'; state.ai.anKey=state.ai.key||''; state.ai.anModel=state.ai.model||''; }
    else if(/127\.0\.0\.1|localhost/.test(b)){ state.ai.provider='lmstudio';
      state.ai.lmBase=b.replace(/\/chat\/completions\/?$/,''); state.ai.lmModel=state.ai.model||''; }
    else if(/deepseek/.test(b)){ state.ai.provider='deepseek'; state.ai.dsKey=state.ai.key||''; state.ai.dsModel=state.ai.model||'deepseek-chat'; }
    else { state.ai.provider='minimax'; }
  }
  if(!state.ai.provider)state.ai.provider='deepseek';
  /* 旧电渠标记(ecom[acct]=1)迁移为渠道属性 type:'ecom' */
  if(state.ecom&&Object.keys(state.ecom).length){
    Object.keys(state.ecom).forEach(function(a){
      if(!state.chanProp[a])state.chanProp[a]={type:'ecom'};
      else if(!state.chanProp[a].type)state.chanProp[a].type='ecom';
    });
    state.ecom={};
  }
  if(!state.bigGrowth)state.bigGrowth={global:null,line:{},family:{}};
  if(!state.bigGrowth.line)state.bigGrowth.line={};
  if(!state.bigGrowth.family)state.bigGrowth.family={};
  if(!state.promoCal)state.promoCal={};
  if(state.useBaseline==null)state.useBaseline=false;
  if(state.cfg.blHead==null)state.cfg.blHead=8;
  if(state.cfg.blKappa==null)state.cfg.blKappa=1.25;
  if(state.folder4==null)state.folder4='';
  if(!state.dosRed)state.dosRed={def:{red:200,amber:150},
    m:{9:{red:200,amber:150},10:{red:100,amber:85},11:{red:70,amber:60},12:{red:50,amber:45}}};
  /* 2026-08-26 用户拍板:9月底红线 200;仅当存档仍为旧默认(150/120)时升级,手改过的值不动 */
  if(state.dosRed.m&&state.dosRed.m[9]&&state.dosRed.m[9].red===150&&state.dosRed.m[9].amber===120)
    state.dosRed.m[9]={red:200,amber:150};
  /* 旧存档单选(字符串)→多选(数组) */
  ['country','acct','line','rcC','rcCh','rcL','meLine','smLine','auC','auA','fCls','tgRep','tgC','tgL'].forEach(function(k){
    const v=state.ui[k];
    if(typeof v==='string')state.ui[k]=v?[v]:[];
    if(!Array.isArray(state.ui[k]))state.ui[k]=[];
  });
  /* 旧三页已并入「渠道清单」:老档里存的页签名映射过去(2026-09-04 阶段4a);legacyTabs 打开时才允许停在旧页 */
  if(!state.ui.legacyTabs&&['overview','retail','audio'].indexOf(state.ui.tab)>=0){ state.ui.clSrc=state.ui.tab==='overview'?'fsd':state.ui.tab; }
  /* 推演明细/汇总/月末DOS 已并入推演编辑的模式(2026-09-10 阶段4b) */
  if(!state.ui.legacyTabs&&['detail','summary','monthend'].indexOf(state.ui.tab)>=0){ state.ui.pvMode=state.ui.tab; state.ui.tab='pv'; }
  /* 监控/SO目标 已并入「监控与目标」(2026-09-10 阶段4c) */
  if(!state.ui.legacyTabs&&['watch','targets'].indexOf(state.ui.tab)>=0){ state.ui.monTab=state.ui.tab; state.ui.tab='monitor'; }
  /* 设置/系数与参数 已并入「规则与模型」(2026-09-10 阶段4e) */
  if(!state.ui.legacyTabs&&['settings','coef'].indexOf(state.ui.tab)>=0){ state.ui.rulesTab=state.ui.tab; state.ui.tab='rules'; }
  if(['pv','monitor','rules','master','fin','confirm','chantree','newprod','data'].indexOf(state.ui.tab)<0)state.ui.tab='confirm';   // 默认落工作台·待办(2026-09-10 阶段4.5)
  bindViewNav();
  if(!state.ui.clSrc)state.ui.clSrc='fsd';
  if(state.ui.legacyTabs)document.body.classList.add('legacyTabs');
  if(soTool()){
    document.body.classList.add('soTool'); document.title='SO 推演';
    const h1=document.querySelector('h1'); if(h1&&h1.firstChild&&h1.firstChild.nodeType===3)h1.firstChild.textContent='SO 推演';
    if(!state.cfg.__soInit){ state.cfg.autoFlat=true; state.cfg.__soInit=1; }   // SO 工具默认:今年数据够就用平销
    if(['pv','confirm','channels','rules','data'].indexOf(state.ui.tab)<0)state.ui.tab='pv';
  }
  if(SHELL&&SHELL.onProgress){ SHELL.onProgress(function(d){
    const el=document.getElementById('folderStatus-'+activeScanKind);
    if(el)el.textContent='解析中 '+d.i+'/'+d.n+'：'+d.file;
    const dl=document.getElementById('dataline'); if(dl)dl.textContent='解析文件 '+d.i+'/'+d.n+'…';
    if(scanProg&&d.n>0){
      /* 文件解析占区段前 88%,合并重算占后 12%(与 scanFolderKind 的 0.88 对应) */
      progShow(scanProg.base+((d.i-1)/d.n)*scanProg.span*0.88,
        scanProg.label+'：解析 '+d.file+'（'+d.i+'/'+d.n+'，'+Math.round(d.i/d.n*100)+'%）');
    }
  }); }
  if(state.ui.zoom&&state.ui.zoom!==1)applyZoom(state.ui.zoom,true);
  progShow(20,'读取本机数据缓存…'); await progTick();
  let data=null,data2=null,data3=null,data4=null;
  if(SHELL&&SHELL.dataLoad){
    try{ const rd=await SHELL.dataLoad();
      if(rd&&rd.ok){ data=rd.fsd||null; data2=rd.retail||null; data3=rd.audio||null; data4=rd.target||null; } }catch(e){}
  }
  if(data==null){ try{ data=localStorage.getItem(LS_DATA); }catch(e){} }
  if(data2==null){ try{ data2=localStorage.getItem(LS_DATA2); }catch(e){} }
  if(data3==null){ try{ data3=localStorage.getItem(LS_DATA3); }catch(e){} }
  saveState();   // 迁移/升级后立即把方案落盘成文件
  let progDeferred=false;   // 自动扫描分支在异步闭包里收遮罩,boot 主线不收
  if(SHELL&&state.autoScan&&(state.folder||state.folder2||state.folder3)){
    progDeferred=true;
    render();
    (async function(){
      const kinds=[];
      if(state.folder)kinds.push('fsd');
      if(state.folder2)kinds.push('retail');
      if(state.folder3)kinds.push('audio');
      if(state.folder4)kinds.push('target');
      const span=72/kinds.length;
      let ok1=false;
      try{
        for(let i=0;i<kinds.length;i++){
          scanProg={base:24+i*span,span:span,label:SCAN_LABELS[kinds[i]]};
          const ok=await scanFolderKind(kinds[i]);
          if(kinds[i]==='fsd')ok1=ok;
          scanProg=null;
        }
        progShow(97,'恢复本机缓存数据…'); await progTick();
        if(!ok1&&!store){
          if(data)importText(data,'本机已保存数据');
          else importText(F.genSampleTSV(),'内置示例数据（FSD 文件夹未配置或扫描失败）');
        }
        if(!retailStore&&data2) importRetailText(data2,'本机已保存下游数据');
        if(!audioStore&&data3) importAudioText(data3,'本机已保存音频专表数据');
        if(!targetRows&&data4) importTargetText(data4,'本机已保存 SO 目标数据');
        progShow(99,'渲染看板…'); await progTick();
        render();
      } finally { progHide(); }
    })();
  }
  else if(data||data2||data3||data4){
    progShow(45,'解析本机已保存数据…'); await progTick();
    if(data)importText(data,'本机已保存数据');
    if(data2)importRetailText(data2,'本机已保存下游数据');
    if(data3)importAudioText(data3,'本机已保存音频专表数据');
    if(data4)importTargetText(data4,'本机已保存 SO 目标数据');
  }
  else {
    progShow(60,'载入内置示例数据…'); await progTick();
    importText(F.genSampleTSV(),'内置示例数据（首次打开自动载入）');
    importRetailText(F.genRetailSampleTSV(),'内置下游示例数据');
    importAudioText(F.genAudioSampleTSV(),'内置音频专表示例数据');
  }
  if(!progDeferred){ progShow(94,'渲染看板…'); await progTick(); }
  render();
  if(!progDeferred)progHide();
  if(bootDoneResolve)bootDoneResolve();
  /* 空闲预热:数据就绪后用空闲时间预建 明年+后年 外推基表(budTo),首次打开多年视图/AI 明年问答零等待 */
  const idle=window.requestIdleCallback||function(fn){ return setTimeout(fn,800); };
  idle(function(){
    try{
      if(store&&store.units.size){
        const cy=F.periodY(store.maxPeriod);
        budgetRowsOv(cy+2);
      }
    }catch(e){}
  });
}
boot().catch(function(e){
  /* 启动任何异常都必须收掉遮罩,否则表现为整软件假死 */
  try{ progHide(); }catch(e2){}
  const dl=document.getElementById('dataline');
  if(dl)dl.textContent='启动异常：'+String(e&&e.message||e);
});
})();
