/* ===== 数据 ===== */
function fmtTime(ms){ const d=new Date(ms);
  return d.getFullYear()+'/'+(d.getMonth()+1)+'/'+d.getDate()+' '+String(d.getHours()).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0'); }
const FOLDER_KINDS={
  fsd:{ folderKey:'folder', title:'FSD 底表文件夹（Management Account 表,自动识别 xlsx / xls / csv）',
        hint:'未选择：将系统导出的 FSD 底表放入固定文件夹即可' },
  retail:{ folderKey:'folder2', title:'下游渠道底表文件夹（Channel Name(R) 表,Purchase / Sell Out / Inventory1 / DOS1）',
        hint:'未选择：下游渠道底表请使用独立文件夹，与 FSD 底表分开存放' },
  audio:{ folderKey:'folder3', title:'音频专表文件夹（Management Account 直接客户口径,只含音频;格式同 FSD 表）',
        hint:'未选择：音频专表（报量制口径）请单独存放于独立文件夹' },
  target:{ folderKey:'folder4', title:'国家 SO 目标回填表文件夹（宽表:渠道×产品,识别 产品/国家/渠道/原始渠道名 与 9–12月SO目标 列）',
        hint:'未选择：发给国家回填后的 SO 目标表请单独存放；库存/DOS 快照列忽略,以软件当前底表复算' }
};
function folderInfoOf(kind){ return kind==='fsd'?folderInfo:(kind==='retail'?folderInfo2:(kind==='audio'?folderInfo3:folderInfo4)); }
function setFolderInfo(kind,v){ if(kind==='fsd')folderInfo=v; else if(kind==='retail')folderInfo2=v; else if(kind==='audio')folderInfo3=v; else folderInfo4=v; }
function folderPanelHtml(kind){
  const K=FOLDER_KINDS[kind], info=folderInfoOf(kind), dir=state[K.folderKey];
  let h='<div class="panel"><h3>'+K.title+'</h3>'
    +'<div class="bar"><button class="act" data-act="pick" data-kind="'+kind+'">选择文件夹</button>'
    +'<button class="ghost" data-act="rescan" data-kind="'+kind+'"'+(dir?'':' disabled')+'>重新扫描</button>'
    +(kind==='fsd'?'<label><input type="checkbox" id="autoScanChk"'+(state.autoScan?' checked':'')+'> 启动时自动扫描两个文件夹</label>':'')
    +'</div>'
    +'<div class="note">'+(dir?esc(dir):K.hint)+'</div>'
    +'<div id="folderStatus-'+kind+'" class="note"></div>';
  if(info&&info.error) h+='<div style="color:var(--warn);font-size:13px;margin-top:6px">❌ '+esc(info.error)+'</div>';
  if(info&&info.files){
    h+='<div class="tblwrap" style="max-height:30vh;margin-top:8px"><table><thead><tr>'
      +'<th class="l">文件</th><th class="l">修改时间</th><th>大小</th><th>读入行</th><th>覆盖旧文件</th><th class="l">Sheet</th><th class="l">问题</th></tr></thead><tbody>';
    info.files.forEach(function(f){
      const bad=(f.badPeriod||0)+(f.badPsi||0)+(f.noKey||0);
      h+='<tr><td class="l ell" title="'+esc(f.name)+'">'+esc(f.name)+'</td>'
        +'<td class="l muted">'+fmtTime(f.mtimeMs)+'</td>'
        +'<td>'+(f.size>1048576?(f.size/1048576).toFixed(1)+'MB':Math.round(f.size/1024)+'KB')+'</td>'
        +'<td>'+F.fmt(f.used)+'</td>'
        +'<td>'+(f.overridden?F.fmt(f.overridden)+' 格':'—')+'</td>'
        +'<td class="l muted">'+esc((f.sheets||[]).join(', '))+'</td>'
        +'<td class="l" style="color:var(--warn)">'+(f.error?esc(f.error):(bad?('跳过'+bad+'行'):''))
          +(f.psiTypes?'<div class="muted" style="color:var(--sub);font-size:11px" title="每种 PSI Type 原文映射到软件字段:so=渠道总SO(TTL) · so1=直接客户自有SO(单独存,不参与推演) · si=SI/Purchase · inv/inv1=库存 · ✗=未识别已丢弃">PSI: '+Object.keys(f.psiTypes).map(function(k){ const bad2=/→✗$/.test(k); return (bad2?'<b style="color:var(--warn)">':'')+esc(k)+' '+f.psiTypes[k]+(bad2?'</b>':''); }).join(' · ')+'</div>':'')
          +'</td></tr>';
    });
    h+='</tbody></table></div>';
  }
  if(kind==='retail'&&retailReport)h+='<div class="note" style="margin-top:6px">'+esc(retailReport)+'</div>';
  if(kind==='audio'&&audioReport)h+='<div class="note" style="margin-top:6px">'+esc(audioReport)+'</div>';
  h+='</div>';
  return h;
}
function renderData(){
  const host=$('#folderHost');
  if(!host)return;
  if(!SHELL){
    host.innerHTML='<div class="panel note">浏览器模式：文件夹自动导入仅在 exe 里可用；这里可用下方粘贴/文件方式，FSD 表与下游表分别载入。</div>';
    return;
  }
  host.innerHTML=folderPanelHtml('fsd')+folderPanelHtml('retail')+folderPanelHtml('audio')+folderPanelHtml('target')
    +'<div class="note" style="margin:0 2px 12px">同一 账户×型号×周×指标 出现在多个文件时，以<b>修改时间较新</b>的文件为准；同一文件内重复行相加。'
    +'SO 目标回填表按 国家×渠道×产品 去重，新文件覆盖旧文件。</div>';
  host.querySelectorAll('button[data-act]').forEach(function(b){
    const kind=b.dataset.kind;
    if(b.dataset.act==='pick')b.onclick=async function(){
      const dir=await SHELL.pickFolder();
      if(!dir)return;
      state[FOLDER_KINDS[kind].folderKey]=dir; saveState(); scanFolderKind(kind);
    };
    else b.onclick=function(){ scanFolderKind(kind); };
  });
  const chk=$('#autoScanChk');
  if(chk)chk.onchange=function(){ state.autoScan=this.checked; saveState(); };
}
const SCAN_LABELS={fsd:'FSD 底表',retail:'下游渠道底表',audio:'音频专表',target:'SO 目标回填表'};
async function scanFolderKind(kind){
  const K=FOLDER_KINDS[kind];
  if(!SHELL||!state[K.folderKey])return false;
  activeScanKind=kind;
  const ownProg=!scanProg;
  if(ownProg)scanProg={base:0,span:100,label:SCAN_LABELS[kind]||'底表'};
  const seg=scanProg;
  try{
    progShow(seg.base,seg.label+'：扫描文件夹…'); await progTick();
    setFolderInfo(kind,{scanning:true});
    const st0=$('#folderStatus-'+kind); if(st0)st0.textContent='扫描中…';
    $('#dataline').textContent='扫描文件夹…';
    let res;
    try{ res=await SHELL.readFolder(state[K.folderKey],kind==='target'?'target':undefined); }
    catch(e){ res={ok:false,error:String(e&&e.message||e)}; }
    if(!res.ok){
      setFolderInfo(kind,{error:res.error});
      state.ui.tab='data';
      render(); renderData();
      return false;
    }
    setFolderInfo(kind,{files:res.files,total:res.total,at:Date.now()});
    progShow(seg.base+seg.span*0.88,seg.label+'：合并数据并重算模型…'); await progTick();
    let okRows;
    if(kind==='target'){
      okRows=importTargetRows(res.rows,'SO 目标文件夹（'+res.files.length+' 个文件）');
    } else if(kind==='fsd'){
      rawText=''; saveData();
      okRows=importRows(res.rows,'FSD 文件夹（'+res.files.length+' 个文件合并）');
    } else if(kind==='audio'){
      rawText3=''; saveData3();
      okRows=importAudioRows(res.rows,'音频专表文件夹（'+res.files.length+' 个文件合并）');
    } else {
      rawText2=''; saveData2();
      okRows=importRetailRows(res.rows,'下游文件夹（'+res.files.length+' 个文件合并）');
    }
    progShow(seg.base+seg.span,seg.label+'：完成');
    renderData();
    return okRows;
  } finally { if(ownProg)progHide(); }
}
let lastRetailRows=null;   // 原始下游行(含 rawAccount),渠道改名时就地重放
function importRetailRows(rows,label){
  if(!rows||!rows.length){
    retailReport='❌ '+label+'：'+(parsed.report&&parsed.report.error?parsed.report.error:'没有解析到任何有效行')+'（已有下游数据保持不动）';
    const rp=$('#report'); if(rp)rp.textContent=retailReport;
    return false;    // 非空才覆盖:解析失败不清已有数据
  }
  bumpDataGen();
  const mapRes=F.applyChannelMap(rows,state.channelAlias);
  lastRetailRows=rows;
  retailStore=F.buildStore(rows,{retail:true});
  retailReport='✅ '+label+'：有效数据 '+F.fmt(rows.length)+' 行 · 渠道×产品单元 '+retailStore.units.size+' 个 · 区间 '
    +F.periodY(retailStore.minPeriod)+F.weekLabel(retailStore.minPeriod)+' ~ '+F.periodY(retailStore.maxPeriod)+F.weekLabel(retailStore.maxPeriod)
    +(mapRes.unmapped?' · 未映射渠道 '+mapRes.names.length+' 个（'+mapRes.names.slice(0,3).join('、')+(mapRes.names.length>3?'…':'')+'，按原名显示）':'');
  const rp=$('#report'); if(rp)rp.textContent=retailReport;
  recompute();
  return true;
}
function importAudioRows(rows,label){
  if(!rows||!rows.length){
    audioReport='❌ '+label+'：'+(parsed.report&&parsed.report.error?parsed.report.error:'没有解析到任何有效行')+'（已有音频专表数据保持不动）';
    const rp=$('#report'); if(rp)rp.textContent=audioReport;
    return false;
  }
  bumpDataGen();
  audioStore=F.buildStore(rows);   // INV/INV1 语义同 FSD 表,账户=直接渠道客户
  audioReport='✅ '+label+'：有效数据 '+F.fmt(rows.length)+' 行 · 客户×产品单元 '+audioStore.units.size+' 个 · 区间 '
    +F.periodY(audioStore.minPeriod)+F.weekLabel(audioStore.minPeriod)+' ~ '+F.periodY(audioStore.maxPeriod)+F.weekLabel(audioStore.maxPeriod);
  const rp=$('#report'); if(rp)rp.textContent=audioReport;
  recompute();
  return true;
}
function importAudioText(text,label){
  const parsed=F.parseTable(text);
  if(!parsed.rows.length){
    audioReport='❌ '+label+'：'+(parsed.report&&parsed.report.error?parsed.report.error:'没有解析到任何有效行')+'（已有音频专表数据保持不动）';
    const rp=$('#report'); if(rp)rp.textContent=audioReport;
    return false;
  }
  rawText3=text;
  const ok3=importAudioRows(parsed.rows,label);
  if(ok3)saveData3();
  return ok3;
}
function importRetailText(text,label){
  const parsed=F.parseTable(text);
  if(!parsed.rows.length){
    retailReport='❌ '+label+'：'+(parsed.report&&parsed.report.error?parsed.report.error:'没有解析到任何有效行')+'（已有下游数据保持不动）';
    const rp=$('#report'); if(rp)rp.textContent=retailReport;
    return false;
  }
  rawText2=text;
  const ok2=importRetailRows(parsed.rows,label);
  if(ok2)saveData2();
  return ok2;
}
/* FSD 渠道类别别名:以 rawAccount 起算幂等重放(与下游 channelAlias 同思路) */
function applyChanAlias(rows){
  return rows.map(function(r){
    const raw=r.rawAccount||r.account;
    const cc=state.chanClass[raw];
    if(cc&&cc.alias&&cc.alias!==raw)
      return Object.assign({},r,{rawAccount:raw,account:cc.alias});
    if(r.rawAccount)return r;
    return Object.assign({},r,{rawAccount:raw});
  });
}
/* 渠道改名后迁移手工设置键(键=国家::账户::型号,账户在中段) */
function migrateAccountKeys(oldA,newA){
  const mig=function(bag){ if(!bag)return;
    Object.keys(bag).forEach(function(k){
      const parts=k.split(F.SEP);
      if(parts.length===3&&parts[1]===oldA){
        const nk=parts[0]+F.SEP+newA+F.SEP+parts[2];
        if(bag[nk]==null)bag[nk]=bag[k];
        delete bag[k];
      }
    });
  };
  mig(state.ovSO);mig(state.ovSI);mig(state.decisions);mig(state.growth);mig(state.ignored);mig(state.watchBase);
  mig(state.watch.fsd);mig(state.watch.retail);mig(state.watch.audio);
  mig(state.riskSel.fsd);mig(state.riskSel.retail);mig(state.riskSel.audio);
  migrateNameExtras(oldA,newA);
}
/* 渠道名嵌在非单元键里的迁移:层实例系数微调(A|渠道|产品线)、渠道属性、电渠遗留、汇总监控节点键。
   FSD 类别改名与下游渠道改名两条通道共用。 */
function migrateNameExtras(oldA,newA){
  Object.keys(state.kedit||{}).forEach(function(k){
    if(k.indexOf('A|'+oldA+'|')===0){
      const nk='A|'+newA+k.slice(2+oldA.length);
      if(state.kedit[nk]==null)state.kedit[nk]=state.kedit[k];
      delete state.kedit[k];
    }
  });
  if(state.chanProp&&state.chanProp[oldA]&&!state.chanProp[newA]){
    state.chanProp[newA]=state.chanProp[oldA]; delete state.chanProp[oldA]; }
  const migNk=function(bag,baseBag,basePrefix){
    Object.keys(bag||{}).forEach(function(nk){
      const parts=nk.split('|#|');
      if(parts.length<5||parts[4]!==oldA)return;   // 渠道名只在第 5 段(数据源|线|产品|国家|渠道)
      parts[4]=newA;
      const nn=parts.join('|#|');
      if(bag[nn]==null)bag[nn]=bag[nk];
      delete bag[nk];
      if(baseBag){
        const ob=baseBag[basePrefix+nk];
        if(ob!=null&&baseBag[basePrefix+nn]==null)baseBag[basePrefix+nn]=ob;
        delete baseBag[basePrefix+nk];
      }
    });
  };
  migNk(state.watch.sum,state.watchBase,'sum|');
  migNk(state.riskSel.sum,null,'');
}
/* FSD 渠道类别读取:键=原始账户名(改名后仍以原名寻址) */
function chanClassOf(u){
  const raw=(u.rawNames&&u.rawNames.length)?u.rawNames[0]:u.account;
  return state.chanClass[raw]||state.chanClass[u.account]||null;
}
function chanClsLabel(u){
  const cc=chanClassOf(u);
  return cc&&cc.cls==='fsd'?'真FSD':(cc&&cc.cls==='indirect'?'下游渠道(间接)':'未标记');
}
function importRows(rows,label){
  if(!rows||!rows.length){
    $('#report').textContent='❌ '+label+'：没有解析到任何有效行。检查是否包含 Period ID / PSI Type / QTY 列。';
    return false;
  }
  bumpDataGen();
  lastFsdRows=rows;                 // 原始行留副本:渠道类别改名时就地重放
  store=F.buildStore(applyChanAlias(rows));
  recompute();
  const weeks=[];
  store.units.forEach(function(u){ u.periods.forEach(function(p){ if(weeks.indexOf(p)<0)weeks.push(p); }); });
  $('#report').textContent='✅ '+label+'：有效数据 '+F.fmt(rows.length)+' 行 · 产品单元 '+store.units.size+' 个 · 周数 '+weeks.length+' 个 · 区间 '
    +F.periodY(store.minPeriod)+F.weekLabel(store.minPeriod)+' ~ '+F.periodY(store.maxPeriod)+F.weekLabel(store.maxPeriod);
  return true;
}
function importText(text,label){
  const parsed=F.parseTable(text);
  const rep=parsed.report;
  if(!parsed.rows.length){
    $('#report').textContent='❌ '+(rep.error?rep.error+'（':'没有解析到任何有效行。检查是否包含 Period ID / PSI Type / QTY 列。（')+'共 '+rep.total+' 行：周期无效 '+rep.badPeriod+'，PSI类型无效 '+rep.badPsi+'，缺账户/型号 '+rep.noKey+'）';
    return false;
  }
  rawText=text;
  const psiTxt=rep.psiTypes?(' · PSI 映射: '+Object.keys(rep.psiTypes).map(function(k){ return k+' '+rep.psiTypes[k]+'行'; }).join('；')):'';
  const ok2=importRows(parsed.rows,label+'（读入 '+rep.used+'/'+rep.total+' 行，'+(rep.header?'识别到表头':'无表头按默认列序')+'）'+psiTxt);
  if(ok2)saveData();
  return ok2;
}
async function readFileSmart(file){
  return F.decodeSmart(new Uint8Array(await file.arrayBuffer()));
}

/* ---------- 启动 ---------- */
/* __selftest/__dbg 必须在顶层同步定义:主进程 did-finish-load 就会调用,不能等 async boot */
let bootDoneResolve=null;
const bootDone=new Promise(function(res){ bootDoneResolve=res; });
window.__dbg=function(){ return {D:D,Dr:Dr,Da:Da,state:state,store:store,retailStore:retailStore,audioStore:audioStore}; };
/* 面板截图模式:加载数据→演示性启用平销推演→逐页渲染并报告页高(主进程按页高截整页) */
/* 探针模式(2026-09-02 拍数审计):main.js --probe-file 传入脚本文本;载入夹具(FSD 夹具目录;下游/音频没给目录就用内置样例,与门禁同款)+全量推演后,
   把脚本当 async 函数体执行(参数 ctx),返回值落盘。脚本里可直接引用页面全局词法作用域(state/D/Dr/Da/F/computeAll/render/...) */
window.__probePrep=async function(arg){
  try{
    await bootDone;
    if(!SHELL)return {ok:false,error:'no shell'};
    arg=arg||{};
    state.autoScan=false;
    state.folder=arg.fsd||'';
    const okF=state.folder?await scanFolderKind('fsd'):false;
    let okR,okA;
    if(arg.retail){ state.folder2=arg.retail; okR=await scanFolderKind('retail'); } else okR=importRetailText(F.genRetailSampleTSV(),'probe 下游示例');
    if(arg.audio){ state.folder3=arg.audio; okA=await scanFolderKind('audio'); } else okA=importAudioText(F.genAudioSampleTSV(),'probe 音频示例');
    computeAll();
    const digest=function(){ const out=[]; [D,Dr,Da].forEach(function(Dx,di){ if(!Dx)return; Dx.list.forEach(function(it){
        out.push(di+'|'+it.u.key+'|'+(it.lockScaled!=null?it.lockScaled:'')+'|'+((it.sim&&it.sim.rows)||[]).map(function(r){ return r.p+':'+(r.so||0)+':'+(r.si||0)+':'+(r.buy||0)+':'+(r.inv==null?'':r.inv); }).join(',')); }); });
      out.sort(); return out.join('\n')+'\n'+JSON.stringify(__lockRes||{}); };
    const ctx={
      loaded:{fsd:okF,retail:okR,audio:okA},
      state:state,get store(){return store;},get retailStore(){return retailStore;},get audioStore(){return audioStore;},F:F,
      get D(){return D;},get Dr(){return Dr;},get Da(){return Da;},get Dn(){return Dn;},
      computeAll:computeAll,recompute:recompute,render:render,$:$,budgetRowsOv:budgetRowsOv,pv2ExtByKey:pv2ExtByKey,npDx:npDx,
      lockRes:function(){ return __lockRes; },incStat:function(){ return window.__incStat; },calcLog:function(){ return window.__calcLog; },
      importText:importText,importRetailText:importRetailText,importAudioText:importAudioText,
      distStep:distStep,pv2UKey:pv2UKey,mkNorm:mkNorm,mkKey:mkKey,buildBudgetRows:buildBudgetRows,pushUndo:pushUndo,undoTakeOv:undoTakeOv,
      lockSentOf:lockSentOf,inv1OfMk:inv1OfMk,retailLifePurchaseOf:retailLifePurchaseOf,chanParentOf:chanParentOf,keditOf:keditOf,lineParamsOf:lineParamsOf,
      policyOfCached:policyOfCached,buyAutoOf:buyAutoOf,siCapOf:siCapOf,gDefaultOf:gDefaultOf,blOfCached:blOfCached,eolRhoOf:eolRhoOf,
      xgSelOf:xgSelOf,xgQ:xgQ,pendingList:pendingList,saveState:saveState,bumpDataGen:bumpDataGen,
      gens:function(){ return {dataGen:dataGen,simGen:simGen,ovExtGen:ovExtGen}; },
      digest:digest,undo:undoLast,xgApply:xgApply,xgRestore:function(c){ return window.xgRestoreCells(c); },
      nodeIdx:function(){ return window.__pv2NodeIdx; },bks:function(){ return window.__pv2Bks; },
      tap:function(td,val){ td.dataset.orig=td.textContent; td.textContent=String(val); td.dispatchEvent(new Event('blur')); },
      cells:function(metric,editableOnly){ const sel=editableOnly===false?('#view-pv td[data-pv2n][data-pv2'+((metric==='inv'||metric==='dos')?'m':'k')+'="'+metric+'"],#view-pv td[data-pv2n][data-pv2m="'+metric+'"]'):('#view-pv td[data-pv2k="'+metric+'"]'); return Array.prototype.slice.call(document.querySelectorAll(sel)); },
      cellOf:function(nodeKey,bkey,metric){ let out=null; document.querySelectorAll('#view-pv td[data-pv2b="'+bkey+'"]').forEach(function(td){ if(out)return; if(td.dataset.pv2n!==nodeKey)return; if(td.dataset.pv2k===metric||td.dataset.pv2m===metric)out=td; }); return out; },
      showPv:function(o){ o=o||{}; state.ui.tab='pv'; state.ui.pvSrc=o.src||'fsd'; state.ui.pv2View=o.view||'country'; state.ui.pv2Gran=o.gran||'month'; state.ui.pv2Open={};
        const cy=F.periodY(store.maxPeriod); state.ui.pv2Yrs={}; (o.years||[cy,cy+1]).forEach(function(y){ state.ui.pv2Yrs[y]=1; }); state.ui.pv2C=o.country||''; state.ui.pv2L=o.line||''; state.ui.pv2Q=o.q||''; render();
        if(o.expand!==false){ const eb=$('#pv2Exp'); if(eb&&eb.onclick)eb.onclick(); } return window.__pv2NodeIdx; }
    };
    /* 页面 CSP 禁 eval:脚本本体由 main.js 用 executeJavaScript 在页面上下文执行(不受 CSP 限制),这里只备好 ctx */
    window.__probeCtx=ctx;
    return {ok:true,loaded:ctx.loaded};
  }catch(e){ return {ok:false,error:String(e&&e.stack||e).slice(0,6000)}; }
};
window.__shotPrep=async function(opts){
  await bootDone;
  state.autoScan=false;
  opts=opts||{};
  if(opts.fsd){ state.folder=opts.fsd; await scanFolderKind('fsd'); }
  if(opts.retail){ state.folder2=opts.retail; await scanFolderKind('retail'); }
  if(opts.audio){ state.folder3=opts.audio; await scanFolderKind('audio'); }
  let firstKey=null,n=0;
  if(D)D.list.forEach(function(it){
    if(n>=3)return;
    if(it.bl&&it.bl.base!=null&&it.bl.conf!=='low'&&!it.exempt&&!it.exempt){
      state.decisions[it.u.key]={mode:'flat'};
      if(!firstKey)firstKey=it.u.key;
      n++;
    }
  });
  if(firstKey)state.ui.unit=firstKey;
  /* 演示剧本:生命周期/新品规划/渠道大促各设一例,供面板截图有真实内容 */
  try{
    let it0=null;
    if(D)D.list.forEach(function(it){ if(!it0&&it.sim&&it.sim.rows&&it.sim.rows.length>8&&!it.exempt&&it.bl&&it.bl.base)it0=it; });
    if(it0)state.lifecycle[it0.u.product]={eolSI:F.addWeeksP(store.maxPeriod,4),eolSO:F.addWeeksP(store.maxPeriod,18)};
    let anchor=null;
    if(Dr)Dr.list.forEach(function(it){ if(!anchor&&it.bl&&it.bl.base&&it.bl.conf==='high')anchor=it.u.product; });
    if(anchor&&!state.newProducts.length)
      state.newProducts.push({id:'npDemo',name:'演示新品 Pro',line:'平板',family:'Slate Tab',anchor:anchor,
        scale:1,launch:F.addWeeksP((retailStore||store).maxPeriod,3),lifeWeeks:78,succ:null});
      state.newProducts.push({id:'npDemo27',name:'演示新品 27年款',line:'平板',family:'Slate Tab',anchor:anchor,scale:1,
        launch:F.mkPeriod(F.periodY(store.maxPeriod)+1,3),lifeWeeks:78,succ:null});   // 明年 W3 上市:验证窗口跨年
    const sug=F.chanPromoScan(retailStore||store,{});
    if(sug.length&&sug[0].spans.length&&!Object.keys(state.chanPromo).length)
      state.chanPromo[sug[0].account]=[{w1:sug[0].spans[0].w1,w2:sug[0].spans[0].w2,name:'渠道大促'}];
    state.ui.smNew=true;
    /* 推演编辑矩阵演示:预展开 国家→产业→产品 三层(截图可见四行同屏与钻取) */
    (function(){
      let it0=null;
      if(D)D.list.forEach(function(it){ if(!it0&&!it.exempt&&it.sim&&it.sim.rows&&it.sim.rows.length)it0=it; });
      if(it0){
        const u=it0.u;
        const k1='|#|__root|#|'+(u.country||'(未知)');
        const k2=k1+'|#|'+(u.line||'(未知)');
        const k3=k2+'|#|'+(u.product||'(未知)');
        state.ui.pv2Open={}; state.ui.pv2Open[k1]=1; state.ui.pv2Open[k2]=1; state.ui.pv2Open[k3]=1;
        state.ui.pv2View='country'; state.ui.pv2Gran='month'; state.ui.pvSrc='fsd';
        state.ui.pv2C=u.country||'';   // 截图聚焦该国,展开链落在首屏
        /* 月周混合演示:推演首月预展开为周列 */
        if(D&&D.fw&&D.fw.length){
          state.ui.pv2MExp={};
          state.ui.pv2MExp['M'+F.periodY(D.fw[0])+'-'+F.monthOfP(D.fw[0])]=1;
        }
      }
    })();
    /* 产品总控演示:未来SI最大的型号 展开+锁量(演示压缩与断供链路) */
    (function(){
      const cand={};
      if(D)D.list.forEach(function(it){ if(it.u.audio||it.exempt)return;
        let s=0; (it.sim.rows||[]).forEach(function(r){ s+=(r.si||0); });
        cand[mkKey(it.u)]=(cand[mkKey(it.u)]||0)+s; });
      let best=null,bs=0;
      Object.keys(cand).forEach(function(mk){ if(cand[mk]>bs){ bs=cand[mk]; best=mk; } });
      if(best&&bs>10){
        const snt=lockSentOf(best);
        state.lockQty[best]={on:true,total:Math.round(snt.sent+bs*0.4),byC:{}};
        state.ui.mkOpen={}; state.ui.mkOpen[best]=1;
      }
    })();
    /* 间接渠道演示:把 FSD 表里的 ANDES 标为间接渠道(2026-09-01 起间接渠道走下游同款学习链,截图可见其策略/画像) */
    (function(){
      let acc=null;
      if(D)D.list.forEach(function(it){ if(!acc&&/ANDES/i.test(it.u.account||''))acc=it.u.account; });
      if(acc){ if(!state.chanClass)state.chanClass={}; state.chanClass[acc]={cls:'indirect'}; }
    })();
    /* 一次性铺货审视演示:合成 单次大额SI+长期动销 渠道(待确认页审视区截图有内容) */
    (function(){
      const L=['Purchase   Country/Region\tChannel Name(R)\tProduct Line\tProduct\tProduct Series\tProduct Model\tPeriod ID\tPSI Type\tQTY'];
      let inv2=0;
      for(let w=1;w<=30;w++){
        const pp='2026W'+String(w).padStart(2,'0');
        const si2=w===1?500:0, so2=10;
        inv2=inv2+si2-so2;
        L.push(['墨西哥','TROPICAL TECNOLOGIA_Indirect Retailer','手机','ACME nimbus 13','Vela','Vela-L23',pp,'Purchase',si2].join('\t'));
        L.push(['墨西哥','TROPICAL TECNOLOGIA_Indirect Retailer','手机','ACME nimbus 13','Vela','Vela-L23',pp,'Sell Out',so2].join('\t'));
        L.push(['墨西哥','TROPICAL TECNOLOGIA_Indirect Retailer','手机','ACME nimbus 13','Vela','Vela-L23',pp,'Inventory1',inv2].join('\t'));
      }
      importRetailText(L.join('\n'),'演示 一次性铺货渠道');
    })();
  }catch(e){}
  recompute();
  return true;
};
window.__shotTab=function(t){
  /* 支持 'settings@7000' 语法:切页后滚动到指定纵向位置(超高页面分段截图) */
  const parts=String(t).split('@');
  if(parts[0]==='aidock'){
    /* 伪页签:总控 + 打开 AI 解读面板(确定性解算演示) */
    state.ui.tab='master'; render();
    try{
      const tr=document.querySelector('#view-master tr[data-mk]');
      if(tr){
        const mk=tr.dataset.mk,ix=mk.indexOf('||');
        const m=F.monthOfP(D.fw[0]);
        const ex=aiExplainCell({product:mk.slice(0,ix),model:mk.slice(ix+2)||undefined,month:m});
        aiToggleDock(true);
        aiPush('user',aiLang()==='en'?('Explain the forecast for '+esc(mk.replace('||',' '))+' · Mo '+m)
          :('解释 '+esc(mk.replace('||',' '))+' '+m+'月 的推演值'));
        aiPush('a','<div class="muted" style="font-size:11px;margin-bottom:4px">'+aiT('确定性解算(直接读推演引擎,非模型生成)')+'</div>'+aiExplainHtml(ex));
      }
    }catch(e){}
    return document.body.scrollHeight;
  }
  if(parts[0]==='chantree'){
    /* 伪页签:渠道架构·哥伦比亚(样例下游有 CO 渠道)·自动连线 + 演示连几条 */
    try{ importRetailText(F.genRetailSampleTSV(),'样例'); recompute(); }catch(e){}
    state.ui.tab='chantree'; state.ui.ctC='哥伦比亚'; state.ui.ctSel=null;
    try{ chanAutoWire('哥伦比亚'); const a=chanArchOf('哥伦比亚'); state.chanTree['哥伦比亚']=state.chanTree['哥伦比亚']||{};
      a.ds.forEach(function(d,i){ if(d.parent==null&&a.direct.length&&i<2)state.chanTree['哥伦比亚'][d.account]=i===0?a.direct[0].account:'*'; }); }catch(e){}
    recompute(); render();
    return document.body.scrollHeight;
  }
  if(/^pv(retail|audio|np)N?$/.test(parts[0])){
    /* 伪页签:推演编辑·下游/音频/新品源·月视图·全展开(截图);尾缀 N=带上明年外推列 */
    const withNext=/N$/.test(parts[0]);
    state.ui.tab='pv'; state.ui.pvSrc=parts[0].indexOf('pvaudio')===0?'audio':(parts[0].indexOf('pvnp')===0?'np':'retail');
    state.ui.pv2View='country'; state.ui.pv2Gran='month'; state.ui.pv2C=''; state.ui.pv2L=''; state.ui.pv2Q='';
    state.ui.pv2MExp={};
    const cy=F.periodY(store.maxPeriod);
    state.ui.pv2Yrs={}; state.ui.pv2Yrs[cy]=1; if(withNext)state.ui.pv2Yrs[cy+1]=1;
    if(!state.ui.pv2HistN)state.ui.pv2HistN={}; state.ui.pv2HistN.month=withNext?0:2;
    /* 演示用的一次性渠道会整表替换下游样例;截年末对照时换回样例 7 单元 */
    if(state.ui.pvSrc==='retail'){ try{ importRetailText(F.genRetailSampleTSV(),'样例'); recompute(); }catch(e){} }
    render();
    try{ const eb=$('#pv2Exp'); if(eb&&eb.onclick)eb.onclick(); }catch(e){}
    return document.body.scrollHeight;
  }
  if(parts[0]==='btpanel'){
    /* 伪页签:系数页+运行补货规律回测(截图「模拟策略」判型列) */
    state.ui.tab='coef'; render();
    try{
      const b=$('#btnRunBT'); if(b&&b.onclick)b.onclick();
      const host=$('#btHost');
      if(host&&host.closest('details'))host.closest('details').open=true;
    }catch(e){}
    return document.body.scrollHeight;
  }
  if(parts[0]==='pvlogic'){
    /* 伪页签:推演编辑+右键推演逻辑浮层(截图) */
    state.ui.tab='pv'; render();
    try{
      const tds=document.querySelectorAll('#view-pv td[data-pv2k="so"]');
      let td=null;
      tds.forEach(function(x){ if(!td&&F.parseCellNum(x.textContent)>=10)td=x; });
      if(td)pv2ShowLogic(td,{clientX:520,clientY:280,preventDefault:function(){}},
        window.__pv2NodeIdx,window.__pv2Bks,state.ui.pvSrc||'fsd',F.periodY(store.maxPeriod));
      const bx=document.getElementById('pvXp');
      if(!bx||bx.style.display!=='block')throw new Error('浮层未显示 td='+(td?td.dataset.pv2n+'/'+td.dataset.pv2b:'null'));
    }catch(e){
      const d2=document.createElement('div');
      d2.style.cssText='position:fixed;top:70px;left:380px;background:#c62828;color:#fff;padding:10px 14px;z-index:99;border-radius:8px;max-width:700px';
      d2.textContent='PVLOGIC ERR: '+String(e&&e.stack||e).slice(0,300);
      document.body.appendChild(d2);
    }
    return document.body.scrollHeight;
  }
  if(parts[0]==='pvlight'){
    document.documentElement.dataset.theme='light';
    state.ui.tab='pv'; render();
    return document.body.scrollHeight;
  }
  if(parts[0]==='aiset'){
    /* 伪页签:单截设置页的「AI 助手」面板(截图专用,DOM 破坏无碍——shot 模式截完即退) */
    state.ui.tab='settings'; render();
    const t=Array.prototype.filter.call(document.querySelectorAll('#view-settings .panel'),function(p2){
      return /AI 助手/.test(((p2.querySelector('h3')||{}).textContent)||''); })[0];
    if(t){ const m2=document.querySelector('main');
      m2.innerHTML='<section class="on" style="display:block;padding-top:8px">'+t.outerHTML+'</section>'; }
    window.scrollTo(0,0);
    return document.body.scrollHeight;
  }
  const dk=aiDockEl(); if(dk)dk.style.display='none';
  state.ui.tab=parts[0]; render();
  if(parts[0]==='master'&&window.__xgShotSel)window.__xgShotSel();   // 截图演示:总控页带一个选区+状态条
  const y=parts[1]?+parts[1]:0;
  if(y>0){ document.documentElement.scrollTop=y; document.body.scrollTop=y; window.scrollTo(0,y); }
  else { window.scrollTo(0,0); }
  const rest=document.body.scrollHeight-y;
  return Math.max(600,rest);
};
/* ---------- 页面缩放:Ctrl+滚轮 调节 / Ctrl+0 复位(宽表看不全时缩小整页);档位随方案保存 ---------- */
function applyZoom(f,quiet){
  f=Math.max(0.5,Math.min(2,Math.round(f*20)/20));
  state.ui.zoom=f;
  if(SHELL&&SHELL.zoomSet)SHELL.zoomSet(f);
  else document.body.style.zoom=f;
  if(!quiet){
    const dl=document.getElementById('dataline');
    if(dl)dl.textContent='页面缩放 '+Math.round(f*100)+'%（Ctrl+滚轮调节，Ctrl+0 复位）';
    saveState();
  }
}
window.addEventListener('wheel',function(e){
  if(!e.ctrlKey)return;
  e.preventDefault();
  applyZoom((state.ui.zoom||1)+(e.deltaY<0?0.05:-0.05));
},{passive:false});
window.addEventListener('keydown',function(e){
  if(e.ctrlKey&&e.key==='0'){ e.preventDefault(); applyZoom(1); }
});

/* ---------- 启动/导入进度条 ----------
   遮罩是静态 HTML,首帧即可见;扫描时按文件数推进百分比。
   规则:凡是显示遮罩的路径必须 finally 收尾,遮罩卡住=软件假死。 */
let scanProg=null;   // {base,span,label}:当前扫描映射到总进度条的区段;boot 预设,手动扫描自占 0–100
function progShow(pct,txt){
  const o=document.getElementById('bootOv'); if(!o)return;
  o.style.display='flex';
  const p=Math.max(0,Math.min(100,Math.round(pct)));
  const f=document.getElementById('bootFill'); if(f)f.style.width=p+'%';
  const e=document.getElementById('bootPct'); if(e)e.textContent=p+'%';
  const t=document.getElementById('bootTxt'); if(t&&txt)t.textContent=txt;
}
function progHide(){ const o=document.getElementById('bootOv'); if(o)o.style.display='none'; scanProg=null; }
function progTick(){ return new Promise(function(r){
  /* 窗口最小化时 rAF 被节流甚至不触发,必须有超时兜底,否则扫描会停在进度等待上 */
  let done=false; const fin=function(){ if(!done){ done=true; r(); } };
  requestAnimationFrame(function(){ setTimeout(fin,0); });
  setTimeout(fin,60);
}); }
window.__selftest=async function(arg){
  try{
    await bootDone;
    if(!SHELL)return {ok:false,error:'no shell'};
    const opts=(typeof arg==='string')?{fsd:arg}:(arg||{});
    const tms={};
    const sfStep=function(m){ try{ console.warn('SELFTEST_STEP '+m); }catch(e){} };
    window.__sfStep=sfStep;
    /* 无人值守:全程禁用原生对话框。alert/confirm/prompt 同步阻塞渲染进程的事件循环——
       一旦某条路径弹出来,定时器不再触发、IPC 回包收不到,主进程只能干等到外部超时,日志停在最后一步毫无线索
       (2026-09-04 为此白跑了几轮 25 分钟)。这里一次性桩掉,并记录谁弹过。 */
    /* SO-Sim.exe 的自检与 PSI 完全同一套:临时关掉 SO 模式与它的默认开关,跑完还原(2026-09-15) */
    const __soSnap={autoFlat:state.cfg.autoFlat,off:window.__soToolOff};
    window.__soToolOff=true; if(SHELL&&SHELL.soTool){ state.cfg.autoFlat=false; }
    const dlgCalls=[];
    window.alert=function(m){ dlgCalls.push(['alert',String(m).slice(0,80)]); };
    window.confirm=function(m){ dlgCalls.push(['confirm',String(m).slice(0,80)]); return true; };
    window.prompt=function(m){ dlgCalls.push(['prompt',String(m).slice(0,80)]); return null; };
    tms.dlgCalls=dlgCalls;
    state.autoScan=false;
    state.folder=opts.fsd||'';
    let t0=performance.now();
    const okScan=state.folder?await scanFolderKind('fsd'):false;
    tms.scanFsd=Math.round(performance.now()-t0);
    t0=performance.now();
    let okRetail;
    if(opts.retail){ state.folder2=opts.retail; okRetail=await scanFolderKind('retail'); }
    else okRetail=importRetailText(F.genRetailSampleTSV(),'selftest 下游示例');
    tms.scanRetail=Math.round(performance.now()-t0);
    t0=performance.now();
    let okAudio;
    if(opts.audio){ state.folder3=opts.audio; okAudio=await scanFolderKind('audio'); }
    else okAudio=importAudioText(F.genAudioSampleTSV(),'selftest 音频示例');
    tms.scanAudio=Math.round(performance.now()-t0); 
    /* 各页渲染计时(真实规模性能体检) */
    ['watch','master','channels','overview','detail','summary','pv','confirm','retail','audio','monthend','targets','coef','settings'].forEach(function(t){
      const r0=performance.now(); state.ui.tab=t;
      try{ render(); tms['r_'+t]=Math.round(performance.now()-r0); }
      catch(e){ tms['r_'+t]='ERR:'+String(e&&e.message||e).slice(0,80); }
    });
    /* ---- 看板收敛 阶段0 门禁基建(2026-09-04):在任何冒烟改动之前,采集「每页每格数值」与「每种导出」的基线。
       这里只采集,比对在 scripts/gate.js(仓库 baseline/ 下);之后每一步重构都要求逐位相同,改数只能发生在拍板条目。 ---- */
    let viewDigests=null,exportDigests=null;
    const __tD0=performance.now();
    const dlgRestore=function(){ window.__exportHook=null; };   // 对话框已在自检开头全程桩掉,这里只收导出钩子
    try{
      /* 无人值守:任何原生对话框都会挂死整个自检(预算底表导出里就有一个 confirm),采集期间一律桩掉 */
      const step=sfStep;
      const fnv=function(lines){ let h=0x811c9dc5; const st=lines.join('\n'); for(let i=0;i<st.length;i++){ h^=st.charCodeAt(i); h=Math.imul(h,0x01000193)>>>0; } return ('0000000'+h.toString(16)).slice(-8); };
      const norm=function(x){ return String(x==null?'':x).replace(/\s+/g,' ').trim(); };
      const digestSec=function(sec){
        const lines=[];
        sec.querySelectorAll('table').forEach(function(tb,ti){
          tb.querySelectorAll('tr').forEach(function(tr){
            const cells=Array.prototype.map.call(tr.cells,function(td){ return norm(td.textContent); });
            if(cells.some(function(c){ return /\d/.test(c); }))lines.push('T'+ti+'|'+cells.join('\u0001'));
          });
        });
        sec.querySelectorAll('.kpi').forEach(function(k){ lines.push('K|'+norm(k.textContent)); });
        lines.sort();
        return {n:lines.length,hash:fnv(lines),lines:lines};
      };
      const uiSnap=JSON.stringify(state.ui);
      const restoreUi=function(){ const o=JSON.parse(uiSnap); Object.keys(state.ui).forEach(function(k){ if(!(k in o))delete state.ui[k]; }); Object.assign(state.ui,o); };
      const cyU=store?F.periodY(store.maxPeriod):0;
      /* 每个变体都从同一份初始 ui 出发:否则上一个变体设的键(如 pv2Yrs)会渗进下一个,基线互相污染 */
      /* 夹具补齐(R7):夹具本身没有目标表/监控项/锁量/新品,这些路径用「种子」临时造出来进基线,采完立刻拆掉,不影响别的变体 */
      const seedUnit=function(){ let u0=null; if(D)D.list.forEach(function(it){ if(!u0&&!it.exempt&&!it.ignored&&it.sim&&it.sim.rows&&it.sim.rows.length)u0=it; }); return u0; };
      const SEED={
        targets:{on:function(){ const it=seedUnit(); if(!it)return; const u=it.u; importTargetRows([{line:u.line,product:u.product,country:u.country,channel:u.account,rawName:u.account,t:{9:200,10:150,11:200,12:200},note:''}],'基线目标'); },
                 off:function(){ targetRows=null; Dt=null; saveData4(); recompute(); }},
        watch:{on:function(){ const it=seedUnit(); if(it)addWatch('fsd',it.u.key); },
               off:function(){ const it=seedUnit(); if(it){ removeWatch('fsd',it.u.key); delete state.watchBase[it.u.key]; } }},
        lock:{on:function(){ const it=seedUnit(); if(!it)return; state.lockQty[mkKey(it.u)]={on:true,total:5000,byC:{}}; computeAll(); },
              off:function(){ const it=seedUnit(); if(it)delete state.lockQty[mkKey(it.u)]; computeAll(); }},
        np:{on:function(){ let anchor=null; (D?D.list:[]).forEach(function(it){ if(!anchor&&it.bl&&it.bl.base&&it.bl.conf!=='low')anchor=it.u.product; }); if(!anchor)return;
                state.newProducts.push({id:'npBase',name:'基线新品',line:'平板',family:'Slate Tab',anchor:anchor,scale:1,launch:F.addWeeksP(store.maxPeriod,3),lifeWeeks:78,succ:null}); computeAll(); },
            off:function(){ state.newProducts=state.newProducts.filter(function(x){ return x.id!=='npBase'; }); computeAll(); }}
      };
      const setUi=function(tab,o){ restoreUi(); state.ui.tab=tab; Object.keys(o).forEach(function(k){ if(k==='expand'||k==='click'||k==='seed')return;
        if(k==='pv2Yrs'&&o[k]==='NEXT'){ const y={}; y[cyU]=1; y[cyU+1]=1; state.ui.pv2Yrs=y; return; }   // 明年列(承接/外推路径)也要进基线
        state.ui[k]=JSON.parse(JSON.stringify(o[k])); }); };
      const keyOf=function(tab,o){ return tab+Object.keys(o).filter(function(k){ return k!=='expand'&&k!=='pv2Open'&&k!=='click'&&k!=='seed'; }).map(function(k){ return '.'+(k==='pv2Yrs'?'next':o[k]); }).join('')+(o.click?'.sim':'')+(o.seed?'.seed-'+o.seed:''); };
      const VD=[
        ['watch',{}],['master',{}],['fin',{}],['overview',{}],['detail',{}],['confirm',{}],['retail',{}],['chantree',{}],['audio',{}],
        ['channels',{clSrc:'fsd'}],['channels',{clSrc:'retail'}],['channels',{clSrc:'audio'}],
        ['pv',{pvMode:'summary',smView:'tree',smSrc:'fsd'}],['pv',{pvMode:'monthend'}],['pv',{pvMode:'detail'}],
        ['monitor',{monTab:'watch'}],['monitor',{monTab:'targets'}],
        ['rules',{rulesTab:'settings'}],['rules',{rulesTab:'coef'}],
        ['monitor',{monTab:'targets',seed:'targets'}],['monitor',{monTab:'watch',seed:'watch'}],
        ['master',{seed:'lock'}],['pv',{pvSrc:'fsd',pv2View:'product',pv2Gran:'month',pv2Open:{},expand:1,seed:'lock'}],
