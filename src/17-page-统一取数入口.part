/* ===== 统一取数入口(2026-09-04 看板收敛 阶段2)=====
   所有看板/导出/AI 都从 q() 拿数:这里只负责准备环境(数据对象、按预设过滤单元、外推映射),计算在引擎 C.qRun。
   单元过滤预设逐字复刻各看板今天的剔除规则(视图声明预设名,门禁按预设名比对;合并预设留 D15):
     pivot   = 推演编辑:剔 ignored;FSD 源剔 u.audio(音频以专表为准);免推演/待确认留树、推演段 0
     summary = 推演汇总/层级监控:剔 exempt/ignored/blocked;FSD 剔 audio;下游按 showRetailAudio
     auth    = 产品总控/AI 权威源:FSD 剔 audio,音频专表全量
     all     = 不剔(月末DOS 页现状) */
function selectUnits(preset,src,filter){
  const Dx=dxOfSrc(src); if(!Dx||!Dx.list)return [];
  const f=filter||{};
  return Dx.list.filter(function(it){
    const u=it.u;
    if(preset==='pivot'){ if(it.ignored||(src==='fsd'&&u.audio))return false; }
    else if(preset==='summary'){ if(src==='retail'&&!state.showRetailAudio&&u.audio)return false; if(it.exempt||it.ignored)return false; if(it.sim&&it.sim.blocked)return false; if(src==='fsd'&&u.audio)return false; }
    else if(preset==='auth'){ if(src==='fsd'&&u.audio)return false; }
    if(f.line&&u.line!==f.line)return false;
    if(f.product&&u.product!==f.product)return false;
    if(f.model&&(u.model||u.product)!==f.model)return false;
    if(f.country&&u.country!==f.country)return false;
    if(f.account&&u.account!==f.account)return false;
    if(f.q){ const s2=String(f.q).toLowerCase(); if(String(u.key).toLowerCase().indexOf(s2)<0&&String(u.product||'').toLowerCase().indexOf(s2)<0)return false; }
    return true;
  });
}
function q(query){
  const src=query.src||'fsd'; const Dx=dxOfSrc(src),stx=storeOfSrc(src);
  if(!Dx||!stx||!stx.maxPeriod)return null;
  const curY=F.periodY(stx.maxPeriod);
  const yrs=(query.yrs&&query.yrs.length)?query.yrs.slice():[curY];
  const maxY=Math.max.apply(null,yrs);
  const extByKey=(maxY>curY)?pv2ExtByKey(src,maxY):null;
  const items=selectUnits(query.sel||'pivot',src,query.filter);
  const r=F.qRun({Dx:Dx,stx:stx,items:items,extByKey:extByKey,expand:query.expand||null},
    {src:src,gran:query.gran||'month',yrs:yrs,histN:query.histN,dims:query.dims||[],mode:query.mode||'tree',cur:query.cur});
  r.meta={src:src,sel:query.sel||'pivot',gens:{dataGen:dataGen,simGen:simGen,ovExtGen:ovExtGen},caliber:{dos:'dos',dosCur:'dosCur'}};
  return r;
}
window.__q=q;   // 探针/门禁入口
const PV2_VIEWS={
  rep:{label:'国家办视图',dims:['rep','country','line','product','model','account']},
  country:{label:'国家视图',dims:['country','line','product','model','account']},
  line:{label:'产业视图',dims:['line','product','country','model','account']},
  product:{label:'产品视图',dims:['line','product','model','country','account']},
  custom:{label:'自定义',dims:null},
};
const PV2_DIM_OPTS=[['','(不用)'],['rep','国家办'],['country','国家'],['line','产业'],['product','产品'],['model','型号'],['account','渠道']];
function pv2DimVal(u,d){
  if(d==='model')return (u.model==null||u.model==='')?'(无型号)':String(u.model);
  if(d==='rep')return F.repOf(u.country);
  return u[d]||'(未知)';
}
function pv2UKey(country,account,model){ return F.unitKey3(country,account,model); }
/* ---------- 外推手工覆盖层 + 撤销栈 ---------- */
let ovExtGen=0;
/* 预算外推行 + 手工覆盖(state.ovExt):替换 SO/SI 后按 库存=上月末+SI−SO 重链该单元后续月库存与金额;
   所有外推消费方(推演矩阵/AI nextYear/scopeQuery/预算底表导出)统一走这里,口径不分裂 */
function budgetRowsOv(endYear){
  const c=calcCache();
  const tag=endYear+'|'+ovExtGen;
  if(c.budOv&&c.budOv.tag===tag)return c.budOv.rows;
  if(!c.budTo||c.budToGen!==ovExtGen){ c.budTo={}; c.budToGen=ovExtGen; }   // 手拍已进 buildBudgetRows(2026-09-02 R4):基表随 ovExt 失效
  if(!c.budTo[endYear]){
    Object.keys(c.budTo).filter(function(y){ return +y!==endYear; }).slice(0,-1).forEach(function(y){ delete c.budTo[y]; });   // 同上:同时最多留 2 个年份
    try{ c.budTo[endYear]=buildBudgetRows(endYear); }catch(e){ c.budTo[endYear]=[]; }
  }
  const base=c.budTo[endYear];
  const ov=state.ovExt||{};
  let rows=base;
  const ovKeys=Object.keys(ov);
  if(ovKeys.length){
    /* 性能:浅拷贝行数组;只有受覆盖影响的单元行才深拷贝重链,其余行直接引用基表(拍一次≈只算该层级行) */
    const ovSet={};
    ovKeys.forEach(function(k){ ovSet[k]=1; });
    rows=base.slice(); rows.__cov=base.__cov;
    const byU=new Map();
    rows.forEach(function(r,i){
      if(r[6]!=='新品规划')return;   // 三源的手拍已在 buildBudgetRows 引擎里应用(2026-09-02 R4);这里只余新品规划行(其 SI 由新品引擎给定,按月覆盖+重链)
      const kU=pv2UKey(r[4],r[5],(r[17]!=null&&r[17]!=='')?r[17]:null);
      if(!ovSet[ovExtKeyOf(r[6],kU)])return;   // 覆盖层按源(2026-09-02 审计)
      const k=kU+'|'+r[6];
      if(!byU.has(k))byU.set(k,[]);
      byU.get(k).push(i);
    });
    byU.forEach(function(idxs){
      idxs.forEach(function(i){ rows[i]=rows[i].slice(); });
      idxs.sort(function(a,b){ return (rows[a][7]-rows[b][7])||(rows[a][9]-rows[b][9]); });
      let inv=null,dirty=false,carryR=1,segOv=0,segRaw=0,inSeg=false;
      idxs.forEach(function(i){
        const r=rows[i];
        const k2=ovExtKeyOf(r[6],pv2UKey(r[4],r[5],(r[17]!=null&&r[17]!=='')?r[17]:null));
        const e=ov[k2]&&ov[k2][r[7]+'-'+r[9]];
        if(inv==null)inv=(+r[12]||0)-(+r[11]||0)+(+r[10]||0);   // 期初=月末−SI+SO
        /* 拍数承接(2026-09-02 审计修正):按连续手拍月段合计 Σ拍值÷Σ基表值(夹 0.2~5),段结束时生效;拍 0 不承接 */
        const baseSo=+r[10]||0;
        if(e&&e.so!=null){ inSeg=true; if(baseSo>0){ segOv+=e.so; segRaw+=baseSo; } }
        else {
          if(inSeg){ inSeg=false; if(state.cfg.carryTaps!==false&&segRaw>0&&segOv>0)carryR=Math.max(0.2,Math.min(5,segOv/segRaw)); segOv=0; segRaw=0; }
          if(carryR!==1){ r[10]=F.round5(baseSo*carryR,state.cfg.roundTo||5); dirty=true;   /* 取整到步长(2026-09-04 用户:明年列出现 19/13 这种非 5 倍数):此前承接比例乘完只 Math.round 到 1 台 */
            if(String(r[16]||'').indexOf('承接')<0)r[16]=(r[16]?r[16]+';':'')+'承接拍数比例'; }
        }
        if(e){
          dirty=true;
          if(e.so!=null)r[10]=e.so;
          if(e.si!=null)r[11]=e.si;
        }
        if(dirty){
          let so=+r[10]||0; let si=+r[11]||0;
          if(e&&e.so!=null&&e.si==null&&so>inv+si){ si=si+F.ceilStep(so-(inv+si),state.cfg.roundTo||5); r[11]=si; if(String(r[16]||'').indexOf('进货补足')<0)r[16]=(r[16]?r[16]+';':'')+'手拍SO高于可售:进货补足'; }   // 2026-09-02:拍的是决策,当月进货补足(SI 也手拍时不动)
          if(so>inv+si){ so=Math.max(0,Math.round(inv+si)); r[10]=so; }   // 库存硬约束
          inv=inv+si-so;
          r[12]=Math.round(inv);
          if(r[13]!==''&&r[13]!=null){ r[14]=Math.round(so*r[13]); r[15]=Math.round(si*r[13]); }
          if(e&&String(r[16]||'').indexOf('手工外推')<0)r[16]=(r[16]?r[16]+';':'')+'含手工外推拍数';
        } else {
          inv=+r[12]||0;
        }
      });
    });
  }
  if(__lockRes&&Object.keys(__lockRes).length){ if(rows===base){ rows=base.slice(); rows.__cov=base.__cov; } lockExtAlloc(rows,endYear); }   // 锁量延伸段顺序分配(在手工外推拍数之后;基表不动)
  c.budOv={tag:tag,rows:rows};
  return rows;
}
/* 撤销栈:拍数动作前记旧值,Ctrl+Z/按钮 单步回滚(400ms 内的写合并为一步);容量30 */
let __undoStack=[];
function pushUndo(entries){
  if(!entries||!entries.length)return;
  const now=Date.now();
  const top=__undoStack[__undoStack.length-1];
  if(top&&now-top.t<400){   // 合并用 push 不用 concat(2026-09-02 性能:粘贴几百格时 concat 每次复制整条撤销栈,是平方级开销)
    for(let i=0;i<entries.length;i++)top.e.push(entries[i]);
    top.t=now; }
  else{ __undoStack.push({t:now,e:entries}); if(__undoStack.length>30)__undoStack.shift(); }
}
function undoTakeOv(bagName,key,p){
  const bag=state[bagName];
  return {bag:bagName,key:key,p:p,old:(bag[key]&&bag[key][p]!=null)?bag[key][p]:null};
}
function undoLast(){
  const f=__undoStack.pop();
  if(!f){ xgFlash('没有可撤销的拍数'); return; }
  f.e.slice().reverse().forEach(function(en){
    if(en.bag==='ovExt'){
      if(en.old==null){
        const o=state.ovExt[en.key];
        if(o&&o[en.ym]){ delete o[en.ym][en.field];
          if(!Object.keys(o[en.ym]).length)delete o[en.ym];
          if(!Object.keys(o).length)delete state.ovExt[en.key]; }
      } else {
        (state.ovExt[en.key]=state.ovExt[en.key]||{});
        (state.ovExt[en.key][en.ym]=state.ovExt[en.key][en.ym]||{})[en.field]=en.old;
      }
      ovExtGen++;
    } else {
      const bag=state[en.bag];
      if(en.old==null){
        const o=bag[en.key];
        if(o&&o[en.p]!=null){ delete o[en.p]; if(!Object.keys(o).length)delete bag[en.key]; }
      } else (bag[en.key]=bag[en.key]||{})[en.p]=en.old;
    }
  });
  xgFlash('已撤销 1 步('+f.e.length+' 格)');
  recompute();
}
window.__undo=undoLast;
/* 版本快照恢复:与 boot 同款合并语义(旧快照缺新键时沿用当前值),恢复后全量重算 */
async function snapSaveNow(name){
  if(!(SHELL&&SHELL.snapSave))return {ok:false,error:'快照通道不可用'};
  return await SHELL.snapSave({name:name||'',state:state});
}
async function snapRestore(file){
  const r=await SHELL.snapRead(file);
  if(!r||!r.ok)return {ok:false,error:(r&&r.error)||'读取失败'};
  await snapSaveNow('恢复前自动');
  const obj=(r.data&&r.data.state)||{};
  Object.keys(state).forEach(function(k){ if(obj[k]!=null)state[k]=obj[k]; });
  state.ui=Object.assign({},UI_DEFAULTS,state.ui||{});
  if(!state.ovExt)state.ovExt={};
  __undoStack=[];
  bumpDataGen(); ovExtGen++;
  recompute();
  return {ok:true};
}
/* 外推层:明年起的 单元×月 值,来自预算外推引擎(平销×漂移×季节×增速+轻补货),按源过滤缓存 */
function pv2ExtByKey(src,endY){
  const c=calcCache();
  const tag=src+'|'+endY+'|'+ovExtGen;
  if(c.pvExt&&c.pvExt.tag===tag)return c.pvExt.byKey;
  const srcName=srcNameOf(src);
  const stx0=retailStore||store||audioStore;
  const curY=F.periodY(stx0.maxPeriod);
  const byKey=new Map();
  budgetRowsOv(endY).forEach(function(r){
    if(r[6]!==srcName)return;
    if(+r[7]<=curY)return;
    const key=pv2UKey(r[4],r[5],(r[17]!=null&&r[17]!=='')?r[17]:null);
    let e=byKey.get(key); if(!e){ e={}; byKey.set(key,e); }
    const ym=r[7]+'-'+r[9];
    const kOv=ovExtKeyOf(srcName,key);
    const oe=state.ovExt&&state.ovExt[kOv]&&state.ovExt[kOv][ym];
    e[ym]={so:(+r[10]||0),si:(+r[11]||0),inv:(+r[12]||0),soOv:!!(oe&&oe.so!=null),siOv:!!(oe&&oe.si!=null)};
  });
  c.pvExt={tag:tag,byKey:byKey};
  return byKey;
}
/* 阶段2(2026-09-04):分桶/单元序列/聚合/桶DOS 已提升为引擎 C.timeBuckets/unitSeries/aggSeries/bucketDos(纯函数、test.js 可单测);
   这里只留别名,推演编辑一行不改。月展开周的开关(state.ui.pv2MExp)作为参数传入引擎。 */
function pv2Buckets(Dx,stx,gran,yrs,histN){ return F.timeBuckets(Dx,stx,gran,yrs,histN,state.ui.pv2MExp||null); }
function pv2ItemVals(it,bctx,src,extByKey){ return F.unitSeries(it,bctx,src,extByKey); }
function pv2Agg(items,valMap,n){ return F.aggSeries(items,valMap,n); }
function pv2BucketDos(a,i2,b2){ return F.bucketDos(a,i2,b2); }
/* 推演编辑长表:列位对齐「月度SO实际数」(F=产品线,G=产品族,H=国家,I=型号,J=月序列,K=Measure,L=QTY),
   M=渠道(比总控长表多一维);粒度固定 国家×渠道×型号×月,与当前视图/粒度无关;
   历史月=底表实际(勾选年份内),今年未来月=当前源推演,外推年=预算外推口径(含手工拍数) */
function pvLongRows(items,src,yrs,curY,fwSet){
  const mSerial=function(y,m){ return Math.round((Date.UTC(y,m-1,1)-Date.UTC(1899,11,30))/86400000); };
  const maxY=Math.max.apply(null,yrs);
  const extByKey=maxY>curY?pv2ExtByKey(src,maxY):null;
  const ySet={}; yrs.forEach(function(y){ ySet[y]=1; });
  const headers=['占位A','占位B','占位C','占位D','占位E','产品线','产品族','国家','产品型号','月份','Measure','QTY','渠道','年','季度'];
  const data=[];
  items.forEach(function(it){
    const u=it.u;
    const fam=F.familyOf(u.product),famName=fam?fam.family:'';
    const modelName=u.model||u.product;
    const si={},so={},invE={},invP={};
    const acc=function(y,m,dsi,dso,iv,p2){
      const k=y+'-'+m;
      si[k]=(si[k]||0)+dsi; so[k]=(so[k]||0)+dso;
      if(iv!=null&&p2>=(invP[k]||0)){ invE[k]=iv; invP[k]=p2; }
    };
    u.periods.forEach(function(p2){
      const y=F.periodY(p2); if(!ySet[y]||fwSet[p2])return;
      const w=u.weeks.get(p2);
      acc(y,F.monthOfP(p2),(w.si||0),(w.so||0),(w.inv!=null?w.inv:w.inv1),p2);
    });
    ((it.sim&&it.sim.rows)||[]).forEach(function(rr){
      const y=F.periodY(rr.p); if(!ySet[y])return;
      acc(y,F.monthOfP(rr.p),(src==='fsd'?(rr.si||0):(rr.buy||0)),(rr.so||0),rr.inv,rr.p);
    });
    const e=extByKey?extByKey.get(pv2UKey(u.country,u.account,u.model)):null;
    yrs.forEach(function(y){
      for(let m=1;m<=12;m++){
        const k=y+'-'+m;
        let s1,s2,iv;
        if(y>curY){ const o=e&&e[k]; if(!o)continue; s1=o.si; s2=o.so; iv=o.inv; }
        else { if(si[k]==null&&so[k]==null&&invE[k]==null)continue; s1=si[k]||0; s2=so[k]||0; iv=invE[k]; }
        const js=mSerial(y,m), qq='Q'+Math.ceil(m/3);
        data.push(['','','','','',u.line,famName,u.country,modelName,js,'Sell In',Math.round(s1),u.account,y,qq]);
        data.push(['','','','','',u.line,famName,u.country,modelName,js,'Sell Out',Math.round(s2),u.account,y,qq]);
        data.push(['','','','','',u.line,famName,u.country,modelName,js,'Inventory',iv!=null?Math.round(iv):'',u.account,y,qq]);
      }
    });
  });
  return {headers:headers,data:data,extByKey:extByKey};
}
async function exportPvLong(items,src,yrs,curY,fwSet){
  if(!items.length){ alert('当前筛选下无数据。'); return; }
  let built;
  try{ built=pvLongRows(items,src,yrs,curY,fwSet); }
  catch(e){ alert('导出失败(构建行时出错): '+String(e&&e.message||e).slice(0,200)); return; }
  const headers=built.headers,data=built.data,extByKey=built.extByKey;
  const srcName=src==='fsd'?'FSD':(src==='retail'?'下游渠道':(src==='np'?'新品规划':'音频专表'));
  const guide=[
    ['「推演编辑」长表对接说明'],
    [''],
    ['1. 列位与「月度SO实际数」页一致:F=产品线,G=产品族,H=国家,I=产品型号,J=月份(Excel 日期序列=当月1日),K=Measure,L=QTY;M=渠道,N=年,O=季度(Q1-Q4)。'],
    ['2. SUMIFS 直接取数:按 型号+月份+Measure 求和自动跨国家/渠道;要分渠道追加 M 列;按季度汇总用 N 列(年)+O 列(季度)作条件,如 SUMIFS(L:L,I:I,型号,K:K,"Sell Out",N:N,2027,O:O,"Q1")。财经经营数据表(BU×传播名×国家,千台)请直接用「导出预算底表(财经)」里的「财经Q表」sheet。'],
    ['3. 数据源='+srcName+';范围=推演编辑当前筛选(国家/产业/搜索)与勾选年份。历史月=底表实际,今年剩余月=推演(含手拍/锁量),'+(extByKey?'外推年=预算外推口径(含外推层手工拍数)。':'未勾外推年。')],
    ['4. Inventory=月末库存(历史月底表无记录留空);'+(src==='fsd'?'SI=FSD 要货口径。':'SI=Purchase 口径(2026-09-01 起自动推演)。')],
    ['5. 本次导出 '+data.length+' 行,覆盖年份:'+yrs.join('、')+'。']
  ];
  if(SHELL&&SHELL.saveXlsx){
    const res=await saveXlsxHooked({name:'推演编辑长表-'+srcName+'-'+yrs.join('_')+'.xlsx',
      sheets:[{name:'月度SO实际数',rows:[headers].concat(data)},{name:'对接说明',rows:guide}]});
    if(res&&res.ok)alert('推演编辑长表已导出('+data.length+' 行,含对接说明 sheet):'+res.path+(res.note?'\n'+res.note:''));
    else if(res&&!res.canceled)alert('导出失败: '+(res.error||'')+'\n(把这段原文发给开发排查)');
  } else {
    exportTableRaw('推演编辑长表-'+srcName,headers,data);
  }
}
function renderPivot(){
  /* 模式条在矩阵页顶部(2026-09-10 阶段4b);矩阵本体与其余逻辑一行未改 */
  (function(){ const s2=$('#view-summary'),s3=$('#view-monthend'),s4=$('#view-detail');
    if(s2)s2.innerHTML=''; if(s3)s3.innerHTML=''; if(s4)s4.innerHTML=''; })();
  const el=$('#view-pv');
  const Dx=pvDxOf();
  const stx=state.ui.pvSrc==='audio'?audioStore:(state.ui.pvSrc==='retail'?retailStore:(state.ui.pvSrc==='np'?(retailStore||store):store));
  if(!Dx||!stx||!stx.units.size){ el.innerHTML='<div class="panel">当前数据源无数据。请先在「数据」页载入对应底表。</div>'; return; }
  const ui=state.ui;
  if(!PV2_VIEWS[ui.pv2View])ui.pv2View='country';
  if(['week','month','quarter','year'].indexOf(ui.pv2Gran)<0)ui.pv2Gran='month';
  if(!ui.pv2Open)ui.pv2Open={};
  const src=ui.pvSrc||'fsd';
  /* 层序只有一种:自定义(2026-09-15 用户:预设视图不要了,拖拽排序、几层都行)。旧预设名只作初始层序,一进来就转成自定义 */
  if(ui.pv2View!=='custom'){ ui.pv2CustomDims=PV2_VIEWS[ui.pv2View].dims.slice(); ui.pv2View='custom'; }
  let dims=null;
  if(ui.pv2View==='custom'){
    if(!ui.pv2CustomDims)ui.pv2CustomDims=['country','line','product','model','account'];   // 首次进入种默认层序
    dims=ui.pv2CustomDims.filter(Boolean);
    const seen={}; dims=dims.filter(function(d2){ if(seen[d2])return false; seen[d2]=1; return true; });
    if(!dims.length)dims=['country'];
  }
  const curY=F.periodY(stx.maxPeriod);
  /* 可选年份=底表历史年∪今年∪外推两年;默认 去年+今年+明年 */
  const ySet={};
  stx.units.forEach(function(u){ u.periods.forEach(function(p2){ ySet[F.periodY(p2)]=1; }); });
  ySet[curY]=1; ySet[curY+1]=1; ySet[curY+2]=1;
  const allYrs=Object.keys(ySet).map(Number).sort(function(x,y){return x-y;});
  if(!ui.pv2Yrs||!Object.keys(ui.pv2Yrs).length){
    ui.pv2Yrs={}; ui.pv2Yrs[curY-1]=1; ui.pv2Yrs[curY]=1; ui.pv2Yrs[curY+1]=1;
  }
  const yrs=allYrs.filter(function(y){ return ui.pv2Yrs[y]; });
  if(!yrs.length)yrs.push(curY);
  /* 全量显示:免推演(低库存)与待确认(推演方式未拍板)单元都进树——历史数据照常,推演段为 0。
     2026-09-02 第三轮审计 R8:此前 blocked 单元被整棵剔除,而预算底表/财经Q表/产品总控明年列却把它算进去,
     于是 推演编辑历史列少台数、明年列与底表对不上、给该单元拍板的瞬间桶值自己变大、层级「恢复」也清不掉它的残留手拍。 */
  const usable=Dx.list.filter(function(it){ return !it.ignored&&!(src==='fsd'&&it.u.audio); });   // 音频以专表为准(2026-09-02 用户):FSD 源一律不出 FSD 表的音频行(专表未载入时提示去载入)
  const cSet={},lSet={};
  usable.forEach(function(it){ cSet[it.u.country||'(未知)']=1; lSet[it.u.line||'(未知)']=1; });
  const q=(ui.pv2Q||'').toLowerCase();
  const items=usable.filter(function(it){
    if(ui.pv2C&&(it.u.country||'(未知)')!==ui.pv2C)return false;
    if(ui.pv2L&&(it.u.line||'(未知)')!==ui.pv2L)return false;
    if(q){
      const s=(it.u.country+' '+it.u.line+' '+it.u.product+' '+(it.u.model||'')+' '+it.u.account).toLowerCase();
      if(s.indexOf(q)<0)return false;
    }
    return true;
  });
  const hDef={week:8,month:12,quarter:8,year:99};
  const histN=(ui.pv2HistN!=null&&ui.pv2HistN[ui.pv2Gran]!=null)?ui.pv2HistN[ui.pv2Gran]:hDef[ui.pv2Gran];
  const bctx=pv2Buckets(Dx,stx,ui.pv2Gran,yrs,histN);
  const bks=bctx.bks,n=bks.length;
  const maxY=Math.max.apply(null,yrs);
  const extByKey=(ui.pv2Gran!=='week'&&maxY>curY)?pv2ExtByKey(src,maxY):null;
  /* 桶值缓存:同一数据/推演/覆盖代 + 同粒度年份源 → 复用上次结果;展开收起/筛选/滚动重绘零重算 */
  const vTag=dataGen+'|'+simGen+'|'+ovExtGen+'|'+ui.pv2Gran+'|'+yrs.join(',')+'|'+src+'|'+histN
    +'|'+Object.keys(ui.pv2MExp||{}).join(',');
  if(!window.__pv2VC||window.__pv2VC.tag!==vTag)window.__pv2VC={tag:vTag,map:new Map()};
  const vc=window.__pv2VC.map;
  let valMap=new Map();   // 2026-09-02 审计:拍数后由 pv2Patch 换成重算后的新值(此前是渲染时快照,连拍/清尾会读到旧库存)
  items.forEach(function(it){
    let v=vc.get(it.u.key);
    if(!v){ v=pv2ItemVals(it,bctx,src,extByKey); vc.set(it.u.key,v); }
    valMap.set(it.u.key,v);
  });
  const mkNode=function(label,depth,pkey,pathVals){
    return {label:label,depth:depth,key:pkey+'|#|'+label,items:[],children:new Map(),path:pathVals};
  };
  const root=mkNode('__root',-1,'',{});
  const unitNodes={};   // 单元键→它所在的各层节点键(2026-09-02 性能:拍数后只刷这些节点的格)
  items.forEach(function(it){
    let node=root;
    node.items.push(it);
    const ks=[];
    dims.forEach(function(d2,di){
      const v=pv2DimVal(it.u,d2);
      let ch=node.children.get(v);
      if(!ch){
        const pv=Object.assign({},node.path); pv[d2]=v;
        ch=mkNode(v,di,node.key,pv);
        node.children.set(v,ch);
      }
      ch.items.push(it);
      node=ch; ks.push(ch.key);
    });
    unitNodes[it.u.key]=ks;
  });
  const siLab=src==='fsd'?'SI要货':(src==='np'?'SI(新品)':'Purchase');
  const dimName={rep:'国家办',country:'国家',line:'产业',product:'产品',model:'型号',account:'渠道'};
  let h='<div class="bar">'
    +'<button class="'+(src==='fsd'?'act':'ghost')+'" data-pvsrc="fsd"'+(D?'':' disabled')+'>FSD</button>'
    +'<button class="'+(src==='retail'?'act':'ghost')+'" data-pvsrc="retail"'+(Dr?'':' disabled')+'>下游渠道</button>'
    +'<button class="'+(src==='audio'?'act':'ghost')+'" data-pvsrc="audio"'+(Da?'':' disabled')+'>音频专表</button>'
    +'<button class="'+(src==='np'?'act':'ghost')+'" data-pvsrc="np"'+((Dn&&Dn.perNp&&Dn.perNp.length)?'':' disabled')+' title="新品规划页添加的产品:按覆盖范围铺到每个国家×渠道,四行可拍">新品</button>'
    +((src==='fsd'&&D&&D.list.some(function(it){ return it.u.audio; }))?'<span class="note"'+(Da?'':' style="color:var(--warn)"')+' title="音频以专表为准:FSD 表里的音频行是直接客户口径(SO1/自有),不代表渠道总量,推演编辑/汇总/底表的 FSD 源一律不出;看音频请切「音频专表」源">FSD 源已剔音频行'+(Da?'':'(尚未载入音频专表:去「数据」页载入)')+'</span>':'')
    +((src==='retail'&&__lockRes&&Object.keys(__lockRes).length)?(function(){
        /* 锁量贯通下游的明细(2026-09-02 用户:产品层看不出锁量有没有生效):每个锁量型号的 余量/下游预算/今年下游Purchase/是否压缩 */
        const ks=Object.keys(__lockRes).filter(function(mk){ const R=__lockRes[mk]; return R&&R.total>0; });
        if(!ks.length)return '';
        const det=ks.map(function(mk){ const R=__lockRes[mk];
          return mk.replace('||',' ')+':锁量 '+F.fmt(R.total)+' 已发 '+F.fmt(R.sent)+' 余 '+F.fmt(R.remain)
            +(R.retailN?(' · 下游 '+R.retailN+' 单元 今年Purchase '+F.fmt(R.retailFut)+' vs 预算 '+F.fmt(R.retailBudget)+' = min(INV1 '+F.fmt(R.retailInv1)+'+余 '+F.fmt(R.remain)+', 锁量总量 '+F.fmt(R.total)+'−下游累计Purchase '+F.fmt(R.retailLife||0)+')'+(R.retailScaled?' → 已压缩×'+R.retailF:' → 未超,未压')):' · 下游没有该型号(检查下游底表型号是否与 FSD 一致)')
            +(R.extRetailF!=null?' · 明年下游压缩×'+R.extRetailF:'')
            +(R.retailUnmatched?' · <b>型号对不上的下游单元 '+R.retailUnmatched+'</b>(按产品预算兜底'+(R.retailUnmatchedF!=null?'→压缩×'+R.retailUnmatchedF:'→未超')+(R.extUnmatchedF!=null?',明年×'+R.extUnmatchedF:'')+')':''); });
        const nScaled=ks.filter(function(mk){ return __lockRes[mk].retailScaled; }).length, nMiss=ks.filter(function(mk){ return !__lockRes[mk].retailN; }).length;
        return '<span class="note" style="cursor:help" title="'+esc(det.join('\n'))+'">锁量贯通下游:'+ks.length+' 型号(压缩 '+nScaled+(nMiss?' · <b style=\'color:var(--warn)\'>下游无此型号 '+nMiss+'</b>':'')+')·悬停看明细</span>'
          +'<label class="note" title="默认不勾=下游未来 Purchase ≤ 剩余待SI(锁量余量),再受 锁量总量−下游累计Purchase 天花板;勾上=再加上游直接渠道自有库存 INV1(下游从分销商库存拿货的口径)"><input type="checkbox" id="pvLockInv1"'+(state.cfg.lockRetailInv1===true?' checked':'')+'> 下游预算含分销商库存INV1</label>'
          +'<label class="note" title="默认不勾=锁量总量是硬顶:手拍 SO 高于可售时,补足的那笔进货照样受锁量约束,余量用尽就把 SO 按可售压回(格子标红+上方红字);勾上=手拍 SO 的补足进货与手拍同级不被压缩,总量可超锁量并记「手拍超锁量余量」"><input type="checkbox" id="pvLockTapCover"'+(state.cfg.lockTapCover===true?' checked':'')+'> 手拍SO的补足进货不受锁量压缩</label>'; })():'')
    +((src==='np'&&Dn&&Dn.perNp&&Dn.fwEnd)?(function(){
        const late=Dn.perNp.filter(function(pn){ return pn.np.launch&&pn.np.launch>Dn.fwEnd; });
        return late.length?'<span class="note" title="上市周在今年推演段之后:今年列全 0,量在明年列(月粒度,预算延伸口径,与新品规划页同一份结果)">'
          +esc(late.map(function(pn){ return pn.np.name+' '+(F.periodY(pn.np.launch)%100)+'W'+F.periodW(pn.np.launch)+'上市'; }).join('、'))
          +' → 看 '+(F.periodY(Dn.fwEnd)+1)+' 年列</span>':''; })():'')
    +'<span class="note" id="pvLockWarn" style="color:var(--warn);cursor:help;display:none"></span>'
    +'<span style="border-left:1px solid var(--line);margin:0 4px"></span>'
    +(function(){
      /* 层序 chips:拖拽换顺序、× 去掉一层、下拉加一层;两层是两参数透视,五层是全层级 */
      const lbl={}; PV2_DIM_OPTS.forEach(function(o3){ if(o3[0])lbl[o3[0]]=o3[1]; });
      const used=dims.slice(); const free=PV2_DIM_OPTS.filter(function(o3){ return o3[0]&&used.indexOf(o3[0])<0; });
      return '<span class="muted" title="从左到右=从外到内的层级;拖动 chip 换顺序,× 去掉一层,右边下拉加一层">层序:</span>'
        +'<span id="pv2Chips">'+used.map(function(d2,i3){
          return '<span class="pv2Chip" draggable="true" data-dim="'+d2+'" data-di="'+i3+'" title="拖动换位置">'+(i3+1)+'·'+(lbl[d2]||d2)
            +(used.length>1?'<span class="x" data-dimx="'+d2+'" title="去掉这一层">×</span>':'')+'</span>'; }).join('')+'</span>'
        +(free.length?('<select id="pv2DimAdd" class="mkIn" style="width:auto"><option value="">+ 加一层</option>'+free.map(function(o3){ return '<option value="'+o3[0]+'">'+o3[1]+'</option>'; }).join('')+'</select>'):'')
        +'<button class="ghost mini" id="pv2DimReset" title="回到 国家→产业→产品→型号→渠道">重置</button>';
    })()
    +'<span style="border-left:1px solid var(--line);margin:0 4px"></span>'
    +[['week','周'],['month','月'],['quarter','季'],['year','年']].map(function(g){
      return '<button class="'+(ui.pv2Gran===g[0]?'act':'ghost')+'" data-pv2g="'+g[0]+'">'+g[1]+'</button>'; }).join('')
    +(ui.pv2Gran==='week'?'':('　年份 '+allYrs.map(function(y){
      return '<button class="'+(ui.pv2Yrs[y]?'act':'ghost')+'" data-pv2y="'+y+'" title="点击显示/隐藏该年份的列'+(y>curY?';'+y+'=预算外推口径':(y<curY?';历史实际':''))+'">'
        +(y%100)+(y>curY?'\u2032':'')+'</button>'; }).join('')))
    +'　历史近 <input id="pv2H" class="mkIn" style="width:48px" value="'+histN+'" title="已过去的'+({week:'周',month:'月',quarter:'季',year:'年'})[ui.pv2Gran]+'列只显示最近 N 个;0=全部隐藏,只看推演">'
    +({week:'周',month:'月',quarter:'季',year:'年'})[ui.pv2Gran]
    +'　国家 <select id="pv2C" class="mkIn" style="width:auto"><option value="">全部</option>'
    +Object.keys(cSet).sort().map(function(c){ return '<option value="'+esc(c)+'"'+(ui.pv2C===c?' selected':'')+'>'+esc(c)+'</option>'; }).join('')+'</select>'
    +'　产业 <select id="pv2L" class="mkIn" style="width:auto"><option value="">全部</option>'
    +Object.keys(lSet).sort().map(function(c){ return '<option value="'+esc(c)+'"'+(ui.pv2L===c?' selected':'')+'>'+esc(c)+'</option>'; }).join('')+'</select>'
    +'　<input id="pv2Q" class="mkIn" style="width:140px" placeholder="搜产品/型号/渠道" value="'+esc(ui.pv2Q||'')+'">'
    +'<button class="ghost" id="pv2Exp">展开全部</button><button class="ghost" id="pv2Col">收起全部</button>'
    +'<button class="ghost" id="pv2Undo" title="撤销最近一次拍数(Ctrl+Z);连续快速写入合并为一步">撤销</button>'
    +'<button class="act" id="pv2Nimbus" title="与你的「月度SO实际数」页同列位(F=产品线,G=产品族,H=国家,I=型号,J=月序列,K=Measure,L=QTY,M=渠道):国家×渠道×型号×月 长表,按当前源与勾选年份;粘回 Excel 后 SUMIFS 直接取数,不用逆透视">导出长表(SUMIFS)</button>'
    +'<button class="ghost" id="pv2Bud" title="财经预算口径长表(BU/产品/预算名/系族/国家/渠道/源/年/季度/月/SO/SI/月末库存/RRP/金额/型号),权威源=FSD直签+音频专表,可延伸到明年底;与推演汇总页「导出预算底表」同一份">导出预算底表(财经)</button>'
    +'<button class="ghost" id="pv2Out" title="当前视图的宽表(层级×指标×桶),看表用;做 SUMIFS 请用左边的长表">导出宽表(当前视图)</button>'
    +'<button class="ghost" id="pv2Np" title="跳到新品规划页添加未上市产品(锚品×缩放,虚拟单元)">+新品</button></div>'
    +'<div class="note">层级:'+dims.map(function(d2){return dimName[d2];}).join(' → ')
    +' · 每层同屏 '+siLab+' / SO / 库存 / DOS · <b>库存=上期末+本期'+siLab+'−本期SO(桶末时点)</b> · <b>DOS=期末库存÷(末月SO÷末月天数)</b>(月=该月周数×7天:4周=28天,5周=35天;<b>季/年列的 DOS=该季/该年最后一个月的月末DOS</b>,与月视图同值;周=÷(周SO÷7)) · '
    +'·A=历史实际(灰底只读) · 今年白底=推演可拍 · <span class="pv2ExtTag">未来年(蓝底)=预算外推口径,同样可拍(置信低于今年)</span> · 任意层级拍一个数,自动按各 渠道×型号 的推演现值守恒拆解到最细粒度(现值内含渠道平销/季节/爆发系数经验;现值全0时按近26周历史SO占比兜底),库存链即时重算 · '
    +'<b>右键任意 SO/'+siLab+' 数值查看推演逻辑</b>(平销b̂/大促/增速链/公式);周粒度只覆盖当前推演段 · <b>拍数会按比例承接到其后各期</b>(直到下一次拍数;虚线下划线=承接中) · 自动进货受该渠道正常经营水位约束(平销库存×1.5 / 平销DOS×1.5×前瞻需求)。</div>';
  /* 双行表头:年份组 + 桶 */
  h+='<div class="tblwrap" style="max-height:70vh"><table><thead>';
  if(ui.pv2Gran==='month'||ui.pv2Gran==='quarter'){
    const grp=[];
    bks.forEach(function(b2){
      const g=grp.length?grp[grp.length-1]:null;
      if(g&&g.y===b2.y)g.n++;
      else grp.push({y:b2.y,n:1,mode:b2.mode});
    });
    h+='<tr><th class="l" rowspan="2" style="min-width:220px">层级</th><th class="l" rowspan="2" style="min-width:86px">指标</th>';
    grp.forEach(function(g){
      h+='<th colspan="'+g.n+'" class="pvYear '+(g.y<curY?'hist':(g.y>curY?'pv2Ext':''))+'" data-pvy="'+(g.y<curY?'a':(g.y>curY?'c':'b'))+'">'+g.y
        +(g.y<curY?'<span class="muted">·实际</span>':(g.y>curY?'<span class="muted">·外推</span>':'<span class="muted">·今年</span>'))+'</th>'; });
    h+='</tr><tr>';
    bks.forEach(function(b2,i0){
      let inner=esc(b2.label);
      if(b2.canExp)inner+=' <span class="pv2mx" data-pv2mx="'+b2.key+'" title="展开该月各周(周粒度拍数)">+</span>';
      if(b2.mSubFirst)inner='<span class="pv2mx" data-pv2mxc="'+b2.mSub+'" title="收起回月粒度">\u2212</span> '+inner;
      const yr=(b2.y<curY?'a':(b2.y>curY?'c':'b')); const first=(i0===0||bks[i0-1].y!==b2.y)?' data-pvyfirst="1"':'';
      h+='<th'+(b2.m===10&&b2.y===curY?' class="oct"':(b2.mode==='hist'?' class="hist"':(b2.mode==='ext'?' class="pv2Ext"':'')))+' data-pvy="'+yr+'"'+first+'>'+inner+'</th>'; });
    h+='</tr>';
  } else {
    h+='<tr><th class="l" style="min-width:220px">层级</th><th class="l" style="min-width:86px">指标</th>';
    bks.forEach(function(b2){
      h+='<th'+(b2.mode==='hist'?' class="hist" title="Actual·已发生实际,只读"':(b2.mode==='ext'?' class="pv2Ext" title="预算外推口径,只读"':(b2.m===10?' class="oct"':'')))+'>'
        +esc(b2.label)+(b2.mode==='hist'?'<span class="muted">·A</span>':(b2.mode==='ext'?'<span class="muted">·E</span>':''))+'</th>'; });
    h+='</tr>';
  }
  h+='</thead><tbody>';
  const emit=function(node){
    const a=pv2Agg(node.items,valMap,n);
    /* 该层级今年段有没有可拍的量:待确认(推演方式未拍板)/免推演单元没有推演行,格子不该看起来可编辑
       (2026-09-02 第三轮审计 R8:此前点下去只弹「该桶没有可拍的未来周」,数字还留在格里) */
    const hasSim=node.items.some(function(it){ return ((it.sim&&it.sim.rows)||[]).length>0; });
    const hasKids=node.children.size>0;
    const open=!!ui.pv2Open[node.key];
    const nm='<td class="l" rowspan="4" data-ci="0" style="padding-left:'+(8+node.depth*16)+'px;cursor:'+(hasKids?'pointer':'default')+'" data-pv2t="'+esc(node.key)+'">'
      +(hasKids?(open?'\u25be ':'\u25b8 '):'\u00b7 ')+esc(node.label)
      +'<span class="muted" style="font-size:11px"> ('+node.items.length+')</span>'
      +' <button class="mini" data-pv2r="'+esc(node.key)+'" title="清除该层级全部未来周 SO/SI 手工拍数,恢复公式推演">恢复</button></td>';
    let r1='<tr>'+nm+'<td class="l" data-ci="1">'+siLab+'<span class="muted">(可拍)</span></td>';
    let r2='<tr><td class="l" data-ci="1">SO<span class="muted">(可拍)</span></td>';
    let r3='<tr><td class="l" data-ci="1" title="上期末库存+本期'+siLab+'−本期SO">库存</td>';
    let r4='<tr><td class="l" data-ci="1" title="期末库存÷(末月SO÷末月天数);季/年列=该桶末月的月末DOS(与月视图同值)">DOS</td>';
    bks.forEach(function(b2,i2){
      const base=' data-ci="'+(2+i2)+'" data-pv2n="'+esc(node.key)+'" data-pv2b="'+b2.key+'" data-pvy="'+(b2.y<curY?'a':(b2.y>curY?'c':'b'))+'"'+((i2===0||bks[i2-1].y!==b2.y)?' data-pvyfirst="1"':'');
      const canEdit=(b2.hasFut&&hasSim)||b2.mode==='ext';
      const edCls=b2.hasFut?'ov':'pv2Ext';
      const edTitle=b2.hasFut?'左键拍数(整桶口径) · 右键看推演逻辑'
        :'外推口径可拍:拍值按现值守恒分配到该层级各单元该期,库存链自动重算(超出可用库存的部分按硬约束压回) · 右键看外推逻辑';
      const ed=canEdit
        ?(' class="'+edCls+'" contenteditable'+base+' title="'+edTitle+'"')
        :(' class="hist"'+base+' title="'+((b2.hasFut&&!hasSim)?'该层级单元为待确认/免推演,今年段无可拍量(明年列仍可拍) · 右键查看':'历史实际 · 右键查看')+'"');
      const ovMkSi=(b2.mode==='ext'&&a.siOv&&a.siOv[i2])?' style="box-shadow:inset 0 0 0 99px var(--ov)"':'';
      const ovMkSo=(b2.mode==='ext'&&a.soOv&&a.soOv[i2])?' style="box-shadow:inset 0 0 0 99px var(--ov)"':'';
      r1+='<td'+ed+ovMkSi+(canEdit?' data-pv2k="si"':' data-pv2m="si"')+'>'+F.fmt(Math.round(a.si[i2]))+'</td>';
      r2+='<td'+ed+ovMkSo+(canEdit?' data-pv2k="so"':' data-pv2m="so"')+((a.soCarry&&a.soCarry[i2])?' data-carry="1"':'')
        +((a.soCap&&a.soCap[i2])?' data-capped="1" title="拍的 SO 高于可售量,已按库存/锁量压回——差额见右键推演逻辑"':'')
        +'>'+F.fmt(Math.round(a.so[i2]))+'</td>';
      r3+='<td data-ci="'+(2+i2)+'" data-pv2n="'+esc(node.key)+'" data-pv2b="'+b2.key+'" data-pv2m="inv"'+(b2.hasFut?'':(' class="'+(b2.mode==='ext'?'pv2Ext':'hist')+'"'))+'>'+(a.inv[i2]!=null?F.fmt(Math.round(a.inv[i2])):'\u2014')+'</td>';
      const bd=pv2BucketDos(a,i2,b2); const soB=bd.soB,iv=bd.iv,dv=bd.dv;
      r4+='<td data-ci="'+(2+i2)+'" data-pv2n="'+esc(node.key)+'" data-pv2b="'+b2.key+'" data-pv2m="dos"'+dosRiskClsOct(dv,b2.m===10&&b2.y===curY&&ui.pv2Gran!=='year',!!(iv!=null&&iv>0&&soB<=0),b2.m)+'>'
        +(iv==null?'\u2014':(soB>0?F.fmt(dv):(iv>0?'\u221e':'\u2014')))+'</td>';
    });
    if(soTool()){   // SO 工具:SO 常显,SI/库存/DOS 按开关(2026-09-15 用户)
      const on=pvRowsOn(); const rows=[];
      if(on.si)rows.push('<tr>'+r1.slice(('<tr>'+nm).length));
      rows.push(r2); if(on.inv)rows.push(r3); if(on.dos)rows.push(r4);
      rows.forEach(function(r,i){ h+=(i===0?('<tr>'+nm.replace('rowspan="4"','rowspan="'+rows.length+'"')+r.slice(4)):r)+'</tr>'; });
    }
    else h+=r1+'</tr>'+r2+'</tr>'+r3+'</tr>'+r4+'</tr>';
    if(hasKids&&open){
      Array.from(node.children.keys()).sort().forEach(function(k){ emit(node.children.get(k)); });
    }
  };
  Array.from(root.children.keys()).sort().forEach(function(k){ emit(root.children.get(k)); });
  h+='</tbody></table></div>';
  el.innerHTML=pvModeBarHtml()+h;
  bindPvModeBar(el);
  /* 表格占满视口(不再留白);窗口缩放跟随 */
  (function(){
    const wrap=el.querySelector('.tblwrap');
    if(wrap){
      const rc=wrap.getBoundingClientRect();
      wrap.style.maxHeight='none';
      wrap.style.height=Math.max(320,window.innerHeight-rc.top-12)+'px';
    }
  })();
  updatePv2ColStyle();
  pv2SyncSticky(el);
  /* 锁量手拍超余量红字(2026-09-02 第二轮审计:此前只在整页重绘时生成,拍数走原地更新不刷新) */
  const pvLockWarnSync=function(){
    const el2=document.getElementById('pvLockWarn'); if(!el2)return;
    const ks=Object.keys(__lockRes||{}).filter(function(mk){ const R=__lockRes[mk]; return !!(R&&(R.manOver||R.retailManOver||R.extManOver)); });
    /* 手拍 SO 被压回也要亮(2026-09-02 审计 R1):此前只看 manOver,用户拍 3000 显示 933 时界面完全静默 */
    const capL=[]; let capN=0,capQ=0;
    [D,Dr,Da].forEach(function(Dx){ if(!Dx)return; Dx.list.forEach(function(it){
      let n2=0,q2=0; ((it.sim&&it.sim.rows)||[]).forEach(function(r){ if(r.capped&&r.soSrc==='override'&&r.soPlan!=null&&r.soPlan>r.so){ n2++; q2+=(r.soPlan-r.so); } });
      if(n2){ capN+=n2; capQ+=q2; if(capL.length<8)capL.push(it.u.country+' '+it.u.account+' '+(it.u.model||it.u.product)+' 少 '+F.fmt(Math.round(q2))+' 台'); } }); });
    if(!ks.length&&!capN){ el2.style.display='none'; el2.textContent=''; el2.title=''; return; }
    el2.style.display='';
    const txt=[]; const tip=[];
    if(ks.length){ txt.push('手拍超锁量余量 '+ks.length+' 型号');
      ks.forEach(function(mk){ const R=__lockRes[mk]; tip.push(mk.replace('||',' ')+':'+[R.manOver?'今年FSD手拍SI':'',R.retailManOver?'今年下游手拍Purchase':'',R.extManOver?'明年手拍SI':''].filter(Boolean).join('/')+' 手拍合计已超锁量余量'); }); }
    if(capN){ txt.push('手拍SO被压回 '+capN+' 格(合计少 '+F.fmt(Math.round(capQ))+' 台)');
      tip.push('以下单元的手拍 SO 高于可售量,已按库存/锁量压回(格子标红):'); capL.forEach(function(x){ tip.push('  '+x); }); }
    el2.textContent='⚠ '+txt.join(' · ')+'(悬停看明细)';
    el2.title=tip.join('\n');
  };
  window.__pvLockWarnSync=pvLockWarnSync;
  pvLockWarnSync();
  const pvLi=$('#pvLockInv1'); if(pvLi)pvLi.onchange=function(){ state.cfg.lockRetailInv1=this.checked; recompute(); };
  const pvTc=$('#pvLockTapCover'); if(pvTc)pvTc.onchange=function(){ state.cfg.lockTapCover=this.checked; recompute(); };
  el.querySelectorAll('button[data-pvsrc]').forEach(function(b2){
    b2.onclick=function(){ ui.pvSrc=b2.dataset.pvsrc; render(); }; });
  /* 层序 chips 交互(2026-09-15):拖拽换序 / × 去层 / 下拉加层 / 重置 */
  (function(){
    const setDims=function(arr){ ui.pv2CustomDims=arr.filter(Boolean); if(!ui.pv2CustomDims.length)ui.pv2CustomDims=['country']; ui.pv2Open={}; render(); };
    const cur=function(){ return (ui.pv2CustomDims||[]).filter(Boolean); };
    let dragFrom=null;
    el.querySelectorAll('.pv2Chip').forEach(function(ch){
      ch.addEventListener('dragstart',function(e){ dragFrom=+ch.dataset.di; ch.classList.add('drag'); try{ e.dataTransfer.setData('text/plain',ch.dataset.dim); e.dataTransfer.effectAllowed='move'; }catch(e2){} });
      ch.addEventListener('dragend',function(){ ch.classList.remove('drag'); el.querySelectorAll('.pv2Chip.over').forEach(function(x){ x.classList.remove('over'); }); });
      ch.addEventListener('dragover',function(e){ e.preventDefault(); ch.classList.add('over'); });
      ch.addEventListener('dragleave',function(){ ch.classList.remove('over'); });
      ch.addEventListener('drop',function(e){ e.preventDefault(); const to=+ch.dataset.di; if(dragFrom==null||dragFrom===to)return;
        const a=cur(); const mv=a.splice(dragFrom,1)[0]; a.splice(to,0,mv); dragFrom=null; setDims(a); });
    });
    el.querySelectorAll('.pv2Chip .x').forEach(function(x){ x.onclick=function(e){ e.stopPropagation(); setDims(cur().filter(function(d2){ return d2!==x.dataset.dimx; })); }; });
    const add=$('#pv2DimAdd'); if(add)add.onchange=function(){ if(this.value)setDims(cur().concat([this.value])); };
    const rs=$('#pv2DimReset'); if(rs)rs.onclick=function(){ setDims(['country','line','product','model','account']); };
  })();
  el.querySelectorAll('button[data-pv2g]').forEach(function(b2){
    b2.onclick=function(){ ui.pv2Gran=b2.dataset.pv2g; render(); }; });
  el.querySelectorAll('span[data-pv2mx]').forEach(function(s2){
    s2.onclick=function(e){ e.stopPropagation();
      if(!ui.pv2MExp)ui.pv2MExp={};
      ui.pv2MExp[s2.dataset.pv2mx]=1; render(); };
  });
  el.querySelectorAll('span[data-pv2mxc]').forEach(function(s2){
    s2.onclick=function(e){ e.stopPropagation();
      if(ui.pv2MExp)delete ui.pv2MExp[s2.dataset.pv2mxc];
      render(); };
  });
  el.querySelectorAll('button[data-pv2y]').forEach(function(b2){
    b2.onclick=function(){
      const y=+b2.dataset.pv2y;
      if(ui.pv2Yrs[y])delete ui.pv2Yrs[y]; else ui.pv2Yrs[y]=1;
      render(); };
  });
  const c1=$('#pv2C'); if(c1)c1.onchange=function(){ ui.pv2C=this.value; render(); };
  const c2=$('#pv2L'); if(c2)c2.onchange=function(){ ui.pv2L=this.value; render(); };
  const c3=$('#pv2Q'); if(c3)c3.oninput=function(){ ui.pv2Q=this.value; render(); };
  const hIn=$('#pv2H'); if(hIn)hIn.onchange=function(){
    const v=F.parseCellNum(this.value);
    if(!ui.pv2HistN)ui.pv2HistN={};
    ui.pv2HistN[ui.pv2Gran]=(v==null||v<0)?hDef[ui.pv2Gran]:Math.round(v);
    render(); };
  const eb=$('#pv2Exp'); if(eb)eb.onclick=function(){
    const all={};
    const walk=function(nd){ all[nd.key]=1; nd.children.forEach(walk); };
    root.children.forEach(walk);
    ui.pv2Open=all; render(); };
  const cb=$('#pv2Col'); if(cb)cb.onclick=function(){ ui.pv2Open={}; render(); };
  const ub=$('#pv2Undo'); if(ub)ub.onclick=function(){ undoLast(); };
  window.__pv2ExportCtx={items:items,src:src,yrs:yrs,curY:curY,fwSet:bctx.fwSet};   // 供门禁直接校验导出行
  const lb=$('#pv2Nimbus'); if(lb)lb.onclick=function(){ exportPvLong(items,src,yrs,curY,bctx.fwSet); };
  const bb=$('#pv2Bud'); if(bb)bb.onclick=function(){ exportBudgetBase(); };
  const nb=$('#pv2Np'); if(nb)nb.onclick=function(){
    state.ui.tab='newprod'; render();
    const e2=$('#npName'); if(e2)e2.focus();
  };
  el.querySelectorAll('td[data-pv2t]').forEach(function(td){
    td.onclick=function(e){
      if(e.target.closest('button'))return;
      const k=td.dataset.pv2t;
      if(ui.pv2Open[k])delete ui.pv2Open[k]; else ui.pv2Open[k]=1;
      render(); };
  });
  const nodeIdx={};
  const walkIdx=function(nd){ nodeIdx[nd.key]=nd; nd.children.forEach(walkIdx); };
  root.children.forEach(walkIdx);
  window.__pv2NodeIdx=nodeIdx; window.__pv2Bks=bks;
  /* 拍数:整桶口径 → 差额分配到 未来周×单元(按推演现值守恒;现值已含爆发系数/季节/补货经验) */
  const cellsOf=function(node,bk,metric){
    const out=[]; const DxN=pvDxOf(); const byK=(DxN&&DxN.byKey)||null;   // 重算后 D/Dr/Da 是新对象:按单元键取新推演(2026-09-02 审计:此前用闭包旧对象当权重)
    node.items.forEach(function(it){
      const itN=(byK&&byK.get(it.u.key))||it;
      ((itN.sim&&itN.sim.rows)||[]).forEach(function(r){
        if(bk.fut.indexOf(r.p)<0)return;
        const siV=(src==='fsd')?(r.si||0):(r.buy||0);
        out.push({key:ovKey(src,it.u.key),p:r.p,cur:metric==='so'?(r.so||0):siV,si:siV});
      });
    });
    return out;
  };
  /* 增量重算范围(2026-09-02 用户:拍一个产品不该全表重算):被拍层级下全部单元的产品(规整名);新品源只重算新品。
     多格粘贴/Delete 批量提交时合并成一次重算(xgApply 设 __pvBatch) */
  /* 拍数影响范围(2026-09-02 性能):默认只算被拍的那些单元;一旦涉及锁量(同型号/同产品会跨单元、跨源重新分配)就退回产品级 */
  const scopeOf=function(node){
    const pm={},um={};
    node.items.forEach(function(it){ pm[mkNorm(it.u.product)]=1; um[it.u.key]=1; });
    let locked=false;
    Object.keys(state.lockQty||{}).forEach(function(mk){
      if(locked)return; const L=state.lockQty[mk]; if(!L||!L.on||!(+L.total>0))return;
      const ix=mk.indexOf('||'); if(pm[mkNorm(ix>=0?mk.slice(0,ix):mk)])locked=true;
    });
    return locked?{products:pm,npAll:src==='np'}:{products:pm,units:um,npAll:src==='np'};
  };
  /* 批量(粘贴/填满)里同一 单元×周 被两层同时写(父行+子行)时:先把前面的写入冲刷重算,后面的层级按最新现值拆分——
     否则父层用批前权重会把子层刚拍的 0 静默覆盖,批量结果 ≠ 逐格结果(2026-09-02 第二轮审计 R7) */
  const pvBatchTouch=function(node,bk,metric){
    const b=window.__pvBatch; if(!b||!b.n||!b.written)return;
    const bn=(bk.mode==='ext')?'ovExt':(metric==='so'?'ovSO':'ovSI');
    let hit=false;
    node.items.forEach(function(it){
      if(hit)return;
      if(bk.mode==='ext'){ const k=ovExtKeyOf(srcNameOf(src),pv2UKey(it.u.country,it.u.account,it.u.model));
        (bk.months||[]).forEach(function(ym){ if(b.written[bn+'|'+k+'|'+ym])hit=true; }); }
      else { const k=ovKey(src,it.u.key); (bk.fut||[]).forEach(function(p){ if(b.written[bn+'|'+k+'|'+p])hit=true; }); }
    });
    if(!hit)return;
    /* 批内重叠:只把「本层级这些单元」重算到最新,并刷新它们的桶值(不重建明年底表、不动 DOM)——
       其余待处理的写入仍留在 b.scopes 里,批结束时一次性重算+重绘。
       2026-09-02 性能:此前每遇到一次重叠就整体重算+原地更新一遍,粘贴 200 格里有十几次,单次约 17ms。 */
    b.dup=(b.dup||0)+1;
    const keep=window.__pvBatch; window.__pvBatch=null;
    if(keep.extDirty){ ovExtGen++; keep.extDirty=false; }
    try{ computeAll({light:true,scope:scopeOf(node)}); pv2ValsRefresh(window.__incStat&&window.__incStat.changed); }
    finally{ window.__pvBatch=keep; }
  };
  const pvBatchMark=function(bagName,key,p){ const b=window.__pvBatch; if(b&&b.written)b.written[bagName+'|'+key+'|'+p]=1; };
  /* 批内轻量刷新:只重算「刚重算过的单元」的桶值供后续格取权重/显示值,不碰 DOM;
     明年列的值这里不算(批内只可能用到今年桶的显示值),标一个 lite 标签让批结束时的完整刷新重算 */
  const pv2ValsRefresh=function(changed){
    if(!changed)return;
    const tagL=dataGen+'|'+ovExtGen+'|'+ui.pv2Gran+'|'+yrs.join(',')+'|'+src+'|'+histN+'|'+Object.keys(ui.pv2MExp||{}).join(',')+'|lite';
    const DxN=pvDxOf(); const byK=(DxN&&DxN.byKey)?DxN.byKey:null; if(!byK)return;
    Object.keys(changed).forEach(function(k){ const itN=byK.get(k); if(!itN)return;
      const v=pv2ItemVals(itN,bctx,src,null); itN.__pvv={tag:tagL,v:v}; valMap.set(k,v); });
  };
  const pv2Recalc=function(sc){
    if(window.__pvBatch){ window.__pvBatch.scopes.push(sc); window.__pvBatch.n++; return; }
    const tT0=performance.now(); computeAll({light:true,scope:sc}); pv2Patch(window.__incStat&&window.__incStat.changed); window.__calcLog.tapMs=Math.round(performance.now()-tT0);   // 拍数:增量重算+只刷受影响的格,不重建矩阵
  };
  window.__pv2Flush=function(b){
    if(!b||!b.n)return;
    if(b.extDirty){ ovExtGen++; b.extDirty=false; }
    const pm={}; let npAll=false; let um={};
    b.scopes.forEach(function(s2){ Object.keys(s2.products).forEach(function(k){ pm[k]=1; }); if(s2.npAll)npAll=true;
      if(um&&s2.units)Object.keys(s2.units).forEach(function(k){ um[k]=1; }); else um=null; });   // 任一段是产品级(有锁量)→整批退回产品级
    const tT0=performance.now(); computeAll({light:true,scope:{products:pm,units:um,npAll:npAll}}); pv2Patch(window.__incStat&&window.__incStat.changed); window.__calcLog.tapMs=Math.round(performance.now()-tT0);
  };
  /* 拍数后原地更新(2026-09-01 性能):重算推演链后只改单元格文本,不重建整张矩阵 DOM、不重绑交互(重建曾是真机上拍数卡顿的大头);
     DOS 红线着色留到下次整页渲染再刷 */
  let cellsByNode=null;   // 节点键→该节点的格(渲染后建一次索引:此前每拍一次都要遍历上万个格读 dataset,是原地更新的大头)
  const pv2Patch=function(changed){
    /* 单元桶值缓存挂在推演对象上(2026-09-02 性能):增量重算里范围外单元的 it 对象原样复用,
       它的桶值必然没变 → 直接命中缓存;此前缓存标签含 simGen,每拍一次就把全部单元重算一遍(576 单元约 200ms)。 */
    const pvvTag=dataGen+'|'+ovExtGen+'|'+ui.pv2Gran+'|'+yrs.join(',')+'|'+src+'|'+histN+'|'+Object.keys(ui.pv2MExp||{}).join(',');
    const ext2=(ui.pv2Gran!=='week'&&maxY>curY)?pv2ExtByKey(src,maxY):null;
    /* 重算后 D/Dr/Da 是新对象:按单元键取新推演结果,闭包里的旧 it 只当键用(否则回显旧值) */
    const DxN=pvDxOf(); const byK=(DxN&&DxN.byKey)?DxN.byKey:null;
    const vm=new Map();
    items.forEach(function(it){ const itN=(byK&&byK.get(it.u.key))||it;
      let v=(itN.__pvv&&itN.__pvv.tag===pvvTag)?itN.__pvv.v:null;
      if(!v){ v=pv2ItemVals(itN,bctx,src,ext2); itN.__pvv={tag:pvvTag,v:v}; }
      vm.set(it.u.key,v); });
    /* 只刷「本轮真正重算过的单元」所在的各层节点(其余节点的聚合值不可能变) */
    let affected=null;
    if(changed){ affected={};
      Object.keys(changed).forEach(function(k){ const ks=unitNodes[k]; if(ks)ks.forEach(function(nk){ affected[nk]=1; }); }); }
    const aggCache={}; const bIdxOf={}; bks.forEach(function(b2,i2){ bIdxOf[b2.key]=i2; });
    if(!cellsByNode){ cellsByNode={};
      el.querySelectorAll('td[data-pv2n][data-pv2b]').forEach(function(td){ const nk=td.dataset.pv2n; (cellsByNode[nk]=cellsByNode[nk]||[]).push(td); }); }
    const nks=affected?Object.keys(affected):Object.keys(cellsByNode);
    nks.forEach(function(nk){ const arr=cellsByNode[nk]; if(!arr)return; arr.forEach(function(td){
      const node=nodeIdx[nk]; const bi=bIdxOf[td.dataset.pv2b]; if(!node||bi==null)return;
      let a=aggCache[node.key]; if(!a)a=aggCache[node.key]=pv2Agg(node.items,vm,n);
      const k=td.dataset.pv2k||td.dataset.pv2m; let txt=null;
      if(k==='si')txt=F.fmt(Math.round(a.si[bi]));
      else if(k==='so')txt=F.fmt(Math.round(a.so[bi]));
      else if(k==='inv')txt=a.inv[bi]!=null?F.fmt(Math.round(a.inv[bi])):'\u2014';
      else if(k==='dos'){ const b2=bks[bi]; const bd=pv2BucketDos(a,bi,b2); const soB=bd.soB,iv=bd.iv,dv=bd.dv;
        txt=iv==null?'\u2014':(soB>0?F.fmt(dv):(iv>0?'\u221e':'\u2014')); }
      if(txt!=null&&td.textContent!==txt){ td.textContent=txt; if(td.dataset.orig!=null)td.dataset.orig=txt; }
      if(k==='so'){ if(a.soCarry&&a.soCarry[bi])td.setAttribute('data-carry','1'); else td.removeAttribute('data-carry');
        if(a.soCap&&a.soCap[bi]){ td.setAttribute('data-capped','1'); td.title='拍的 SO 高于可售量,已按库存/锁量压回——差额见右键推演逻辑'; }
        else td.removeAttribute('data-capped'); }
    }); });
    valMap=vm;   // 之后的拍数/清尾/导出读的都是重算后的现值
    if(window.__pvLockWarnSync)window.__pvLockWarnSync();
  };
  el.querySelectorAll('td[data-pv2k]').forEach(function(td){
    td.addEventListener('keydown',function(e){ if(e.key==='Enter'){ e.preventDefault(); td.blur(); } });
    td.addEventListener('blur',function(){
      const __tEntry=performance.now();
      const __prof=function(k){ const g=window.__tapProfAgg; if(!g)return; g[k]=(g[k]||0)+(performance.now()-__tEntry); g['n_'+k]=(g['n_'+k]||0)+1; };
      if(td.dataset.orig!=null&&td.textContent===td.dataset.orig){ __prof('noop'); return; }
      /* 清尾(2026-09-02 用户:生命周期末期把库存卖完):在 SO 格输 清尾/=库存/清库存 → SO=可售量(期初库存+本桶SI=桶末库存+本桶SO),期末库存归零。
         审计修正:①批量里前面格的拍数先冲刷重算,清尾值按最新库存算;②清尾同时冻结本桶各周 SI(ovSI=现值)并打 tail 标记——引擎对 tail 周 SO=可售量、
         不再自动补货、不算前瞻需求、不承接到后续,期末真正归零 */
      let isTail=false;
      if(td.dataset.pv2k==='so'&&/^(清尾|=库存|清库存|清零库存)$/.test((td.textContent||'').trim())){
        isTail=true;
        if(window.__pvBatch&&window.__pvBatch.n){ const b0=window.__pvBatch; window.__pvBatch={scopes:[],n:0}; window.__pv2Flush(b0); }
        const nd0=nodeIdx[td.dataset.pv2n]; const bk0=bks.filter(function(b2){ return b2.key===td.dataset.pv2b; })[0];
        if(nd0&&bk0){ const a0=pv2Agg(nd0.items,valMap,n); const bi0=bks.indexOf(bk0); td.textContent=String(Math.max(0,Math.round((a0.inv[bi0]||0)+(a0.so[bi0]||0)))); }
      }
      /* 拒绝一次输入 = 只还原这一格(不重绘整张矩阵)。2026-09-02 用户:粘贴外部表格很慢——
         此前每个「非数字/低于已发生实际/无可拍未来周」的格都会触发一次整页 render(),大表 0.6~1.4 秒/格。 */
      const undo1=function(msg){ if(td.dataset.orig!=null)td.textContent=td.dataset.orig; if(msg)xgFlash(msg); __prof('reject'); };
      const v=F.parseCellNum(td.textContent);
      if(v==null||v<0){ undo1('请输入非负数字'); return; }
      const node=nodeIdx[td.dataset.pv2n];
      const bk=bks.filter(function(b2){ return b2.key===td.dataset.pv2b; })[0];
      if(!node||!bk){ undo1(); return; }
      const metric=td.dataset.pv2k;
      if(bk.mode==='ext'){
        /* 外推拍数:拍值按外推现值守恒分配到 单元×月,写覆盖层;计划SO/补货在 buildBudgetRows 延伸段引擎重排 */
        pvBatchTouch(node,bk,metric);
        const extB=pv2ExtByKey(src,bk.y);
        const cells=[];
        node.items.forEach(function(it){
          const k2=pv2UKey(it.u.country,it.u.account,it.u.model);
          const e2=extB.get(k2); if(!e2)return;
          bk.months.forEach(function(ym){
            const o2=e2[ym]; if(!o2)return;
            cells.push({k:k2,ym:ym,cur:metric==='so'?o2.so:o2.si});
          });
        });
        if(!cells.length){ undo1('该层级在外推层没有数据'); return; }
        let extCur=0; cells.forEach(function(c){ extCur+=c.cur; });
        if(extCur<=0){
          const hw={};
          node.items.forEach(function(it){
            const u2=it.u;
            const mi2=F.weekIndex(stx.maxPeriod);
            let s2=0;
            u2.periods.forEach(function(p2){
              if(mi2-F.weekIndex(p2)>=26)return;
              const w2=u2.weeks.get(p2);
              const ok2=u2.audio?(w2.so!=null&&w2.so>0):(w2.so!=null);
              if(ok2)s2+=(w2.so||0);
            });
            hw[pv2UKey(u2.country,u2.account,u2.model)]=s2;
          });
          cells.forEach(function(c){ c.cur=hw[c.k]||0; });
        }
        const al=distStep(Math.round(v),cells.map(function(c){ return c.cur; }),(typeof src!=='undefined')?src:'fsd');
        const und=[];
        const sN=srcNameOf(src);
        cells.forEach(function(c,i2){
          const ck=ovExtKeyOf(sN,c.k);   // 覆盖层按源(2026-09-02 审计)
          const o=state.ovExt[ck]&&state.ovExt[ck][c.ym];
          und.push({bag:'ovExt',key:ck,ym:c.ym,field:metric,old:(o&&o[metric]!=null)?o[metric]:null});
          (state.ovExt[ck]=state.ovExt[ck]||{});
          (state.ovExt[ck][c.ym]=state.ovExt[ck][c.ym]||{})[metric]=al[i2];
          pvBatchMark('ovExt',ck,c.ym);
        });
        pushUndo(und);
        /* 批量里先攒着,批结束(或遇到重叠需要真重算时)再统一失效——否则每粘一格都要重建整张明年底表
           (2026-09-02 性能:粘贴 200 格里多数是明年列,每格约 7ms) */
        if(window.__pvBatch)window.__pvBatch.extDirty=true; else ovExtGen++;
        pv2Recalc(scopeOf(node));
        __prof('extBranch');
        return;
      }
      const __tp={}; let __t0=performance.now(); const __mk=function(k){ __tp[k]=Math.round(performance.now()-__t0); __t0=performance.now(); };
      pvBatchTouch(node,bk,metric); __mk('batchTouch');
      const cells=cellsOf(node,bk,metric); __mk('cellsOf');
      if(!cells.length){ undo1('该桶没有可拍的未来周(该层级单元为待确认/免推演)'); return; }
      /* 显示值 ≠ 可拍范围时说清楚(2026-09-02 审计 R8):待确认/免推演单元有历史与明年外推但今年段没有可拍未来量,
         拍值只落到其余单元;不提示的话用户会以为「我拍的数被改了」 */
      (function(){ const keyed={}; cells.forEach(function(c){ keyed[c.key]=1; });
        let nOut=0; node.items.forEach(function(it){ if(!keyed[ovKey(src,it.u.key)])nOut++; });
        if(nOut)setTimeout(function(){ xgFlash('本层级 '+nOut+'/'+node.items.length+' 个单元未参与拆分(待确认/免推演,今年段无可拍量),显示值仍含其历史实际'); },0); })();
      let futCur=0; cells.forEach(function(c){ futCur+=c.cur; }); __mk('futCur');
      if(futCur<=0){
        /* 现值全 0(如停售段拍复售):按各单元近26周历史 SO 占比兜底,保住渠道历史经验;历史也没有才均分 */
        const hw={};
        node.items.forEach(function(it){
          const u2=it.u;
          const mi2=F.weekIndex(stx.maxPeriod);
          let s2=0;
          u2.periods.forEach(function(p2){
            if(mi2-F.weekIndex(p2)>=26)return;
            const w2=u2.weeks.get(p2);
            const ok2=u2.audio?(w2.so!=null&&w2.so>0):(w2.so!=null);
            if(ok2)s2+=(w2.so||0);
          });
          hw[u2.key]=s2;
        });
        cells.forEach(function(c){ c.cur=(hw[c.key]||0)/Math.max(1,bk.fut.length); });
      }
      __mk('zeroFallback');
      const a=pv2Agg(node.items,valMap,n); __mk('agg');
      const bi=bks.indexOf(bk);
      const shown=Math.round(metric==='so'?a.so[bi]:a.si[bi]);
      const histPart=shown-Math.round(futCur);
      if(Math.round(v)<histPart){   // 部分已实际的桶:拍值不能低于已发生部分(2026-09-02 审计:此前静默把未来周全拍 0 并回显实际值)
        undo1('本桶已发生实际 '+F.fmt(histPart)+',最低只能拍 '+F.fmt(histPart)+'(未写入)'); return; }
      const vFut=Math.max(0,Math.round(v)-histPart);
      const al=distStep(vFut,cells.map(function(c){ return c.cur; }),src); __mk('distribute');
      const bagName=metric==='so'?'ovSO':'ovSI';
      const bag=state[bagName];
      const und=cells.map(function(c){ return undoTakeOv(bagName,c.key,c.p); });
      if(isTail){   // 清尾:冻结本桶各周 SI(已手拍的不动),打 tail 标记(2=SI 由清尾冻结)
        cells.forEach(function(c){
          const hadSi=!!(state.ovSI[c.key]&&state.ovSI[c.key][c.p]!=null);
          if(!hadSi){ und.push(undoTakeOv('ovSI',c.key,c.p)); (state.ovSI[c.key]=state.ovSI[c.key]||{})[c.p]=c.si; }
          und.push(undoTakeOv('ovTail',c.key,c.p)); (state.ovTail[c.key]=state.ovTail[c.key]||{})[c.p]=hadSi?1:2;
        });
      } else if(metric==='so'){   // 普通拍数覆盖清尾:撤销 tail 标记(冻结的 SI 一并解冻)
        cells.forEach(function(c){ const t=state.ovTail[c.key]; if(t&&t[c.p]!=null){ und.push(undoTakeOv('ovTail',c.key,c.p)); if(t[c.p]===2&&state.ovSI[c.key]&&state.ovSI[c.key][c.p]!=null){ und.push(undoTakeOv('ovSI',c.key,c.p)); delete state.ovSI[c.key][c.p]; if(!Object.keys(state.ovSI[c.key]).length)delete state.ovSI[c.key]; } delete t[c.p]; if(!Object.keys(t).length)delete state.ovTail[c.key]; } });
      }
      __mk('tailFreeze');
      pushUndo(und); __mk('pushUndo');
      cells.forEach(function(c,i2){ if(!bag[c.key])bag[c.key]={}; bag[c.key][c.p]=al[i2]; pvBatchMark(bagName,c.key,c.p); }); __mk('write');
      pv2Recalc(scopeOf(node)); __mk('recalc');
      __prof('simBranch');
      window.__tapProf=__tp;
      if(window.__tapProfAgg){ Object.keys(__tp).forEach(function(k){ window.__tapProfAgg[k]=(window.__tapProfAgg[k]||0)+__tp[k]; }); window.__tapProfAgg.n=(window.__tapProfAgg.n||0)+1; }
    });
  });
  /* 右键:推演逻辑浮层 */
  window.__pv2Patch=pv2Patch;
  el.querySelectorAll('td[data-pv2n][data-pv2k],td[data-pv2n][data-pv2m="si"],td[data-pv2n][data-pv2m="so"]').forEach(function(td){
    td.addEventListener('contextmenu',function(e){
      if(document.activeElement===td)return;   // 正在编辑:放行原生菜单(粘贴等)
      e.preventDefault();
      pv2ShowLogic(td,e,nodeIdx,bks,src,curY);
    });
  });
  el.querySelectorAll('button[data-pv2r]').forEach(function(b2){
    b2.onclick=function(e){
      e.stopPropagation();
      const node=nodeIdx[b2.dataset.pv2r]; if(!node)return;
      if(!confirm('清除「'+node.label+'」层级下全部 手工拍数(今年周级+外推年月级)、恢复公式推演？'))return;
      const DxN=pvDxOf(); const byK=(DxN&&DxN.byKey)||null;
      node.items.forEach(function(it){
        const k=ovKey(src,it.u.key); const itN=(byK&&byK.get(it.u.key))||it;
        [state.ovSO,state.ovSI,state.ovTail].forEach(function(bag){ delete bag[k]; });   // 该单元今年段全部手工(含 sim.rows 为空的残留)
        const kx=ovExtKeyOf(srcNameOf(src),pv2UKey(it.u.country,it.u.account,it.u.model));
        if(state.ovExt[kx]){ delete state.ovExt[kx]; ovExtGen++; }
      });
      recompute();
    };
  });
  const ob=$('#pv2Out');
  if(ob)ob.onclick=function(){
    const headers=dims.map(function(d2){return dimName[d2];}).concat(['指标']).concat(bks.map(function(b2){return b2.y+'-'+b2.label;}));
    const data=[];
    const walkAll=function(nd,path){
      const a=pv2Agg(nd.items,valMap,n);
      const base=[];
      for(let i2=0;i2<dims.length;i2++)base.push(path[i2]||'');
      data.push(base.concat([siLab]).concat(a.si.map(Math.round)));
      data.push(base.concat(['SO']).concat(a.so.map(Math.round)));
      data.push(base.concat(['库存(期末)']).concat(a.inv.map(function(x){return x==null?'':Math.round(x);})));
      data.push(base.concat(['DOS']).concat(a.inv.map(function(x,i3){
        const bd=pv2BucketDos(a,i3,bks[i3]); return bd.dv!=null?bd.dv:''; })));
      Array.from(nd.children.keys()).sort().forEach(function(k){
        walkAll(nd.children.get(k),path.concat([k])); });
    };
    Array.from(root.children.keys()).sort().forEach(function(k){ walkAll(root.children.get(k),[k]); });
    exportTable('推演编辑-'+PV2_VIEWS[ui.pv2View].label+'-'+({week:'周',month:'月',quarter:'季',year:'年'})[ui.pv2Gran],headers,data);
  };
}
/* pv 前两列(层级/指标)列宽:一条动态 CSS 规则控整列(含 sticky td),拖拽与持久共用 */
function updatePv2ColStyle(){
  let st=document.getElementById('pv2ColW');
  if(!st){ st=document.createElement('style'); st.id='pv2ColW'; document.head.appendChild(st); }
  const w0=state.ui.pv2W0,w1=state.ui.pv2W1;
  let css='';
  if(w0)css+='#view-pv td[data-ci="0"],#view-pv thead tr:first-child th:nth-child(1){min-width:'+w0+'px;max-width:'+w0+'px;width:'+w0+'px;overflow:hidden;text-overflow:ellipsis}\n';
  if(w1)css+='#view-pv td[data-ci="1"],#view-pv thead tr:first-child th:nth-child(2){min-width:'+w1+'px;max-width:'+w1+'px;width:'+w1+'px;overflow:hidden;text-overflow:ellipsis}\n';
  st.textContent=css;
}
/* 冻结列/行:表头(两行)sticky 顶部,层级列+指标列 sticky 左侧;第二行 top 与指标列 left 按实际尺寸同步 */
function pv2SyncSticky(el){
  try{
    const tbl=el.querySelector('.tblwrap table'); if(!tbl)return;
    const tr1=tbl.tHead&&tbl.tHead.rows[0];
    if(tr1){
      const h1=tr1.getBoundingClientRect().height;
      if(tbl.tHead.rows[1])Array.prototype.forEach.call(tbl.tHead.rows[1].cells,function(th){ th.style.top=h1+'px'; });
    }
    const lv=tbl.querySelector('td[data-ci="0"],th.l');
    const w0=lv?lv.getBoundingClientRect().width:220;
    tbl.querySelectorAll('td[data-ci="1"]').forEach(function(td){ td.style.left=w0+'px'; });
    if(tbl.tHead){
      Array.prototype.forEach.call(tbl.tHead.rows[0].cells,function(th,i){
        if(i===1)th.style.left=w0+'px';
      });
    }
  }catch(e){}
}
/* 右键推演逻辑浮层:今年月=确定性因子分解;外推年=外推参数卡;历史=实际说明 */
function pv2ShowLogic(td,e,nodeIdx,bks,src,curY){
  const node=nodeIdx[td.dataset.pv2n];
  const bk=bks.filter(function(b2){ return b2.key===td.dataset.pv2b; })[0];
  if(!node||!bk)return;
  let box=document.getElementById('pvXp');
  if(!box){
    box=document.createElement('div'); box.id='pvXp';
    document.body.appendChild(box);
    document.addEventListener('mousedown',function(ev){
      if(box.style.display==='block'&&!ev.target.closest('#pvXp')){
        box.style.display='none';
        ev.stopPropagation(); ev.preventDefault();   // 关浮层的这一下不再触发选格/展开
      }
    },true);
  }
  const pathTxt=Object.keys(node.path).map(function(d2){ return node.path[d2]; }).join(' · ');
  if(src==='np'){
    box.innerHTML='<div style="font-weight:600;margin-bottom:4px">'+esc(pathTxt)+' · '+esc(bk.label)+' <span class="muted">新品规划</span></div>'
      +'<div class="note">SO=锚品该渠道平销×缩放×周季节×增速,上市后按起量周数线性爬坡(首销脉冲 1.4/大促 1.8);SI=首批铺货(目标DOS×日均)+之后 DOS 低于触发线补到目标;库存=上期+SI−SO;手拍值优先并重链库存。改锚品/缩放/上市周去「新品规划」页,点「编辑」。</div>';
    box.style.left=(e.clientX+8)+'px'; box.style.top=(e.clientY+8)+'px'; box.style.display='block';
    return;
  }
  const args={month:bk.m};
  ['line','product','country','account'].forEach(function(d2){
    if(node.path[d2]&&node.path[d2]!=='(未知)')args[d2]=node.path[d2];
  });
  if(node.path.model&&node.path.model!=='(无型号)')args.model=node.path.model;
  const savedLang=state.ai&&state.ai.lang;
  if(!state.ai)state.ai={};
  state.ai.lang='zh';   // 本页为中文看板,浮层强制中文;渲染完还原 Agent 面板语言
  let inner='';
  if(bk.mode==='hist'){
    inner='<div class="muted">'+esc(bk.y+'年 '+bk.label)+' · 历史实际(来自底表),非推演值;音频线 SO=0 为未报量。</div>';
  } else if(bk.mode==='ext'){
    /* 外推参数卡:平销Σ/置信/增速链/大促周 */
    let blSum=0,blN=0,cf={high:0,mid:0,low:0};
    const gSet={};
    let promoW=0;
    node.items.forEach(function(it){
      if(it.bl&&it.bl.base!=null){ blSum+=it.bl.base; blN++; cf[it.bl.conf||'low']++; }
      const g=(state.growth[it.u.key]!=null)?state.growth[it.u.key]:gDefaultOf(it.u);
      gSet['×'+g]=(gSet['×'+g]||0)+1;
      const pw=promoWSetOf(it.u);
      Object.keys(pw).forEach(function(w){ promoW++; });
    });
    inner='<b>'+esc(bk.y+'年 '+bk.label)+' · 预算外推口径</b>'
      +'<div style="margin-top:6px"><b>公式</b>:每周SO=平销b̂×(1+漂移)^i×周季节k×增速g'+(src==='fsd'?';SI=轻量补货循环(DOS低于触发线补到目标,年末10/11/12月收官约束)':';Purchase=按渠道学习策略补货(水位型:历史每到某库存台数就进货/DOS门槛型;全年按该渠道×型号回测的历史月末画像(各月末DOS)月末补到位,单周进货≤历史最大×1.2;末次SI后停购,手拍优先)')+'</div>'
      +'<div><b>该层级参数</b>:平销Σ '+(blN?Math.round(blSum)+' 台/周(置信 高'+cf.high+'/中'+cf.mid+'/低'+cf.low+')':'—(低置信单元用近4周均)')
      +' · 增速 '+esc(Object.keys(gSet).join(','))+'(单元手工>型号>系族>产品线>全局)'
      +' · 大促周历已并入周季节系数</div>'
      +'<div class="muted" style="margin-top:4px">外推置信低于今年;可直接在格内拍数(按现值守恒分配到单元×月,库存链自动重算),或调平销改写/增速/爆发系数(总控页)让外推整体跟随。DOS=月末库存÷(月SO÷该月周数×7天);季/年列=末月月末DOS。</div>';
  } else {
    let r;
    try{ r=aiExplainCell(args); }catch(err){ r={error:String(err&&err.message||err)}; }
    inner='<div class="muted" style="font-size:11px;margin-bottom:4px">确定性因子分解(直接读推演引擎)</div>'+aiExplainHtml(r);
  }
  if(savedLang==null)delete state.ai.lang; else state.ai.lang=savedLang;
  /* 四因子(R5):这个桶里每周的 SO 是怎么乘出来的;单元多于 4 个只列前 4 个并注明 */
  const linHtml=(function(){
    if(bk.mode!=='sim'||src==='np')return '';
    const its=node.items.slice(0,4); if(!its.length)return '';
    let h2='<div style="margin-top:8px"><b>四因子</b> <span class="muted">基线 × 档位 × 系数 × 增速 × 承接 = 原始 → 取整 = 计划 → 约束 = 实际'+(node.items.length>4?'（共 '+node.items.length+' 单元,列前 4 个）':'')+'</span>';
    its.forEach(function(it){ const rows=((it.sim&&it.sim.rows)||[]).filter(function(r){ return (bk.weeks||[]).indexOf(r.p)>=0; });
      if(!rows.length)return;
      h2+='<div class="note" style="margin-top:4px"><b>'+esc(it.u.account+' · '+(it.u.model||it.u.product))+'</b><br>'
        +rows.map(function(r){ return esc(F.weekLabel(r.p))+'：'+esc(F.lineageText(r)||'—')+' ⇒ <b>'+F.fmt(r.so)+'</b>'; }).join('<br>')+'</div>'; });
    return h2+'</div>';
  })();
  box.innerHTML='<div style="display:flex;align-items:center;gap:8px;margin-bottom:6px"><b>推演逻辑</b>'
    +'<span class="muted" style="font-size:11px">'+esc(pathTxt)+'</span>'
    +'<button class="mini" style="margin-left:auto" onclick="document.getElementById(\'pvXp\').style.display=\'none\'">\u2715</button></div>'+inner+linHtml;
  box.style.display='block';
  const bw=Math.min(520,window.innerWidth-40);
  box.style.maxWidth=bw+'px';
  let x=e.clientX+12,y=e.clientY+8;
  box.style.left='0px'; box.style.top='0px';
  const rct=box.getBoundingClientRect();
  if(x+rct.width>window.innerWidth-16)x=Math.max(8,window.innerWidth-rct.width-16);
  if(y+rct.height>window.innerHeight-16)y=Math.max(8,window.innerHeight-rct.height-16);
  box.style.left=x+'px'; box.style.top=y+'px';
}

